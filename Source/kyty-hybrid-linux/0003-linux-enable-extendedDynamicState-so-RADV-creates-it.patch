From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig <6146447+dev-kreg@users.noreply.github.com>
Date: Tue, 24 Nov 2026 12:59:10 -0600
Subject: [PATCH] linux: enable extendedDynamicState so RADV creates its PS
 epilog cache

RADV (Mesa 26.3) compiles a PS epilog for a depth-writing fragment shader
whenever depth test enable is dynamic, but creates its epilog cache only when
the device enables extendedDynamicState (or GPL / shader objects) explicitly.
The first such draw in Sky Garden then crashes in radv_bind_ps_epilog on a
null cache. Enabling the feature when the device has it costs nothing.
---
 .../presentation/window/vulkanWindow.cpp      | 25 +++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

diff --git a/src/graphics/presentation/window/vulkanWindow.cpp b/src/graphics/presentation/window/vulkanWindow.cpp
index 4542a7bd..5a4c8489 100644
--- a/src/graphics/presentation/window/vulkanWindow.cpp
+++ b/src/graphics/presentation/window/vulkanWindow.cpp
@@ -1568,10 +1568,31 @@ static vk::Device VulkanCreateDevice(GraphicContext& graphics,
 		present_id.pNext     = const_cast<void*>(create_info.pNext);
 		create_info.pNext    = &present_id;
 	}
+	// RADV (Mesa 26.3) compiles a PS epilog for a depth-writing fragment shader whenever depth test
+	// enable is dynamic (core since Vulkan 1.3), but creates its epilog cache only when the device
+	// enables extendedDynamicState (or GPL / shader objects / some EDS3 states) explicitly: the first
+	// such draw then crashes in radv_bind_ps_epilog on a null cache (Sky Garden). Enabling the feature
+	// costs nothing and creates the cache.
+	std::vector<const char*>                          enabled_extensions = device_extensions;
+	vk::PhysicalDeviceExtendedDynamicStateFeaturesEXT extended_dynamic_state {};
+	{
+		const auto available = EnumerateVulkan<vk::ExtensionProperties>(
+		    "vkEnumerateDeviceExtensionProperties", [&](uint32_t* count, vk::ExtensionProperties* values) {
+			    return physical_device.enumerateDeviceExtensionProperties(nullptr, count, values);
+		    });
+		if (HasExtension(available, VK_EXT_EXTENDED_DYNAMIC_STATE_EXTENSION_NAME)) {
+			if (!HasExtension(enabled_extensions, VK_EXT_EXTENDED_DYNAMIC_STATE_EXTENSION_NAME)) {
+				enabled_extensions.push_back(VK_EXT_EXTENDED_DYNAMIC_STATE_EXTENSION_NAME);
+			}
+			extended_dynamic_state.extendedDynamicState = VK_TRUE;
+			extended_dynamic_state.pNext                = const_cast<void*>(create_info.pNext);
+			create_info.pNext                           = &extended_dynamic_state;
+		}
+	}
 	create_info.pQueueCreateInfos       = queue_create_infos.data();
 	create_info.queueCreateInfoCount    = queue_create_count;
-	create_info.enabledExtensionCount   = static_cast<uint32_t>(device_extensions.size());
-	create_info.ppEnabledExtensionNames = device_extensions.data();
+	create_info.enabledExtensionCount   = static_cast<uint32_t>(enabled_extensions.size());
+	create_info.ppEnabledExtensionNames = enabled_extensions.data();
 	create_info.pEnabledFeatures        = &device_features;
 
 	// ASTROHYBRID_XESS (renderer/xess.h): the features XeSS needs, merged into this chain; the
-- 
