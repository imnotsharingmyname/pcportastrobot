@@ -0,0 +1,71 @@
+#pragma once
+
+// FSR 3.1 frame generation (ASTROHYBRID_FSR_FG=1).
+//
+// Frame generation is not an upscaler pass: it replaces the swapchain, so the
+// presenter asks this module for the swapchain handle and for the functions that
+// acquire from and present to it. When the module is not requested, or fails to
+// initialise, every call reports false and the caller keeps its stock path.
+
+#include <cstdint>
+
+#include <vulkan/vulkan.h>
+
+namespace Libs::Graphics {
+
+namespace FsrFg {
+
+/// True when ASTROHYBRID_FSR_FG=1.
+bool Requested();
+
+/// Loads Build/RunHybrid/fsr3/libamd_fidelityfx_framegeneration_vk.so and
+/// resolves the FFX entry points. Idempotent; returns false if unavailable.
+bool Prepare();
+
+/// Wraps the game's swapchain. On success `out_swapchain` is the handle the
+/// presenter must use from now on and the replacement functions are available.
+bool CreateSwapchain(VkDevice device, VkPhysicalDevice physical,
+                     const VkSwapchainCreateInfoKHR& create_info,
+                     VkQueue game_queue, uint32_t game_queue_family,
+                     VkQueue async_queue, VkQueue present_queue, VkQueue acquire_queue,
+                     uint32_t queue_family,
+                     VkSwapchainKHR& out_swapchain);
+
+/// True when a wrapped swapchain is in use.
+bool Active();
+
+/// Replacement vkGetSwapchainImagesKHR / vkAcquireNextImageKHR /
+/// vkQueuePresentKHR. Each falls back to the stock call when inactive.
+/// Destroys the wrapped swapchain through the provider. Returns false when the
+/// module is inactive, so the caller keeps its stock destroy.
+bool DestroySwapchain(VkDevice device);
+
+VkResult GetSwapchainImages(VkDevice device, VkSwapchainKHR swapchain,
+                            uint32_t* count, VkImage* images);
+VkResult AcquireNextImage(VkDevice device, VkSwapchainKHR swapchain,
+                          uint64_t timeout, VkSemaphore semaphore,
+                          VkFence fence, uint32_t* index);
+VkResult Present(VkQueue queue, const VkPresentInfoKHR& info);
+
+/// Records the per-frame prepare dispatch the generator reads before generating:
+/// depth, motion vectors, jitter and the camera parameters.
+bool PrepareFrame(VkCommandBuffer command_buffer, VkImage depth, VkFormat depth_format,
+                  VkImage motion, VkFormat motion_format, uint32_t width, uint32_t height,
+                  const float jitter[2], uint32_t frame_id);
+
+/// Issues one frame-generation dispatch. `color`, `depth` and `motion` are the
+/// images the FSR upscale produced and consumed; `width`/`height` are their
+/// extent. Returns false when the module is inactive or the provider rejects it.
+bool DispatchFrame(VkCommandBuffer command_buffer, VkImage color, VkFormat color_format,
+                   VkImage depth, VkFormat depth_format, VkImage motion, VkFormat motion_format,
+                   uint32_t width, uint32_t height);
+
+/// Presented-frame count from the provider, or 0 when inactive. The direct
+/// measure of "presented ≈ 2× rendered".
+uint64_t PresentedCount();
+
+void Shutdown();
+
+} // namespace FsrFg
+
+} // namespace Libs::Graphics
