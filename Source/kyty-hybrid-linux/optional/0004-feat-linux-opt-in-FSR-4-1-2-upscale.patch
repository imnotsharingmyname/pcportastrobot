diff --git a/src/graphics/host_gpu/renderer/fsr4.cpp b/src/graphics/host_gpu/renderer/fsr4.cpp
new file mode 100644
index 00000000..0eda03d0
--- /dev/null
+++ b/src/graphics/host_gpu/renderer/fsr4.cpp
@@ -0,0 +1,562 @@
+// Native FSR 4.1.2 through the FidelityFX SDK Vulkan provider.
+//
+// The provider is an optional, externally built GPL-3.0 library (the local
+// FidelityFX SDK port).  Kyty only calls its FFX API; no provider source or
+// extracted assets are part of this tree.
+//
+// SPDX-License-Identifier: GPL-2.0
+
+#include "graphics/host_gpu/renderer/fsr4.h"
+#include "graphics/host_gpu/renderer/fsrFg.h"
+
+#include "graphics/host_gpu/renderer/dlss.h"
+#include "graphics/host_gpu/renderer/image/image.h"
+#include "graphics/host_gpu/renderer/render.h"
+#include "graphics/host_gpu/renderer/renderContext.h"
+#include "graphics/host_gpu/vulkanCommon.h"
+
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#if !defined(_WIN32)
+#define __declspec(x)
+#include "ffx_api.h"
+#include "ffx_upscale.h"
+#include "vk/ffx_api_vk.h"
+
+#include <dlfcn.h>
+#endif
+
+namespace Libs::Graphics {
+
+namespace Fsr4 {
+
+// Which upscaler to run, if any:
+//   ASTROHYBRID_FSR=fsr4  (or the legacy ASTROHYBRID_FSR4=1) -> FSR 4.1.2
+//   ASTROHYBRID_FSR=fsr3                                    -> FSR 3.1
+// Anything else, or nothing, leaves the game's own upscale in place.
+enum class Provider { None, Fsr3, Fsr4 };
+
+Provider Selected() {
+	static const Provider selected = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR");
+		if (value != nullptr) {
+			if (std::strcmp(value, "fsr3") == 0) return Provider::Fsr3;
+			if (std::strcmp(value, "fsr4") == 0) return Provider::Fsr4;
+			if (std::strcmp(value, "off") == 0) return Provider::None;
+		}
+		const char* legacy = std::getenv("ASTROHYBRID_FSR4");
+		return legacy != nullptr && std::strcmp(legacy, "1") == 0 ? Provider::Fsr4 : Provider::None;
+	}();
+	return selected;
+}
+
+bool Requested() {
+	return Selected() != Provider::None;
+}
+
+void RequiredExtensions(std::vector<const char*>& instance, std::vector<const char*>& device) {
+	(void)instance;
+#if !defined(_WIN32)
+	if (!Requested()) {
+		return;
+	}
+	// FSR 3.1 is plain fp32 compute and needs neither cooperative matrix nor
+	// float8; requesting them would exclude devices that could run it.
+	if (Fsr4::Selected() == Fsr4::Provider::Fsr3) {
+		return;
+	}
+	device.push_back(VK_KHR_COOPERATIVE_MATRIX_EXTENSION_NAME);
+	device.push_back(VK_EXT_SHADER_FLOAT8_EXTENSION_NAME);
+#else
+	(void)device;
+#endif
+}
+
+} // namespace Fsr4
+
+#if !defined(_WIN32)
+
+namespace {
+
+struct State {
+	bool                 init_tried = false;
+	bool                 ready      = false;
+	void*                loader     = nullptr;
+	PfnFfxCreateContext  create     = nullptr;
+	PfnFfxDestroyContext destroy    = nullptr;
+	PfnFfxDispatch       dispatch   = nullptr;
+	ffxContext           context    = nullptr;
+	uint32_t             in_w       = 0;
+	uint32_t             in_h       = 0;
+	uint32_t             out_w      = 0;
+	uint32_t             out_h      = 0;
+	uint64_t             last_frame = 0;
+	uint64_t             last_dispatch_frame = 0;
+	uint32_t             last_in_w   = 0;
+	uint32_t             last_in_h   = 0;
+};
+
+State& Get() {
+	static State state;
+	return state;
+}
+
+std::string ProviderDirectory() {
+	if (Fsr4::Selected() == Fsr4::Provider::Fsr3) {
+		const char* value = std::getenv("ASTROHYBRID_FSR3_PATH");
+		return value != nullptr && value[0] != '\0' ? std::string(value) : std::string("fsr3");
+	}
+	const char* value = std::getenv("ASTROHYBRID_FSR4_PATH");
+	return value != nullptr && value[0] != '\0' ? std::string(value) : std::string("fsr4");
+}
+
+bool LoadProvider(State& s) {
+	if (s.init_tried) {
+		return s.ready;
+	}
+	s.init_tried = true;
+
+	const auto  directory = ProviderDirectory();
+	// FSR 4.1.2 ships a provider plus the FidelityFX loader; the FSR 3.1 provider
+	// exports the FFX entry points directly and needs no loader.
+	const bool  fsr3 = Fsr4::Selected() == Fsr4::Provider::Fsr3;
+	const auto  loader_path = fsr3 ? directory + "/libamd_fidelityfx_fsr3_vk.so"
+	                               : directory + "/libamd_fidelityfx_loader_vk.so";
+	if (!fsr3) {
+		const auto asset_dir = directory + "/assets";
+		if (std::getenv("FSR4_ASSET_DIR") == nullptr) {
+			setenv("FSR4_ASSET_DIR", asset_dir.c_str(), 1);
+		}
+	}
+	s.loader = dlopen(loader_path.c_str(), RTLD_NOW | RTLD_LOCAL);
+	if (s.loader == nullptr) {
+		std::printf("FSR4: cannot load %s: %s\n", loader_path.c_str(), dlerror());
+		std::fflush(stdout);
+		return false;
+	}
+	s.create = reinterpret_cast<PfnFfxCreateContext>(dlsym(s.loader, "ffxCreateContext"));
+	s.destroy = reinterpret_cast<PfnFfxDestroyContext>(dlsym(s.loader, "ffxDestroyContext"));
+	s.dispatch = reinterpret_cast<PfnFfxDispatch>(dlsym(s.loader, "ffxDispatch"));
+	if (s.create == nullptr || s.destroy == nullptr || s.dispatch == nullptr) {
+		std::printf("FSR4: %s is missing the FFX entry points\n", loader_path.c_str());
+		std::fflush(stdout);
+		return false;
+	}
+	return true;
+}
+
+bool CreateContext(State& s, const GraphicContext& graphics, uint32_t in_w, uint32_t in_h,
+                   uint32_t out_w, uint32_t out_h) {
+	if (s.create == nullptr) {
+		return false;
+	}
+	if (s.context != nullptr) {
+		return true;
+	}
+
+	VkDeviceContext device_context {};
+	device_context.vkDevice         = static_cast<VkDevice>(graphics.device);
+	device_context.vkPhysicalDevice = static_cast<VkPhysicalDevice>(graphics.physical_device);
+	device_context.vkDeviceProcAddr = VULKAN_HPP_DEFAULT_DISPATCHER.vkGetDeviceProcAddr;
+
+	ffxCreateBackendVKDesc backend {};
+	backend.header.type          = FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_VK;
+	backend.deviceContext        = device_context;
+
+	ffxCreateContextDescUpscaleVersion version {};
+	version.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE_VERSION;
+	version.version     = FFX_UPSCALER_VERSION;
+
+	ffxCreateContextDescUpscale upscale {};
+	upscale.header.type   = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE;
+	upscale.maxRenderSize = {in_w, in_h};
+	upscale.maxUpscaleSize = {out_w, out_h};
+	upscale.flags          = 0;
+	upscale.fpMessage      = nullptr;
+	upscale.header.pNext   = &version.header;
+	version.header.pNext   = &backend.header;
+
+	const auto result = s.create(&s.context, &upscale.header, nullptr);
+	if (result != FFX_API_RETURN_OK || s.context == nullptr) {
+		std::printf("FSR4: ffxCreateContext failed (0x%x) for %ux%u -> %ux%u\n",
+		            static_cast<unsigned>(result), in_w, in_h, out_w, out_h);
+		std::fflush(stdout);
+		s.context = nullptr;
+		s.ready   = false;
+		return false;
+	}
+	s.in_w   = in_w;
+	s.in_h   = in_h;
+	s.out_w  = out_w;
+	s.out_h  = out_h;
+	s.ready  = true;
+	std::printf("FSR4: context created, %ux%u -> %ux%u\n", in_w, in_h, out_w, out_h);
+	std::fflush(stdout);
+	return true;
+}
+
+FfxApiResourceDescription DescribeImage(const Image& image, uint32_t additional_usages) {
+	VkImageCreateInfo create {};
+	create.sType         = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+	create.imageType     = VK_IMAGE_TYPE_2D;
+	create.format        = static_cast<VkFormat>(image.backing.format);
+	create.extent        = {image.info.extent.width, image.info.extent.height, 1};
+	create.mipLevels     = 1;
+	create.arrayLayers   = 1;
+	create.samples       = VK_SAMPLE_COUNT_1_BIT;
+	create.tiling        = VK_IMAGE_TILING_OPTIMAL;
+	create.usage         = static_cast<VkImageUsageFlags>(image.backing.usage) | additional_usages;
+	create.sharingMode   = VK_SHARING_MODE_EXCLUSIVE;
+	create.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+	return ffxApiGetImageResourceDescriptionVK(static_cast<VkImage>(image.backing.image),
+	                                           create, additional_usages);
+}
+
+} // namespace
+
+bool RenderExecutor::TryFsr4Upscale(CommandBuffer& buffer, PreparedBindings& pixel, ImageId output) {
+	if (!Fsr4::Requested() || pixel.runtime == nullptr || !*pixel.runtime) {
+		std::fprintf(stderr, "UPSDBG early return #1\n");
+		return false;
+	}
+	// ASTROHYBRID_FSR4_PASSLOG=1: once a second, list every pixel program that writes a
+	// 3840x2160 target with the input size from its constants. This shows whether the
+	// matched pass covers every frame or shares the upscale with other variants.
+	static const bool pass_log = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4_PASSLOG");
+		return value != nullptr && value[0] != '\0';
+	}();
+	static const bool pass_log_verbose = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4_PASSLOG");
+		return value != nullptr && std::strcmp(value, "2") == 0;
+	}();
+	if (pass_log) {
+		struct Candidate {
+			uint64_t hash;
+			uint32_t in_w;
+			uint32_t in_h;
+			uint32_t count;
+		};
+		static Candidate candidates[8] {};
+		static uint32_t  candidate_count = 0;
+		static auto      window_start    = std::chrono::steady_clock::now();
+		if (!pixel.buffer_sources.empty() && pixel.buffer_sources[0].address != 0 &&
+		    pixel.buffer_sources[0].size >= 32) {
+			const auto*    cb0 = reinterpret_cast<const uint32_t*>(pixel.buffer_sources[0].address);
+			const uint32_t ow = cb0[4], oh = cb0[5], in_w = cb0[6], in_h = cb0[7];
+			if (ow == 3840 && oh == 2160 && in_w != 0 && in_h != 0) {
+				const uint64_t hash = pixel.runtime->program->shader_hash;
+				if (pass_log_verbose) {
+					static uint32_t lines = 0;
+					if (lines < 400) {
+						++lines;
+						std::printf("FSR4: pass hash=0x%016llx %ux%u -> %ux%u frame=%u mv=%u out=%u/%u\n",
+						            static_cast<unsigned long long>(hash), in_w, in_h, ow, oh, cb0[11],
+						            cb0[13], output.index, output.generation);
+						std::fflush(stdout);
+					}
+				}
+				uint32_t slot = candidate_count;
+				for (uint32_t i = 0; i < candidate_count; ++i) {
+					if (candidates[i].hash == hash && candidates[i].in_w == in_w &&
+					    candidates[i].in_h == in_h) {
+						slot = i;
+						break;
+					}
+				}
+				if (slot == candidate_count && candidate_count < 8) {
+					candidates[candidate_count++] = Candidate {hash, in_w, in_h, 0};
+				}
+				if (slot < candidate_count) {
+					++candidates[slot].count;
+				}
+			}
+		}
+		const auto now = std::chrono::steady_clock::now();
+		if (now - window_start >= std::chrono::seconds(1)) {
+			const auto elapsed =
+			    std::chrono::duration_cast<std::chrono::milliseconds>(now - window_start).count();
+			std::printf("FSR4: 4K passes in %lld ms:", static_cast<long long>(elapsed));
+			for (uint32_t i = 0; i < candidate_count; ++i) {
+				std::printf(" 0x%016llx %ux%u x%u",
+				            static_cast<unsigned long long>(candidates[i].hash),
+				            candidates[i].in_w, candidates[i].in_h, candidates[i].count);
+				candidates[i].count = 0;
+			}
+			std::printf("\n");
+			std::fflush(stdout);
+			window_start = now;
+		}
+	}
+	static const uint64_t pass_hash = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4_PASS");
+		return value != nullptr ? std::strtoull(value, nullptr, 0) : 0x2936e5eca99d75e7ull;
+	}();
+	if (pixel.runtime->program->shader_hash != pass_hash) {
+		std::fprintf(stderr, "UPSDBG early return #2\n");
+		return false;
+	}
+	if (pixel.images.size() < 2 || !output || pixel.buffer_sources.empty() ||
+	    pixel.buffer_sources[0].address == 0 || pixel.buffer_sources[0].size < 56) {
+		std::fprintf(stderr, "UPSDBG early return #3\n");
+		return false;
+	}
+
+	auto& s = Get();
+	const auto* cb = reinterpret_cast<const uint32_t*>(pixel.buffer_sources[0].address);
+	float       jitter_uv[2];
+	std::memcpy(jitter_uv, cb, sizeof(jitter_uv));
+	uint32_t out_w = cb[4], out_h = cb[5], in_w = cb[6], in_h = cb[7];
+	const uint32_t frame = cb[11];
+	if (cb[13] == 0 || in_w == 0 || in_h == 0 || out_w == 0 || out_h == 0) {
+		std::fprintf(stderr, "UPSDBG early return #4\n");
+		return false;
+	}
+	// ASTROHYBRID_FSR4_PASSLOG=3: print every pass of one frame (the staged upscale chain)
+	// when that frame's 4K output pass arrives. Bounded to 40 chains.
+	static const bool chain_log = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4_PASSLOG");
+		return value != nullptr && std::strcmp(value, "3") == 0;
+	}();
+	static const uint64_t chain_start = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4_CHAIN_AT");
+		return value != nullptr ? std::strtoull(value, nullptr, 0) : 0ull;
+	}();
+	if (chain_log) {
+		struct ChainRecord {
+			uint32_t in_w;
+			uint32_t in_h;
+			uint32_t out_w;
+			uint32_t out_h;
+			ImageId  output;
+			ImageId  mv;
+			ImageId  color;
+			ImageId  depth;
+		};
+		static std::vector<ChainRecord> records;
+		static uint64_t                 current_frame = 0;
+		static bool                     have_frame    = false;
+		static uint32_t                 printed       = 0;
+		if (!have_frame || frame != current_frame) {
+			records.clear();
+			current_frame = frame;
+			have_frame    = true;
+		}
+		ChainRecord record {in_w, in_h, out_w, out_h, output, {}, {}, {}};
+		if (pixel.images.size() >= 2) {
+			record.mv    = pixel.images[0].image_id;
+			record.color = pixel.images[1].image_id;
+			record.depth = DepthForColor(record.mv);
+		}
+		records.push_back(record);
+		if (out_w == 3840 && out_h == 2160 && (in_w < out_w || in_h < out_h) &&
+		    printed < 40 && frame >= chain_start) {
+			++printed;
+			std::printf("FSR4: chain frame=%u\n", frame);
+			for (const auto& r: records) {
+				std::printf("  %ux%u -> %ux%u out=%u/%u mv=%u/%u color=%u/%u depth=%u/%u\n",
+				            r.in_w, r.in_h, r.out_w, r.out_h, r.output.index, r.output.generation,
+				            r.mv.index, r.mv.generation, r.color.index, r.color.generation,
+				            r.depth.index, r.depth.generation);
+			}
+			std::fflush(stdout);
+		}
+	}
+	// The game uses the same upscale shader for intermediate and 1:1 passes. FSR4 is only
+	// meaningful for the final 4K scene upscale. ASTROHYBRID_FSR4_ALLOW_1TO1=1 also replaces
+	// the 1:1 4K pass (diagnostic: makes every frame go through FSR4 so a mixed
+	// FSR4/game-upscaler image can be ruled out).
+	static const bool allow_1to1 = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4_ALLOW_1TO1");
+		return value != nullptr && std::strcmp(value, "1") == 0;
+	}();
+	constexpr uint32_t kTargetWidth = 3840;
+	constexpr uint32_t kTargetHeight = 2160;
+	if (out_w != kTargetWidth || out_h != kTargetHeight || in_w > out_w || in_h > out_h ||
+	    (!allow_1to1 && (in_w >= out_w || in_h >= out_h))) {
+		std::fprintf(stderr, "UPSDBG early return #5\n");
+		return false;
+	}
+	if (s.last_dispatch_frame == frame) {
+		std::fprintf(stderr, "UPSDBG early return #6\n");
+		return false;
+	}
+
+	auto&      cache      = m_context.GetTextureCache();
+	const auto mv_id      = pixel.images[0].image_id;
+	const auto color_id   = pixel.images[1].image_id;
+	const auto depth_id   = DepthForColor(mv_id);
+	if (!depth_id || cache.m_slot_images.try_get(depth_id) == nullptr) {
+		std::fprintf(stderr, "UPSDBG early return #7\n");
+		return false;
+	}
+	auto& mv    = cache.GetImage(mv_id);
+	auto& color = cache.GetImage(color_id);
+	auto& depth = cache.GetImage(depth_id);
+	auto& out   = cache.GetImage(output);
+	// A4b: the scene target may have been clamped to 1920x1080 while the game's constants
+	// still name 2432/3328. Use the actual color image extent for the FSR4 dispatch.
+	if (color.info.extent.width != in_w || color.info.extent.height != in_h) {
+		in_w = color.info.extent.width;
+		in_h = color.info.extent.height;
+	}
+	const auto same = [](const Image& image, uint32_t w, uint32_t h) {
+		return image.info.extent.width == w && image.info.extent.height == h &&
+		       image.backing.image != nullptr && image.info.samples == 1;
+	};
+	if (!same(mv, in_w, in_h) || !same(color, in_w, in_h) || !same(depth, in_w, in_h) ||
+	    !same(out, out_w, out_h) || !depth.info.IsDepth() ||
+	    !(out.backing.usage & vk::ImageUsageFlagBits::eStorage)) {
+		std::fprintf(stderr, "UPSDBG early return #8\n");
+		return false;
+	}
+
+	if (!LoadProvider(s)) {
+		std::fprintf(stderr, "UPSDBG early return #9\n");
+		return false;
+	}
+	auto& graphics = m_context.GetGraphics();
+	if (!CreateContext(s, graphics, 3840, 2160, 3840, 2160)) {
+		std::fprintf(stderr, "UPSDBG early return #10\n");
+		return false;
+	}
+
+	// Diagnostics: the provider only maps a few formats (an unmapped one falls back to RGBA8),
+	// so print what the four resources really are before the first dispatch.
+	static bool formats_logged = false;
+	if (!formats_logged) {
+		formats_logged = true;
+		std::printf("FSR4: formats mv=%s(%u layer(s)) color=%s(%u) depth=%s(%u) out=%s(%u)\n",
+		            vk::to_string(mv.backing.format).c_str(), mv.backing.layers,
+		            vk::to_string(color.backing.format).c_str(), color.backing.layers,
+		            vk::to_string(depth.backing.format).c_str(), depth.backing.layers,
+		            vk::to_string(out.backing.format).c_str(), out.backing.layers);
+		std::fflush(stdout);
+	}
+
+	buffer.EndRendering();
+	const auto cmd = buffer.Handle();
+
+	mv.Transit(vk::ImageLayout::eShaderReadOnlyOptimal, vk::AccessFlagBits2::eShaderSampledRead, {}, cmd);
+	color.Transit(vk::ImageLayout::eShaderReadOnlyOptimal, vk::AccessFlagBits2::eShaderSampledRead, {}, cmd);
+	depth.Transit(vk::ImageLayout::eShaderReadOnlyOptimal, vk::AccessFlagBits2::eShaderSampledRead, {}, cmd);
+	out.Transit(vk::ImageLayout::eGeneral,
+	            vk::AccessFlagBits2::eShaderStorageRead | vk::AccessFlagBits2::eShaderStorageWrite, {},
+	            cmd);
+
+	const auto resource = [](const Image& image, uint32_t extra, VkImageLayout layout) {
+		return ffxApiGetResourceVK(static_cast<VkImage>(image.backing.image),
+		                           DescribeImage(image, extra), static_cast<uint32_t>(layout));
+	};
+
+	ffxDispatchDescUpscale desc {};
+	desc.header.type       = FFX_API_DISPATCH_DESC_TYPE_UPSCALE;
+	desc.commandList       = cmd;
+	desc.color             = resource(color, 0, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	desc.depth             = resource(depth, 0, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	desc.motionVectors     = resource(mv, 0, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	desc.output            = resource(out, VK_IMAGE_USAGE_STORAGE_BIT, VK_IMAGE_LAYOUT_GENERAL);
+	desc.renderSize        = {in_w, in_h};
+	desc.upscaleSize       = {out_w, out_h};
+
+	static const float mv_sign = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4_MV_SIGN");
+		return value != nullptr ? std::strtof(value, nullptr) : -1.0f;
+	}();
+	static const float pre_exposure = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4_PRE_EXPOSURE");
+		return value != nullptr ? std::strtof(value, nullptr) : 1.0f;
+	}();
+	static const float camera_near = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4_NEAR");
+		return value != nullptr ? std::strtof(value, nullptr) : 0.1f;
+	}();
+	static const float camera_far = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4_FAR");
+		return value != nullptr ? std::strtof(value, nullptr) : 1000.0f;
+	}();
+	static const bool sharpening = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4_SHARPEN");
+		return value != nullptr && std::strcmp(value, "1") == 0;
+	}();
+
+	desc.motionVectorScale    = {mv_sign * static_cast<float>(in_w),
+	                             mv_sign * static_cast<float>(in_h)};
+	desc.jitterOffset         = {jitter_uv[0] * static_cast<float>(in_w),
+	                             jitter_uv[1] * static_cast<float>(in_h)};
+	desc.enableSharpening     = sharpening;
+	desc.sharpness            = sharpening ? 0.2f : 0.0f;
+	desc.frameTimeDelta       = 16.7f;
+	desc.preExposure          = pre_exposure;
+	// A frame discontinuity is a reset, and so is a render-size change: the game's dynamic
+	// resolution switches often and the provider's history is not meant to cross scales.
+	desc.reset                = (s.last_frame != 0 && frame != s.last_frame + 1) ||
+	                            (s.last_in_w != 0 && (in_w != s.last_in_w || in_h != s.last_in_h));
+	desc.cameraNear           = camera_near;
+	desc.cameraFar            = camera_far;
+	desc.cameraFovAngleVertical = 1.0472f;
+	desc.viewSpaceToMetersFactor = 1.0f;
+	desc.flags                = 0;
+
+	static uint32_t dispatched  = 0;
+	static auto     rate_start  = std::chrono::steady_clock::now();
+	if (desc.reset) {
+		std::printf("FSR4: history reset for frame=%u\n", frame);
+		std::fflush(stdout);
+	}
+	++dispatched;
+	if (const auto now = std::chrono::steady_clock::now();
+	    now - rate_start >= std::chrono::seconds(1)) {
+		const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(now - rate_start).count();
+		std::printf("FSR4: dispatched %u time(s) in %lld ms (frame=%u %ux%u -> %ux%u fg_presented=%llu)\n",
+		            dispatched, static_cast<long long>(elapsed), frame, in_w, in_h, out_w, out_h,
+		            static_cast<unsigned long long>(FsrFg::PresentedCount()));
+		std::fflush(stdout);
+		dispatched = 0;
+		rate_start = now;
+	}
+	s.last_frame = frame;
+	const auto result = s.dispatch(&s.context, &desc.header);
+	buffer.ForgetBoundState();
+	if (result != FFX_API_RETURN_OK) {
+		static uint32_t logged = 0;
+		if (logged++ < 8) {
+			std::printf("FSR4: ffxDispatch failed (0x%x)\n", static_cast<unsigned>(result));
+			std::fflush(stdout);
+		}
+		std::fprintf(stderr, "UPSDBG early return #11\n");
+		return false;
+	}
+	// The output now holds FSR4's image: a GPU write of the target, as the replaced draw's
+	// would be. Without this the texture cache can treat the target as unwritten and let
+	// stale or aliased bytes reappear over part of FSR4's output.
+	out.NoteContentWrite();
+	cache.CommitGpuWrite(out);
+	s.last_dispatch_frame = frame;
+
+	// ASTROHYBRID_FSR_FG=1 (fsrFg.h): the upscaled output is what frame generation
+	// interpolates from, and this is the one place that has colour, depth and motion
+	// vectors together.
+	if (FsrFg::Active()) {
+		FsrFg::DispatchFrame(VK_NULL_HANDLE,
+		                     static_cast<VkImage>(out.backing.image),
+		                     static_cast<VkFormat>(out.backing.format),
+		                     static_cast<VkImage>(depth.backing.image),
+		                     static_cast<VkFormat>(depth.backing.format),
+		                     static_cast<VkImage>(mv.backing.image),
+		                     static_cast<VkFormat>(mv.backing.format), out_w, out_h);
+	}
+	s.last_in_w           = in_w;
+	s.last_in_h           = in_h;
+	return true;
+}
+
+#endif // !defined(_WIN32)
+
+} // namespace Libs::Graphics
diff --git a/src/graphics/host_gpu/renderer/fsr4.h b/src/graphics/host_gpu/renderer/fsr4.h
new file mode 100644
