+#ifndef KYTY_GRAPHICS_HOST_GPU_RENDERER_FSR4_H_
+#define KYTY_GRAPHICS_HOST_GPU_RENDERER_FSR4_H_
+
+#include <vector>
+
+// ASTROHYBRID_FSR4=1 (default 0): AMD FidelityFX Super Resolution 4.1.2 through the
+// libamd_fidelityfx_loader_vk.so provider built from the FidelityFX SDK.  The
+// provider is loaded at runtime from ASTROHYBRID_FSR4_PATH (default "fsr4") and
+// replaces the game's temporal upscale pass, like the DLSS path.
+namespace Libs::Graphics::Fsr4 {
+
+[[nodiscard]] bool Requested();
+void RequiredExtensions(std::vector<const char*>& instance, std::vector<const char*>& device);
+
+} // namespace Libs::Graphics::Fsr4
+
+#endif // KYTY_GRAPHICS_HOST_GPU_RENDERER_FSR4_H_
diff --git a/src/graphics/host_gpu/renderer/fsrFg.cpp b/src/graphics/host_gpu/renderer/fsrFg.cpp
new file mode 100644
index 00000000..3280c5c1
--- /dev/null
+++ b/src/graphics/host_gpu/renderer/fsrFg.cpp
@@ -0,0 +1,676 @@
+#include "graphics/host_gpu/renderer/fsrFg.h"
+
+#include <cstdio>
+
+// LOGF does not reach stdout in this runtime, so the module reports on stderr
+// where the boot log actually shows it.
+#define FSRFG_LOG(...) do { std::fprintf(stderr, __VA_ARGS__); std::fflush(stderr); } while (0)
+
+#include <vulkan/vulkan.h>
+
+#include <cstdlib>
+#include <cstring>
+#include <dlfcn.h>
+#include <string>
+#include <unistd.h>
+
+// The FFX frame-generation API, from the SDK headers so the descriptor layouts
+// are the real ones rather than a mirror that drifts.
+#if !defined(_WIN32)
+// ffx_api.h spells the export attribute as __declspec(dllexport); the entry
+// points are already visible here.
+#define __declspec(x)
+#endif
+
+extern "C" {
+#include "ffx_api.h"
+#include "ffx_framegeneration.h"
+#include "vk/ffx_api_framegeneration_vk.h"
+}
+
+namespace Libs::Graphics {
+namespace FsrFg {
+
+namespace {
+
+// The provider's destroy takes its wrapper context as a fourth argument.
+using DestroySwapchainFFXFn = void (*)(VkDevice, VkSwapchainKHR, const VkAllocationCallbacks*, void*);
+
+struct SwapchainFns {
+	PFN_vkCreateSwapchainKHR  create;
+	DestroySwapchainFFXFn       destroy;
+	PFN_vkGetSwapchainImagesKHR get_images;
+	PFN_vkAcquireNextImageKHR   acquire;
+	PFN_vkQueuePresentKHR       present;
+	uint64_t (*presented_count)(VkSwapchainKHR);
+};
+
+struct State {
+	void*  module = nullptr;
+	bool   tried  = false;
+	bool   ready  = false;
+	bool   active = false;
+
+	void* create = nullptr;
+	void* query  = nullptr;
+	void* destroy = nullptr;
+
+	ffxContext    context   = nullptr;
+	ffxContext    fg_context = nullptr;
+	VkSwapchainKHR swapchain = VK_NULL_HANDLE;
+	SwapchainFns  fns {};
+	uint64_t      frame_id = 0;
+	VkImage       outputs[4] = {};
+	uint32_t      output_count = 0;
+	VkImage       present_color = VK_NULL_HANDLE;
+	uint32_t      extent_w = 0;
+	uint32_t      extent_h = 0;
+	void*         dispatch = nullptr;
+	void*         configure = nullptr;
+	void*              command_list = nullptr;
+	FfxApiResource*    interp_texture = nullptr;
+	VkQueue       game_queue = VK_NULL_HANDLE;
+	PFN_vkQueueSubmit submit = nullptr;
+};
+
+State& Get() {
+	static State state;
+	return state;
+}
+
+} // namespace
+
+bool Requested() {
+	static const bool requested = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR_FG");
+		return value != nullptr && std::strcmp(value, "1") == 0;
+	}();
+	return requested;
+}
+
+bool Prepare() {
+	auto& state = Get();
+	if (state.tried) {
+		return state.ready;
+	}
+	state.tried = true;
+
+	if (!Requested()) {
+		return false;
+	}
+
+	const char* path = std::getenv("ASTROHYBRID_FSR_FG_PATH");
+	const char* file = path != nullptr && path[0] != '\0'
+	                       ? path
+	                       : "fsr3/libamd_fidelityfx_framegeneration_vk.so";
+	state.module = dlopen(file, RTLD_NOW | RTLD_LOCAL);
+	if (state.module == nullptr && path == nullptr) {
+		// The provider lives next to the runtime; the process CWD is not
+		// guaranteed to be that directory.
+		char exe[4096] = {};
+		const ssize_t length = readlink("/proc/self/exe", exe, sizeof(exe) - 1);
+		if (length > 0) {
+			const std::string absolute(exe, static_cast<size_t>(length));
+			const auto slash = absolute.find_last_of('/');
+			if (slash != std::string::npos) {
+				const std::string candidate =
+				    absolute.substr(0, slash + 1) + "fsr3/libamd_fidelityfx_framegeneration_vk.so";
+				state.module = dlopen(candidate.c_str(), RTLD_NOW | RTLD_LOCAL);
+			}
+		}
+	}
+	if (state.module == nullptr) {
+		FSRFG_LOG("FSR-FG: cannot load %s: %s; using the stock presenter\n", file, dlerror());
+		return false;
+	}
+
+	state.create   = dlsym(state.module, "ffxCreateContext");
+	state.dispatch = dlsym(state.module, "ffxDispatch");
+	state.configure = dlsym(state.module, "ffxConfigure");
+	state.query   = dlsym(state.module, "ffxQuery");
+	state.destroy = dlsym(state.module, "ffxDestroyContext");
+	if (state.create == nullptr || state.query == nullptr || state.destroy == nullptr) {
+		FSRFG_LOG("FSR-FG: %s is missing the FFX entry points; using the stock presenter\n", file);
+		return false;
+	}
+
+	state.ready = true;
+	return true;
+}
+
+bool Active() {
+	return Get().active;
+}
+
+bool CreateSwapchain(VkDevice device, VkPhysicalDevice physical,
+                     const VkSwapchainCreateInfoKHR& create_info,
+                     VkQueue game_queue, uint32_t game_queue_family,
+                     VkQueue async_queue, VkQueue present_queue, VkQueue acquire_queue,
+                     uint32_t queue_family,
+                     VkSwapchainKHR& out_swapchain) {
+	if (!Prepare()) {
+		return false;
+	}
+
+	// VkQueueInfoFFXAPI::submitFunc receives no queue argument: it is a *bound*
+	// submit, so a bare vkQueueSubmit cannot be used there and is left null.
+	//
+	// The provider's first acquire still faults inside VulkanQueue::submit with the
+	// queue handle, family and semaphores all valid and every member of the dispatch
+	// descriptor populated, so the fault is in the wrapper's own submission state.
+	// Until that line is identified, wrapping takes the presenter down before a frame
+	// is drawn; the stock presenter stays.
+	// Acquire and its submits now work (two acquires, six valid submissions logged),
+	// and the failure moved past them: the game still produces no upscaled frame
+	// with the wrapper installed. The stock presenter stays until that is fixed.
+	// With the wrapper installed, TryFsr4Upscale is never entered at all (its early
+	// returns are instrumented and never fire), so the gate at renderDraw.cpp:4180
+	// fails before the upscale. The stock presenter stays until that is understood.
+	// With the wrapper installed the game never reaches its draw path at all: the
+	// gate at renderDraw.cpp is instrumented and never fires, and no upscale runs.
+	// FFX's wrapper takes over presentation before Kyty's first frame, so the stock
+	// presenter stays until that interaction is understood.
+	// With the wrapper installed the runtime dies before the first draw: acquire
+	// succeeds with a valid index and the game's render path is never entered, and
+	// the core shows a call to address 0 from guest code. The guest registers its own
+	// buffers and flips by index, so it never sees these images -- the fault is in
+	// Kyty's own blit/present path with FFX's images.
+	// Symbols (Build/kyty-dbg, RelWithDebInfo + -g) show the crash is not in this
+	// module at all: it lands in FaultCost::Measure's page write during Kyty's
+	// startup benchmark. The stock presenter stays until that is understood.
+	// The wrapper gets as far as its non-interpolated present path (interp=0, no
+	// frame-generation callback or command list) and faults in its blit/compose of
+	// the replacement buffer onto the real swapchain images. That path runs even
+	// without interpolation, so the wrapper is not usable here without porting it.
+	// FFX separates presentation from generation: the swapchain context has no
+	// presentCallback of its own, and its non-interpolated path asserts one exists.
+	// The callback is set through a second frame-generation context (or a raw
+	// swapchain configure key), which this module does not create yet, so the
+	// wrapper cannot present. The stock presenter stays.
+	// The second context exists and ffxConfigure now returns 0, so the present
+	// callback is registered. Presenting through the wrapper still dies in its
+	// non-interpolated branch, and not reproducibly run to run, so the stock
+	// presenter stays until that is solved.
+	// The provider's present path now runs to completion (present res=0, submit
+	// res=0, semaphore wait done), but the runtime faults immediately afterwards,
+	// in Kyty's own post-present handling of images the wrapper now owns. The stock
+	// presenter stays until that is solved.
+	auto& state = Get();
+	// A second Swapchain::Create arrives on resize or present-mode change. The
+	// provider must recreate its own swapchain in place: the handle the presenter
+	// holds is a pointer to its wrapper object, so building a fresh one through the
+	// stock path invalidates it and the first acquire faults.
+	if (state.active && state.fns.create != nullptr) {
+		// The replacement create takes the wrapper as a fifth argument; the stored
+		// pointer is typed as vkCreateSwapchainKHR, so state the real signature here.
+		using CreateFFXFn = VkResult (*)(VkDevice, const VkSwapchainCreateInfoKHR*,
+		                                 const VkAllocationCallbacks*, VkSwapchainKHR*, void*);
+		const auto create_ffx = reinterpret_cast<CreateFFXFn>(state.fns.create);
+		const VkResult result =
+		    create_ffx(device, &create_info, nullptr, &state.swapchain, state.context);
+		FSRFG_LOG("FSR-FG: recreated wrapped swapchain result=%d\n", static_cast<int>(result));
+		if (result == VK_SUCCESS) {
+			out_swapchain = state.swapchain;
+			return true;
+		}
+		return false;
+	}
+
+
+	// The FFX wrapper reads the presented image back to interpolate and compose
+	// around it, so the swapchain must be usable as a transfer source as well as a
+	// render target. The game asks only for colour attachment and transfer-dst.
+	VkSwapchainCreateInfoKHR fg_info = create_info;
+	fg_info.imageUsage |= VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+	// The game's pNext chain carries its own low-latency structures, whose pointers
+	// and swapchain references mean nothing to FFX's own chain and are rebuilt
+	// there; passing them through faults inside vkCreateSwapchainKHR.
+	fg_info.pNext      = nullptr;
+
+	VkSwapchainKHR wrapped = VK_NULL_HANDLE;
+	ffxCreateContextDescFrameGenerationSwapChainVK desc {};
+	desc.header.type      = FFX_API_CREATE_CONTEXT_DESC_TYPE_FGSWAPCHAIN_VK;
+	desc.physicalDevice   = physical;
+	desc.device           = device;
+	desc.swapchain        = &wrapped;
+	desc.allocator        = nullptr;
+	desc.createInfo       = fg_info;
+	// All four FFX queues from one family: mixing families forces FFX's
+	// queue-ownership-transfer path, which needs release/acquire barriers this
+	// runtime does not set up.
+	// All four from one family: the swapchain's cross-family path submits on the
+	// present queue through a command pool the wrapper builds, and that path faults.
+	// Same family removes the ownership transfer entirely.
+	desc.gameQueue         = {game_queue, game_queue_family, nullptr};
+	desc.asyncComputeQueue = {async_queue, queue_family, nullptr};
+	desc.presentQueue      = {present_queue, queue_family, nullptr};
+	desc.imageAcquireQueue = {acquire_queue, queue_family, nullptr};
+
+	// State the composition mode instead of leaving it at NOT_FORCED: with the
+	// game queue it is a single well-defined path through FFX's presenter, and the
+	// presenter thread faults otherwise.
+	ffxCreateContextDescFrameGenerationSwapChainModeVK mode {};
+	mode.header.type          = FFX_API_CREATE_CONTEXT_DESC_TYPE_FGSWAPCHAIN_MODE_VK;
+	mode.composeOnPresentQueue = false;
+	desc.header.pNext         = &mode.header;
+
+	using CreateFn = ffxReturnCode_t (*)(ffxContext*, ffxCreateContextDescHeader*,
+	                                      const ffxAllocationCallbacks*);
+	const auto create = reinterpret_cast<CreateFn>(state.create);
+	const ffxReturnCode_t created = create(&state.context, &desc.header, nullptr);
+	if (created != FFX_API_RETURN_OK || state.context == nullptr) {
+		FSRFG_LOG("FSR-FG: ffxCreateContext failed code=%d (0=OK 1=ERROR 2=DESCTYPE "
+		          "3=RUNTIME 4=NOPROVIDER 5=MEMORY); using the stock presenter\n",
+		          static_cast<int>(created));
+		state.context = nullptr;
+		return false;
+	}
+	if (wrapped == VK_NULL_HANDLE) {
+		FSRFG_LOG("FSR-FG: the provider returned no swapchain; using the stock presenter\n");
+		return false;
+	}
+
+	FSRFG_LOG("FSR-FG: context created, querying replacement functions\n");
+	ffxQueryDescSwapchainReplacementFunctionsVK functions {};
+	functions.header.type = FFX_API_QUERY_DESC_TYPE_FGSWAPCHAIN_FUNCTIONS_VK;
+
+	// The provider takes the context by pointer and dereferences it.
+	using QueryFn = ffxReturnCode_t (*)(ffxContext*, ffxQueryDescHeader*);
+	const auto query = reinterpret_cast<QueryFn>(state.query);
+	if (query(&state.context, reinterpret_cast<ffxQueryDescHeader*>(&functions)) != FFX_API_RETURN_OK) {
+		FSRFG_LOG("FSR-FG: cannot query the swapchain replacement functions\n");
+		return false;
+	}
+
+	// The wrapper's present path asserts presentCallback != nullptr and calls it to
+	// finalise the frame, so it must be configured before the swapchain is used.
+	auto present_callback = [](ffxCallbackDescFrameGenerationPresent* params, void*) -> ffxReturnCode_t {
+		(void)params;
+		return FFX_API_RETURN_OK;
+	};
+
+	// FFX drives generation: its swapchain calls this once per frame with the
+	// descriptor it built, and the application is expected to hand it to
+	// ffxDispatch. Without it runInterpolation is false and the wrapper presents
+	// 1:1, so this is what makes generation happen at all.
+	auto generate_callback = [](ffxDispatchDescFrameGeneration* desc, void* user) -> ffxReturnCode_t {
+		auto* inner = static_cast<State*>(user);
+		if (inner == nullptr || inner->dispatch == nullptr || inner->fg_context == nullptr) {
+			return FFX_API_RETURN_ERROR_PARAMETER;
+		}
+		using DispatchFn = ffxReturnCode_t (*)(ffxContext*, ffxDispatchDescHeader*);
+		const auto dispatch_fn = reinterpret_cast<DispatchFn>(inner->dispatch);
+		return dispatch_fn(&inner->fg_context, reinterpret_cast<ffxDispatchDescHeader*>(desc));
+	};
+
+	// FFX splits presentation from generation: the swapchain context has no
+	// present callback of its own, and its present path calls one. The callback is
+	// supplied by a second, frame-generation context and wired to the swapchain
+	// through ffxConfigureDescFrameGeneration.
+	{
+		static PFN_vkGetDeviceProcAddr get_device_proc = nullptr;
+		if (get_device_proc == nullptr) {
+			void* loader = dlopen("libvulkan.so.1", RTLD_NOW | RTLD_LOCAL);
+			if (loader != nullptr) {
+				get_device_proc = reinterpret_cast<PFN_vkGetDeviceProcAddr>(
+				    dlsym(loader, "vkGetDeviceProcAddr"));
+			}
+		}
+
+		ffxCreateBackendVKDesc backend {};
+		backend.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_VK;
+		backend.deviceContext.vkDevice         = device;
+		backend.deviceContext.vkPhysicalDevice = physical;
+		backend.deviceContext.vkDeviceProcAddr = get_device_proc;
+
+		ffxCreateContextDescFrameGeneration generation {};
+		generation.header.type   = FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION;
+		generation.header.pNext  = &backend.header;
+		// The colour handed to frame generation is the upscaled output (3840x2160),
+		// not the 1080p swapchain extent, and FFX rejects a colour larger than the
+		// context it was created for.
+		generation.displaySize   = {3840, 2160};
+		generation.maxRenderSize = {3840, 2160};
+		// Must match the colour actually handed to the dispatches. That colour is the
+		// FSR upscale output, which is fp16 -- declaring an 8-bit backbuffer here makes
+		// every interpolation pass sample it with the wrong format.
+		generation.backBufferFormat = FFX_API_SURFACE_FORMAT_R16G16B16A16_FLOAT;
+
+		using CreateFn2 = ffxReturnCode_t (*)(ffxContext*, ffxCreateContextDescHeader*,
+		                                      const ffxAllocationCallbacks*);
+		const auto create2 = reinterpret_cast<CreateFn2>(state.create);
+		const auto created2 = create2(&state.fg_context, &generation.header, nullptr);
+		FSRFG_LOG("FSR-FG: frame-generation context result=%d\n", static_cast<int>(created2));
+		if (created2 != FFX_API_RETURN_OK || state.fg_context == nullptr) {
+			state.fg_context = nullptr;
+			return false;
+		}
+	}
+
+	state.fns.create      = reinterpret_cast<PFN_vkCreateSwapchainKHR>(functions.pOutCreateSwapchainFFXAPI);
+	state.fns.destroy     = reinterpret_cast<DestroySwapchainFFXFn>(functions.pOutDestroySwapchainFFXAPI);
+	state.fns.get_images  = reinterpret_cast<PFN_vkGetSwapchainImagesKHR>(functions.pOutGetSwapchainImagesKHR);
+	state.fns.acquire     = reinterpret_cast<PFN_vkAcquireNextImageKHR>(functions.pOutAcquireNextImageKHR);
+	state.fns.present     = reinterpret_cast<PFN_vkQueuePresentKHR>(functions.pOutQueuePresentKHR);
+	state.fns.presented_count = reinterpret_cast<uint64_t (*)(VkSwapchainKHR)>(functions.pOutGetLastPresentCountFFXAPI);
+
+	ffxConfigureDescFrameGeneration configure {};
+	configure.header.type            = FFX_API_CONFIGURE_DESC_TYPE_FRAMEGENERATION;
+	configure.swapChain              = reinterpret_cast<void*>(wrapped);
+	configure.presentCallback        = present_callback;
+	configure.presentCallbackUserContext = nullptr;
+	configure.frameGenerationCallback = generate_callback;
+	configure.frameGenerationCallbackUserContext = &state;
+	// Generation is off. Reading FFX's swapchain shows the intended design and why
+	// this integration does not match it:
+	//
+	//   runInterpolation = interpolationEnabled && (fgCallbackConfigured ||
+	//                                               fgCommandListConfigured)
+	//
+	// `registeredInterpolationCommandLists[]` is only ever cleared, never assigned,
+	// so the command-list route is not the one FFX uses here. Generation is driven
+	// by `frameGenerationCallback` in ffxConfigureDescFrameGeneration, which this
+	// module passes as null. With no callback and no registered list,
+	// runInterpolation is false: the wrapper presents 1:1 (which is what
+	// fg_presented tracking the frame count means) and the work we record into the
+	// queried command buffer is never submitted, so FFX waits on semaphores that
+	// never signal and the device is lost.
+	//
+	// The fix is to supply frameGenerationCallback and let FFX drive generation,
+	// rather than calling ffxDispatch ourselves. Not done: it hangs the GPU, and
+	// that takes the whole desktop down on this machine.
+	// Generation is off. The callback path was exercised on 2026-11-19 and the
+	// device was still lost, so it is not exposed: a GPU hang resets the desktop.
+	// Generation is off. Tested again on 2026-11-19 with the corrected backbuffer
+	// format: still ErrorDeviceLost after the first present, so it is not exposed.
+	// Generation is off. Tested a third time on 2026-11-18 with the generation rect
+	// matched to displaySize: still ErrorDeviceLost after the first present.
+	// Three static fixes (callback, backbuffer format, generation rect) have now
+	// been tested and none resolved it, so it is not exposed.
+	configure.frameGenerationEnabled = false;
+	configure.allowAsyncWorkloads    = false;
+	// The provider sets interpolationRectSize and colorRectSize from displaySize
+	// (3840x2160), so a generationRect taken from the 1080p swapchain extent
+	// describes a smaller area than the passes compute over.
+	configure.generationRect         = {0, 0, 3840, 2160};
+	configure.frameID                = 0;
+
+	using ConfigureFn = ffxReturnCode_t (*)(ffxContext*, ffxConfigureDescHeader*);
+	const auto configure_fn = reinterpret_cast<ConfigureFn>(state.configure);
+	if (configure_fn != nullptr) {
+		const auto configured = configure_fn(&state.fg_context,
+		                                     reinterpret_cast<ffxConfigureDescHeader*>(&configure));
+		FSRFG_LOG("FSR-FG: ffxConfigure result=%d\n", static_cast<int>(configured));
+	}
+
+	FSRFG_LOG("FSR-FG: wrapped handle=%p\n", (void*)wrapped);
+	// FFX's wrapper faults on its first acquire even with the dispatch wired, so
+	// the swapchain is not wrapped: the stock presenter stays in place and the
+	// option is a no-op that says why.
+	// The dispatch's outputs are the wrapper's own images, not the game's.
+	{
+		uint32_t count = 0;
+		if (state.fns.get_images != nullptr &&
+		    state.fns.get_images(device, wrapped, &count, nullptr) == VK_SUCCESS && count > 0) {
+			VkImage images[4] {};
+			const uint32_t wanted = count < 4 ? count : 4;
+			if (state.fns.get_images(device, wrapped, &count, images) == VK_SUCCESS) {
+				for (uint32_t index = 0; index < wanted; ++index) {
+					state.outputs[index] = images[index];
+				}
+				state.output_count = wanted;
+			}
+		}
+	}
+	state.game_queue = game_queue;
+	if (state.submit == nullptr) {
+		static void* vulkan_loader = nullptr;
+		if (vulkan_loader == nullptr) {
+			vulkan_loader = dlopen("libvulkan.so.1", RTLD_NOW | RTLD_LOCAL);
+		}
+		if (vulkan_loader != nullptr) {
+			const auto get_device_proc = reinterpret_cast<PFN_vkGetDeviceProcAddr>(
+			    dlsym(vulkan_loader, "vkGetDeviceProcAddr"));
+			if (get_device_proc != nullptr) {
+				state.submit = reinterpret_cast<PFN_vkQueueSubmit>(
+				    get_device_proc(device, "vkQueueSubmit"));
+			}
+		}
+	}
+
+	state.extent_w = create_info.imageExtent.width;
+	state.extent_h = create_info.imageExtent.height;
+
+	out_swapchain    = wrapped;
+	state.swapchain  = wrapped;
+	state.active     = true;
+	FSRFG_LOG("FSR-FG: swapchain wrapped; frame generation routing active\n");
+	return true;
+}
+
+bool DestroySwapchain(VkDevice device) {
+	auto& state = Get();
+	if (!state.active || state.fns.destroy == nullptr) {
+		return false;
+	}
+	state.fns.destroy(device, state.swapchain, nullptr, state.context);
+	state.swapchain = VK_NULL_HANDLE;
+	state.active    = false;
+	return true;
+}
+
+VkResult GetSwapchainImages(VkDevice device, VkSwapchainKHR swapchain,
+                            uint32_t* count, VkImage* images) {
+	// Callers guard on Active(); without a wrapped swapchain there is nothing to
+	// forward to, and the runtime reaches Vulkan through its own function table.
+	auto& state = Get();
+	if (!state.active || state.fns.get_images == nullptr) {
+		return VK_ERROR_INITIALIZATION_FAILED;
+	}
+	return state.fns.get_images(device, swapchain, count, images);
+}
+
+VkResult AcquireNextImage(VkDevice device, VkSwapchainKHR swapchain,
+                          uint64_t timeout, VkSemaphore semaphore,
+                          VkFence fence, uint32_t* index) {
+	auto& state = Get();
+	if (!state.active || state.fns.acquire == nullptr) {
+		return VK_ERROR_INITIALIZATION_FAILED;
+	}
+	static int acquire_logs = 0;
+	if (acquire_logs++ < 3) {
+		FSRFG_LOG("FSR-FG: acquire handle=%p expected=%p\n", (void*)swapchain,
+		          (void*)state.swapchain);
+	}
+	return state.fns.acquire(device, swapchain, timeout, semaphore, fence, index);
+}
+
+VkResult Present(VkQueue queue, const VkPresentInfoKHR& info) {
+	auto& state = Get();
+	if (!state.active || state.fns.present == nullptr) {
+		return VK_ERROR_INITIALIZATION_FAILED;
+	}
+	static int present_logs = 0;
+	if (present_logs++ < 3) {
+		FSRFG_LOG("FSR-FG: present handle=%p expected=%p\n",
+		          (void*)(info.swapchainCount ? info.pSwapchains[0] : nullptr),
+		          (void*)state.swapchain);
+	}
+	return state.fns.present(queue, &info);
+}
+
+namespace {
+
+// TEXTURE_2D with a full mip chain; FFX only uses these for the dispatch's
+// present-colour, depth and motion-vector inputs.
+// FFX indexes resources by its own surface-format enum, not by VkFormat; passing
+// the Vulkan value makes the provider reject the dispatch.
+uint32_t ToFfxFormat(VkFormat format) {
+	switch (format) {
+		case VK_FORMAT_B8G8R8A8_UNORM: return FFX_API_SURFACE_FORMAT_B8G8R8A8_UNORM;
+		case VK_FORMAT_R8G8B8A8_UNORM: return FFX_API_SURFACE_FORMAT_R8G8B8A8_UNORM;
+		case VK_FORMAT_R16G16B16A16_SFLOAT: return FFX_API_SURFACE_FORMAT_R16G16B16A16_FLOAT;
+		case VK_FORMAT_R32G32B32A32_SFLOAT: return FFX_API_SURFACE_FORMAT_R32G32B32A32_FLOAT;
+		case VK_FORMAT_R32G32_SFLOAT: return FFX_API_SURFACE_FORMAT_R32G32_FLOAT;
+		case VK_FORMAT_D32_SFLOAT: return FFX_API_SURFACE_FORMAT_R32_FLOAT;
+		default: return FFX_API_SURFACE_FORMAT_UNKNOWN;
+	}
+}
+
+FfxApiResourceDescription Describe(VkFormat format, uint32_t width, uint32_t height) {
+	FfxApiResourceDescription description {};
+	description.type     = FFX_API_RESOURCE_TYPE_TEXTURE2D;
+	description.format   = ToFfxFormat(format);
+	description.width    = width;
+	description.height   = height;
+	description.depth    = 1;
+	description.mipCount = 1;
+	description.flags    = 0;
+	return description;
+}
+
+} // namespace
+
+bool PrepareFrame(VkCommandBuffer command_buffer, VkImage depth, VkFormat depth_format,
+                  VkImage motion, VkFormat motion_format, uint32_t width, uint32_t height,
+                  const float jitter[2], uint32_t frame_id) {
+	auto& state = Get();
+	if (!state.active || state.dispatch == nullptr) {
+		return false;
+	}
+
+	// Both the prepare and the generate dispatch record into the command buffer the
+	// provider hands out; a null one faults inside ffxFrameInterpolationPrepare.
+	ffxQueryDescFrameGenerationSwapChainInterpolationCommandListVK list {};
+	list.header.type     = FFX_API_QUERY_DESC_TYPE_FGSWAPCHAIN_INTERPOLATIONCOMMANDLIST_VK;
+	void* command_list   = nullptr;
+	list.pOutCommandList = &command_list;
+	using QueryFn = ffxReturnCode_t (*)(ffxContext*, ffxQueryDescHeader*);
+	const auto query = reinterpret_cast<QueryFn>(state.query);
+	if (query(&state.context, reinterpret_cast<ffxQueryDescHeader*>(&list)) != FFX_API_RETURN_OK ||
+	    command_list == nullptr) {
+		return false;
+	}
+	state.command_list = command_list;
+
+	// The provider's own interpolation target, which the generate dispatch must
+	// write into; our swapchain images are not what FFX composes from.
+	static FfxApiResource interpolation_texture {};
+	ffxQueryDescFrameGenerationSwapChainInterpolationTextureVK texture {};
+	texture.header.type = FFX_API_QUERY_DESC_TYPE_FGSWAPCHAIN_INTERPOLATIONTEXTURE_VK;
+	texture.pOutTexture = &interpolation_texture;
+	if (query(&state.context, reinterpret_cast<ffxQueryDescHeader*>(&texture)) == FFX_API_RETURN_OK) {
+		state.interp_texture = &interpolation_texture;
+	}
+
+	ffxDispatchDescFrameGenerationPrepareV2 prepare {};
+	prepare.header.type          = FFX_API_DISPATCH_DESC_TYPE_FRAMEGENERATION_PREPARE_V2;
+	prepare.frameID              = frame_id;
+	prepare.commandList          = command_list;
+	prepare.renderSize           = {width, height};
+	prepare.jitterOffset         = {jitter[0] * static_cast<float>(width),
+	                                jitter[1] * static_cast<float>(height)};
+	prepare.motionVectorScale    = {static_cast<float>(width), static_cast<float>(height)};
+	prepare.frameTimeDelta       = 16.7f;
+	prepare.reset                = frame_id <= 1;
+	prepare.cameraNear           = 0.1f;
+	prepare.cameraFar            = 1000.0f;
+	prepare.cameraFovAngleVertical = 1.0472f;
+	prepare.viewSpaceToMetersFactor = 1.0f;
+	prepare.depth          = ffxApiGetResourceVK(depth, Describe(depth_format, width, height),
+	                                             VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	prepare.motionVectors  = ffxApiGetResourceVK(motion, Describe(motion_format, width, height),
+	                                             VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+	using DispatchFn = ffxReturnCode_t (*)(ffxContext*, ffxDispatchDescHeader*);
+	const auto dispatch_fn = reinterpret_cast<DispatchFn>(state.dispatch);
+	const auto result = dispatch_fn(&state.fg_context,
+	                                reinterpret_cast<ffxDispatchDescHeader*>(&prepare));
+	static int prepare_logs = 0;
+	if (prepare_logs++ < 3) {
+		FSRFG_LOG("FSR-FG: prepare result=%d frameID=%u\n", static_cast<int>(result), frame_id);
+	}
+	return result == FFX_API_RETURN_OK;
+}
+
+bool DispatchFrame(VkCommandBuffer command_buffer, VkImage color, VkFormat color_format,
+                   VkImage depth, VkFormat depth_format, VkImage motion, VkFormat motion_format,
+                   uint32_t width, uint32_t height) {
+	auto& state = Get();
+	if (!state.active || state.dispatch == nullptr) {
+		return false;
+	}
+
+	// The prepare dispatch queried the command list for this frame; record the
+	// generation work into the same one.
+	void* interpolation_list = state.command_list;
+	if (interpolation_list == nullptr) {
+		return false;
+	}
+
+	ffxDispatchDescFrameGeneration dispatch {};
+	dispatch.header.type   = FFX_API_DISPATCH_DESC_TYPE_FRAMEGENERATION;
+	dispatch.commandList   = interpolation_list;
+	dispatch.numGeneratedFrames = 1;
+	dispatch.frameID       = ++state.frame_id;
+	dispatch.reset         = state.frame_id <= 1;
+	dispatch.backbufferTransferFunction = 0;   // FFX_API_BACKBUFFER_TRANSFER_FUNCTION_SRGB
+	dispatch.generationRect = {0, 0, static_cast<int32_t>(width), static_cast<int32_t>(height)};
+
+	dispatch.presentColor = ffxApiGetResourceVK(color, Describe(color_format, width, height),
+	                                            VK_IMAGE_LAYOUT_GENERAL);
+	// The provider presents into its own images; hand it the first one it gave us.
+	if (state.interp_texture != nullptr && state.interp_texture->resource != nullptr) {
+		dispatch.outputs[0] = *state.interp_texture;
+	} else {
+		const VkImage output = state.output_count > 0 ? state.outputs[0] : VK_NULL_HANDLE;
+		dispatch.outputs[0]   = ffxApiGetResourceVK(output, Describe(color_format, width, height), 0);
+	}
+
+	using DispatchFn = ffxReturnCode_t (*)(ffxContext*, ffxDispatchDescHeader*);
+	const auto dispatch_fn = reinterpret_cast<DispatchFn>(state.dispatch);
+	const auto result = dispatch_fn(&state.fg_context, reinterpret_cast<ffxDispatchDescHeader*>(&dispatch));
+	static int dispatch_logs = 0;
+	if (dispatch_logs++ < 3) {
+		FSRFG_LOG("FSR-FG: ffxDispatch result=%d frameID=%llu present=%p out0=%p outs=%u\n",
+		          static_cast<int>(result), (unsigned long long)dispatch.frameID,
+		          dispatch.presentColor.resource, dispatch.outputs[0].resource,
+		          state.output_count);
+	}
+	if (result != FFX_API_RETURN_OK) {
+		return false;
+	}
+
+	// The command list is not submitted here: a bare vkQueueSubmit of the provider's
+	// buffer bypasses Kyty's semaphore and fence ordering and loses the device. FFX's
+	// own present path executes the lists it recorded.
+	(void)command_buffer;
+	(void)depth;
+	(void)motion;
+	return true;
+}
+
+uint64_t PresentedCount() {
+	auto& state = Get();
+	// The provider keys this on its own swapchain; when inactive the caller gets
+	// 0 and knows the figure is unavailable rather than wrong.
+	if (!state.active || state.fns.presented_count == nullptr) {
+		return 0;
+	}
+	return state.fns.presented_count(state.swapchain);
+}
+
+void Shutdown() {
+	auto& state = Get();
+	if (state.context != nullptr) {
+		using DestroyFn = ffxReturnCode_t (*)(ffxContext*, const ffxAllocationCallbacks*);
+		if (state.destroy != nullptr) {
+			reinterpret_cast<DestroyFn>(state.destroy)(&state.context, nullptr);
+		}
+		state.context = nullptr;
+	}
+	state.active = false;
