From 9205950d8620c8c5b8be7ef7aa76e3992895e391 Mon Sep 17 00:00:00 2001
From: local <local@localhost>
Date: Sat, 14 Nov 2026 01:22:27 +0100
Subject: [PATCH] linux: build the hybrid GPU stack with clang and expose
 KytyGpuGetNid

---
 .../host_gpu/renderer/cache/bufferCache.cpp    |  4 ++++
 src/graphics/host_gpu/renderer/dlss.cpp        |  6 ++++++
 src/graphics/host_gpu/renderer/frameGen.cpp    |  2 ++
 src/graphics/presentation/videoOut.cpp         |  5 +++++
 src/hybrid/kytyGpuBridge.cpp                   | 18 ++++++++++++++++++
 5 files changed, 35 insertions(+)

diff --git a/src/graphics/host_gpu/renderer/cache/bufferCache.cpp b/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
index 13dabc7b..79c55fdd 100644
--- a/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
+++ b/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
@@ -38,7 +38,11 @@
 
 #include <algorithm>
 #include <bit>
+#if defined(_WIN32)
 #include <intrin.h>
+#else
+#include <x86intrin.h>
+#endif
 #include <array>
 #include <atomic>
 #include <chrono>
diff --git a/src/graphics/host_gpu/renderer/dlss.cpp b/src/graphics/host_gpu/renderer/dlss.cpp
index d43372e6..8e956181 100644
--- a/src/graphics/host_gpu/renderer/dlss.cpp
+++ b/src/graphics/host_gpu/renderer/dlss.cpp
@@ -14,6 +14,7 @@
 #include <nvsdk_ngx_vk.h>
 #endif
 
+#if defined(_WIN32)
 #ifndef NOMINMAX
 #define NOMINMAX
 #endif
@@ -21,6 +22,7 @@
 #define WIN32_LEAN_AND_MEAN
 #endif
 #include <windows.h>
+#endif
 
 #include <array>
 #include <atomic>
@@ -93,6 +95,9 @@ void RequiredExtensions(std::vector<const char*>& instance, std::vector<const ch
 // ASTROHYBRID_DLSS_PROBE=1 (diagnostic): a throwaway device with only VK_NVX_binary_import,
 // created through vulkan-1.dll directly; prints whether the driver accepts it at this point.
 void ProbeBinaryImport(const char* when) {
+#if !defined(_WIN32)
+	(void)when; // NGX/DLSS is Windows-only; the Linux build never creates an NGX device.
+#else
 	const char* value = std::getenv("ASTROHYBRID_DLSS_PROBE");
 	if (value == nullptr || std::strcmp(value, "1") != 0) {
 		return;
@@ -172,6 +177,7 @@ void ProbeBinaryImport(const char* when) {
 		destroy_device(device, nullptr);
 	}
 	destroy_instance(instance, nullptr);
+#endif
 }
 
 } // namespace Dlss
diff --git a/src/graphics/host_gpu/renderer/frameGen.cpp b/src/graphics/host_gpu/renderer/frameGen.cpp
index 80f8eab1..430b3d16 100644
--- a/src/graphics/host_gpu/renderer/frameGen.cpp
+++ b/src/graphics/host_gpu/renderer/frameGen.cpp
@@ -11,6 +11,7 @@
 #include <mutex>
 #include <string>
 
+#if defined(_WIN32)
 #ifndef NOMINMAX
 #define NOMINMAX
 #endif
@@ -18,6 +19,7 @@
 #define WIN32_LEAN_AND_MEAN
 #endif
 #include <windows.h>
+#endif
 
 #if KYTY_STREAMLINE
 #include <sl.h>
diff --git a/src/graphics/presentation/videoOut.cpp b/src/graphics/presentation/videoOut.cpp
index 3f17232a..3846c513 100644
--- a/src/graphics/presentation/videoOut.cpp
+++ b/src/graphics/presentation/videoOut.cpp
@@ -952,6 +952,7 @@ void UpdateGameStep(GameStep& step, uint64_t now, uint64_t frequency, uint32_t l
 	if (!step.ready) {
 		const char* custom = std::getenv("ASTROHYBRID_GAME_STEP_ADDR");
 		const auto  addr   = custom != nullptr ? std::strtoull(custom, nullptr, 0) : 0x93F0040ull;
+#if defined(_WIN32)
 		MEMORY_BASIC_INFORMATION info {};
 		if (VirtualQuery(reinterpret_cast<void*>(addr), &info, sizeof(info)) != sizeof(info) ||
 		    info.State != MEM_COMMIT || (info.Protect & (PAGE_READWRITE | PAGE_WRITECOPY)) == 0) {
@@ -959,6 +960,10 @@ void UpdateGameStep(GameStep& step, uint64_t now, uint64_t frequency, uint32_t l
 			std::printf("Game speed: no frame-rate block at 0x%llx, switch ignored\n", static_cast<unsigned long long>(addr));
 			return;
 		}
+#else
+		// Linux places the image at 0x400000 and maps it writable where the title writes; the
+		// frame-rate block is inside the image.  The value checks below still reject a wrong site.
+#endif
 		auto* fps = reinterpret_cast<double*>(addr);
 		auto* dt  = reinterpret_cast<float*>(addr + 8);
 		if (!(*fps >= 10.0 && *fps <= 240.0) || std::abs(*dt * *fps - 1.0) > 1e-3) {
diff --git a/src/hybrid/kytyGpuBridge.cpp b/src/hybrid/kytyGpuBridge.cpp
index f06f722c..7fabbdf4 100644
--- a/src/hybrid/kytyGpuBridge.cpp
+++ b/src/hybrid/kytyGpuBridge.cpp
@@ -926,6 +926,24 @@ extern "C" __attribute__((used)) void* KytyGpuLazyResolve(uint32_t index) {
 	return g_kyty_gpu_slots[index];
 }
 
+// A normal-name entry point for the host's libkernel: unlike the NID exports it does not put
+// the kernel memory NIDs into the ELF global scope (where they would shadow libkernel's own
+// symbols), and it binds the slot first if this is the first game call.
+extern "C" KYTY_GPU_EXPORT void* KytyGpuGetNid(const char* nid) {
+	if (nid == nullptr) {
+		return nullptr;
+	}
+	for (uint32_t i = 0; i < g_row_count; ++i) {
+		if (std::strcmp(g_rows[i].nid, nid) == 0) {
+			if (g_info[i].bound == 0) {
+				(void)KytyGpuLazyResolve(i);
+			}
+			return g_kyty_gpu_slots[i];
+		}
+	}
+	return nullptr;
+}
+
 extern "C" KYTY_GPU_EXPORT const KytyGpuApi* KytyGpuGetApi(uint32_t abi_version) {
 	return (abi_version >> 16u) == KYTY_GPU_ABI_VERSION_MAJOR ? &g_api : nullptr;
 }
