 core/libs/prx/libScePad/Export.cpp           |  7 ++++
 core/libs/prx/libScePad/include/PadState.hpp |  3 ++
 core/libs/prx/libScePad/src/PadState.cpp     | 43 ++++++++++++++++++++
 4 files changed, 92 insertions(+), 3 deletions(-)

