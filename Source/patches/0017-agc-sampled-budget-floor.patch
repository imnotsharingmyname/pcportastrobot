From cbe27ba6773346568d15d2fded2d337d6f8d771e Mon Sep 17 00:00:00 2001
From: faycal <faycalelhandi9@gmail.com>
Date: Fri, 30 Oct 2026 10:49:32 +0000
Subject: [PATCH] feat(agc): configurable floor for the sampled texture cache
 budget (APS5_SAMPLED_BUDGET_FLOOR_MIB)

The automatic budget subtracts every other device-local use and falls to
its 2 GiB floor on an 8 GB card. A level whose frame uses more textures
than that re-creates the uncached ones on every use. The switch raises
the floor without forcing the storage image budget as
APS5_TEXTURE_CACHE_MIB does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../prx/libSceAgcDriver/Graphics/src/ShaderResources.cpp   | 7 ++++++-
 docs/dev/ENVIRONMENT.md                                    | 1 +
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/core/libs/prx/libSceAgcDriver/Graphics/src/ShaderResources.cpp b/core/libs/prx/libSceAgcDriver/Graphics/src/ShaderResources.cpp
index c2fb9d73b..89a3fbd0b 100644
--- a/core/libs/prx/libSceAgcDriver/Graphics/src/ShaderResources.cpp
+++ b/core/libs/prx/libSceAgcDriver/Graphics/src/ShaderResources.cpp
@@ -1309,7 +1309,12 @@ std::uint64_t SampledTextureBudget(const VkPhysicalDeviceMemoryProperties& memor
     const auto budget = reported->heapBudget[*heap];
     const auto usage = reported->heapUsage[*heap];
     const auto reserved = usage - std::min<std::uint64_t>(usage, textureBytes) + std::max(TextureCacheBudget(memory), storageBytes) + budget / 8u;
-    return std::max<std::uint64_t>(2048ull << 20u, budget > reserved ? budget - reserved : 0u);
+    static const std::uint64_t floor = [] {
+        const char* text = std::getenv("APS5_SAMPLED_BUDGET_FLOOR_MIB");
+        const auto mib = text != nullptr ? std::strtoull(text, nullptr, 10) : 0ull;
+        return std::max<std::uint64_t>(2048ull, mib) << 20u;
+    }();
+    return std::max<std::uint64_t>(floor, budget > reserved ? budget - reserved : 0u);
 }
 
 bool SampledBudgetReportDue(std::uint64_t reported, std::uint64_t budget, std::chrono::steady_clock::duration sinceReport) {
diff --git a/docs/dev/ENVIRONMENT.md b/docs/dev/ENVIRONMENT.md
index 13536ff2a..b526bd265 100644
--- a/docs/dev/ENVIRONMENT.md
+++ b/docs/dev/ENVIRONMENT.md
@@ -403,6 +403,7 @@ The code reads environment names through `getenv`, `IsEnvironmentSet`, `kibSetti
 | `APS5_RESIDENT_TRAP` | presence | `core/libs/prx/libSceAgcDriver/Graphics/src/GuestBufferMemory.cpp` |  | Windows measurement aid: makes the pages a staged dispatch copied back inaccessible and counts the CPU accesses that fault on them (game code or other code, with the top fault sites) in `[resident-trap]` lines; each faulting page is restored at once |
 | `APS5_RESOURCE_CACHE_ENTRIES` | integer | `core/libs/prx/libSceAgcDriver/Graphics/src/ShaderResources.cpp` | adaptive | fixes the bound on the entries of the per-device shader-resource cache, which otherwise grows while evicted keys keep coming back and shrinks back to its base when few keys are in use; 0 keeps the adaptive bound |
 | `APS5_RESOURCE_CACHE_TABLE_ELEMENTS` | integer | `core/libs/prx/libSceAgcDriver/Graphics/src/ShaderResources.cpp` | 65536 | number of image-table elements the shader-resource cache keeps (0 keeps the default) |
+| `APS5_SAMPLED_BUDGET_FLOOR_MIB` | integer | `core/libs/prx/libSceAgcDriver/Graphics/src/ShaderResources.cpp` | 2048 | smallest automatic sampled texture cache budget in MiB (values below 2048 keep 2048); a frame using more textures than the budget re-creates the uncached ones on every use, so a level with a large texture set needs a higher floor |
 | `APS5_SAMPLE_COMMITTER` | string | `core/libs/prx/libSceAgcDriver/Execution/src/WorkerSampler.cpp` |  | samples queue 0's draw committer every millisecond and writes its stacks to a file (Windows only) |
 | `APS5_SAMPLE_THREADS` | string | `core/libs/prx/libSceAgcDriver/Execution/src/WorkerSampler.cpp` |  | samples every thread of the process every 2 ms and writes each busy thread's hottest frames to a file (Windows only) |
 | `APS5_SAMPLE_QUEUE` | integer | `core/libs/prx/libSceAgcDriver/Execution/src/Driver/Queues/QueueWorker.cpp` | 0 | hexadecimal id of the queue worker APS5_SAMPLE_WORKER samples |
