diff --git a/core/shader/recompiler/Recompiler.cpp b/core/shader/recompiler/Recompiler.cpp
index 41218bb44..142bb3598 100644
--- a/core/shader/recompiler/Recompiler.cpp
+++ b/core/shader/recompiler/Recompiler.cpp
@@ -1479,6 +1479,39 @@ bool MaskedResultMemo() {
     return masked;
 }
 
+bool RecycledResults() {
+    static const bool enabled = [] {
+        const char* text = std::getenv("APS5_RESULT_RECYCLE");
+        return text != nullptr && text[0] != 0 && text[0] != '0';
+    }();
+    return enabled;
+}
+
+struct RecycledResultStorage {};
+
+struct RecycledResultPool {
+    static constexpr std::size_t Slots = 256;
+    static constexpr std::size_t Probes = 8;
+    std::array<std::shared_ptr<RecompileResult>, Slots> slots;
+    std::size_t cursor = 0;
+};
+
+std::shared_ptr<RecompileResult> recycledCopy(const RecompileResult& donor) {
+    auto& pool = HostThreadLocal<RecycledResultPool, RecycledResultStorage>();
+    for (std::size_t probe = 0; probe < RecycledResultPool::Probes; ++probe) {
+        auto& slot = pool.slots[(pool.cursor + probe) % RecycledResultPool::Slots];
+        if (slot == nullptr || slot.use_count() != 1) continue;
+        std::atomic_thread_fence(std::memory_order_acquire);
+        *slot = donor;
+        pool.cursor = (pool.cursor + probe + 1) % RecycledResultPool::Slots;
+        return slot;
+    }
+    auto& slot = pool.slots[pool.cursor];
+    pool.cursor = (pool.cursor + 1) % RecycledResultPool::Slots;
+    slot = std::make_shared<RecompileResult>(donor);
+    return slot;
+}
+
 bool VerifyMaskedResultMemo() {
     static const bool verify = std::getenv("APS5_VERIFY_MASKED_RESULT_MEMO") != nullptr;
     return verify;
@@ -1828,7 +1861,7 @@ std::shared_ptr<const RecompileResult> materializePreparedMemoized(SourceEntry&
     std::shared_ptr<RecompileResult> result;
     std::shared_ptr<MemoPatch> patch;
     if (donor != nullptr) {
-        result = std::make_shared<RecompileResult>(*donor);
+        result = RecycledResults() ? recycledCopy(*donor) : std::make_shared<RecompileResult>(*donor);
         applyMemoPatch(*result, *donorPatch, snapshot);
         if (VerifyMaskedResultMemo()) verifyPatchedResult(*result, materializeResult(*variant, request, snapshot), variantId);
         if (profile) counters.patchNanoseconds.fetch_add(static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - started).count()), std::memory_order_relaxed);
