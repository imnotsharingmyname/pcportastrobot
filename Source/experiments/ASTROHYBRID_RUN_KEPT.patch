+// ASTROHYBRID_RUN_KEPT=<1..256> (startup, default 32, the original size): the number of kept draw-run
+// records KYTY_DRAW_RUN_RECALL searches. Only the store's size changes; a recall's certificate is
+// the same.
+uint32_t RenderExecutor::DrawRunKeptCount() {
+	static const uint32_t count = [] {
+		const char* value  = std::getenv("ASTROHYBRID_RUN_KEPT");
+		const auto  parsed = value != nullptr ? std::strtoul(value, nullptr, 10) : 0ul;
+		return parsed >= 1 && parsed <= 256 ? static_cast<uint32_t>(parsed) : 32u;
+	}();
+	return count;
+}
