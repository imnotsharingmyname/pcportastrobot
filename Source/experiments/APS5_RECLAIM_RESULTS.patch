+bool ReclaimResultsOffThread() {
+    static const bool reclaim = [] {
+        const char* text = std::getenv("APS5_RECLAIM_RESULTS");
+        return text != nullptr && text[0] != 0 && text[0] != '0';
+    }();
+    return reclaim;
+}
+
+struct ResultReclaimer {
+    std::mutex mutex;
+    std::condition_variable wake;
+    std::vector<std::shared_ptr<const RecompileResult>> pending;
+
+    ResultReclaimer() {
+        std::thread([this] {
+            std::vector<std::shared_ptr<const RecompileResult>> batch;
+            for (;;) {
+                {
+                    std::unique_lock lock(mutex);
+                    wake.wait(lock, [&] { return !pending.empty(); });
+                    std::swap(batch, pending);
+                }
+                batch.clear();
+            }
+        }).detach();
+    }
+
+    void Take(std::vector<std::shared_ptr<const RecompileResult>>& results) {
+        bool notify = false;
+        {
+            std::lock_guard lock(mutex);
+            const bool wasEmpty = pending.empty();
+            for (auto& result : results) pending.push_back(std::move(result));
+            notify = wasEmpty;
+        }
+        results.clear();
+        if (notify) wake.notify_one();
+    }
+};
+
+void ReclaimResults(std::vector<std::shared_ptr<const RecompileResult>>& results) {
+    static auto* reclaimer = new ResultReclaimer();
+    reclaimer->Take(results);
+}
