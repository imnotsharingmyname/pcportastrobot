@@ -234,6 +234,18 @@ extern Live::Switch g_pipeswap;      // KYTY_DRAW_RUN_PIPESWAP
 	return Detail::g_pipeswap.On();
 }
 
+// ASTROHYBRID_RUN_RECALL_SWAP=1 (default 0; needs KYTY_DRAW_RUN_RECALL and KYTY_DRAW_RUN_PIPESWAP):
+// a draw that matches no kept record by its structure key may recall a kept record whose swap key
+// (the key without the vertex program) equals its own, i.e. a recall and a pipeline swap at once.
+// At the Sky Garden ~186 draws a frame differ from the previous draw in the vertex program and the
+// pixel T# words, which neither path takes alone. Conditions: every condition of a recall but the
+// vertex program, which must be run-eligible without writes, declare no images or samplers (as
+// must the record's, so there is no vertex-stage binding to take back) and export a viewport
+// index exactly when the record's does. The draw then behaves as a recall (whole push, dynamic
+// state recorded again, its own planned pipeline) and the record takes the new vertex program and
+// pipeline layout as after a swap.
+[[nodiscard]] bool RecallSwapEnabled();
+
 // Command-processor work other than committed draws (GPU thread). Relaxed: written and read by the
 // GPU thread; other threads only bump it.
 // KYTY_DRAW_RUN_QUIET_OPS (default on): two kinds of command-processor work between draws do not
@@ -310,6 +322,8 @@ struct Totals {
 	std::atomic<uint64_t> swap_matches {0};        // KYTY_DRAW_RUN_PIPESWAP: the swap key matched
 	std::atomic<uint64_t> swapped {0};             // continued with a pipeline swap (verify: would have)
 	std::atomic<uint64_t> swap_incompatible {0};   // vertex programs' bindings or outputs differ
+	std::atomic<uint64_t> recall_swap_matches {0}; // ASTROHYBRID_RUN_RECALL_SWAP: a kept record's swap key matched
+	std::atomic<uint64_t> recall_swapped {0};      // recalled with a pipeline swap (verify: would have)
 	std::atomic<uint64_t> verify_checks {0};
 	std::atomic<uint64_t> verify_mismatches {0};
 	std::atomic<uint64_t> misses[static_cast<uint32_t>(Miss::Count)] {};
