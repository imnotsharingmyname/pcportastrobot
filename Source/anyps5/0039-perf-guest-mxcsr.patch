+        adoptedThread = std::make_unique<PthreadPrivate>();
+        asm volatile("stmxcsr %0" : "=m"(adoptedThread->hostMxcsr));
         adoptedThread->_detached = true;
         adoptedThread->_adopted = true;
         BindHostCpuClock(adoptedThread.get());
