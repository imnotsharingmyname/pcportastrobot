+Pthread APS5_VABI scePthreadSelf() {
+#ifdef _WIN32
+    if (!CurrentGuestState().current) {
+        auto adopted = std::make_unique<PthreadPrivate>();
+        asm volatile("stmxcsr %0" : "=m"(adopted->hostMxcsr));
