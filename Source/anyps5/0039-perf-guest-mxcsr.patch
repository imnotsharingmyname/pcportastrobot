-int APS5_VABI scePthreadDetach(Pthread thread) {
-    if (!thread) return SCE_KERNEL_ERROR_EINVAL;
-    {
-        std::lock_guard lock(thread->_join_mtx);
-        if (thread->_joined.load(std::memory_order_acquire)) return SCE_KERNEL_ERROR_ESRCH;
