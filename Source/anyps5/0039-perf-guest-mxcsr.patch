From 36bb2af5afa95fc66964dfc05074144defae078d Mon Sep 17 00:00:00 2001
From: AnyPS5 contributors <noreply@localhost>
Subject: [PATCH] Match PS5 guest floating-point environment

Adapt upstream 36bb2af5afa95fc66964dfc05074144defae078d and 96d942d26404b8d1edaf9210eacc7028b1334c21 to the older thread lifecycle and direct Linux entry stub. Preserve host MXCSR, set FTZ/DAZ for guest main and worker threads. Include entry stub and worker tests.

diff --git a/core/libs/prx/libkernel/Pthread/include/Pthread.hpp b/core/libs/prx/libkernel/Pthread/include/Pthread.hpp
--- a/core/libs/prx/libkernel/Pthread/include/Pthread.hpp
+++ b/core/libs/prx/libkernel/Pthread/include/Pthread.hpp
@@ -171,6 +171,7 @@
     std::mutex cancelLock;
     TimedWait::Condition* cancelWait = nullptr;
     bool cancelWaitExiting = false;
+    std::uint32_t hostMxcsr = 0x1f80;
 
     explicit PthreadPrivate(const PthreadAttrPrivate* attr = nullptr);
     ~PthreadPrivate();
diff --git a/core/libs/prx/libkernel/Pthread/src/Thread.cpp b/core/libs/prx/libkernel/Pthread/src/Thread.cpp
--- a/core/libs/prx/libkernel/Pthread/src/Thread.cpp
+++ b/core/libs/prx/libkernel/Pthread/src/Thread.cpp
@@ -775,417 +775,433 @@
     push $0
     .cfi_adjust_cfa_offset 8
     mov %rsp, %rbp
-    mov %rdi, %rax
-    mov %rsi, %rdi
-    call *%rax
-    add $16, %rsp
-    .cfi_adjust_cfa_offset -16
-    pop %rbp
-    .cfi_adjust_cfa_offset -8
-    .cfi_restore %rbp
-    ret
-    .cfi_endproc
-)" APS5_ASM_FUNCTION_END("Aps5CallGuestEntry_nid_no_patch"));
-
-static void RunThread(std::unique_ptr<ThreadArgs> args) {
-    APS5_LOG_OUT("RunThread entry=0x%llx arg=%p self=%p", static_cast<unsigned long long>(reinterpret_cast<std::uintptr_t>(args->entry)), args->arg, static_cast<void*>(args->self));
-    const auto entry = args->entry;
-    void* arg = args->arg;
-    PthreadPrivate* self = args->self;
-    BindHostCpuClock(self);
-    TimedWait::BindThreadWaitState(&self->waitCount);
-    CurrentGuestState().current = self;
-    RegisterStack(self);
-#ifndef _WIN32
-    const sigset_t signalMask = args->signalMask;
-#endif
-    args.reset();
-    self->suspended.wait(true, std::memory_order_acquire);
-#ifndef _WIN32
-    pthread_sigmask(SIG_SETMASK, &signalMask, nullptr);
-#endif
-    finishThread(self, Aps5CallGuestEntry_nid_no_patch(entry, arg));
-    CurrentGuestState().current = nullptr;
-}
-
-static void ReleaseThread(PthreadPrivate* thread) {
-    if (thread->_adopted)
-        return;
-    if (thread->references.fetch_sub(1, std::memory_order_acq_rel) != 1)
-        return;
-#ifdef _WIN32
-    if (thread->wakeEvent)
-        CloseHandle(static_cast<HANDLE>(thread->wakeEvent));
-    if (!CloseHandle(thread->nativeHandle))
-        throw std::system_error(GetLastError(), std::system_category(), "Closing guest thread handle");
-#endif
-    delete thread;
-}
-
-static std::mutex joinedLock;
-static std::map<Pthread*, PthreadPrivate*> joinedThreads;
-
-static void RetainJoinedThread(PthreadPrivate* thread) {
-    std::lock_guard lock(joinedLock);
-    Pthread* const storage = thread->_handleStorage;
-    const auto found = joinedThreads.find(storage);
-    if (found != joinedThreads.end() && found->second != thread) ReleaseThread(found->second);
-    joinedThreads[storage] = thread;
-}
-
-static void RecycleJoinedThread(Pthread* storage) {
-    std::lock_guard lock(joinedLock);
-    const auto found = joinedThreads.find(storage);
-    if (found == joinedThreads.end()) return;
-    PthreadPrivate* joined = found->second;
-    joinedThreads.erase(found);
-    ReleaseThread(joined);
-}
