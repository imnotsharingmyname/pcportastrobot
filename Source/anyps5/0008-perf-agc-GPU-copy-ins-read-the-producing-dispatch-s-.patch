From af0d13df2a6f7842ad6b630d361cd4534899c145 Mon Sep 17 00:00:00 2001
From: faycal <faycalelhandi9@gmail.com>
Date: Thu, 29 Oct 2026 20:41:42 +0000
Subject: [PATCH 08/26] perf(agc): GPU copy-ins read the producing dispatch's
 video-memory shadow

APS5_COPY_IN_FROM_SHADOWS=1: recordGpuCopies looks the region up in the GPU-produced range registry
and, when a dispatch's device-local shadow holds the range and the CPU has not written it since,
copies from that shadow (video memory to video memory) instead of from the host import over PCIe;
when the shadow is the region's own buffer the copy is skipped. [copy-in-shadows] counts both.

Astro Bot world map: ~3400 copy-ins per 10 s served from video memory, GPU busy 64.5-65.7 -> 62-63 ms
per frame at the same 113-114 presents per 10 s (the frame is CPU-bound); screenshot correct.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../Graphics/include/GuestBufferMemory.hpp    |  1 +
 .../Graphics/src/GuestBufferMemory.cpp        | 39 +++++++++++++++++--
 docs/dev/ENVIRONMENT.md                       |  1 +
 3 files changed, 38 insertions(+), 3 deletions(-)

diff --git a/core/libs/prx/libSceAgcDriver/Graphics/include/GuestBufferMemory.hpp b/core/libs/prx/libSceAgcDriver/Graphics/include/GuestBufferMemory.hpp
index 3ff0272dc8..c67402a17c 100644
--- a/core/libs/prx/libSceAgcDriver/Graphics/include/GuestBufferMemory.hpp
+++ b/core/libs/prx/libSceAgcDriver/Graphics/include/GuestBufferMemory.hpp
@@ -298,6 +298,7 @@ private:
 void NoteGpuProduced(std::uint64_t begin, std::uint64_t end, std::uint64_t generation, std::shared_ptr<Buffer> shadow = nullptr, std::uint64_t shadowBase = 0);
 std::shared_ptr<Buffer> GpuProducedShadow(std::uint64_t address, std::size_t bytes, VkDeviceSize alignment, VkDeviceSize* offset);
 bool ReadGpuProducedShadows();
+bool CopyInFromShadows();
 bool GpuProducedUnchanged(std::uint64_t address, std::size_t bytes);
 bool SkipGpuProducedSnapshots();
 
diff --git a/core/libs/prx/libSceAgcDriver/Graphics/src/GuestBufferMemory.cpp b/core/libs/prx/libSceAgcDriver/Graphics/src/GuestBufferMemory.cpp
index 4d291bc83e..4be4adb24b 100644
--- a/core/libs/prx/libSceAgcDriver/Graphics/src/GuestBufferMemory.cpp
+++ b/core/libs/prx/libSceAgcDriver/Graphics/src/GuestBufferMemory.cpp
@@ -5095,6 +5095,8 @@ struct CopyStats {
     std::atomic<std::uint64_t> gpuCopies{0};
     std::atomic<std::uint64_t> gpuCopyBytes{0};
     std::atomic<std::uint64_t> gpuCopyBacks{0};
+    std::atomic<std::uint64_t> shadowCopyIns{0};
+    std::atomic<std::uint64_t> shadowCopyInsSkipped{0};
     std::atomic<std::uint64_t> gpuCopyBackBytes{0};
     // Written gpuCopy regions of a use that recorded no copy-back (a synchronous draw): stored
     // from the staging buffer by the CPU in WriteBack.
@@ -5799,7 +5801,24 @@ void GuestBufferMemory::recordGpuCopies(std::span<Region* const> copies, bool ad
         std::shared_ptr<Buffer> inputSnapshot;
         auto copySource = region->copySource;
         auto copyOffset = region->begin - region->copySourceBase;
-        if (!pendingWriter && !writable) {
+        std::shared_ptr<Buffer> producer;
+        VkDeviceSize producerOffset = 0;
+        if (CopyInFromShadows()) producer = GpuProducedShadow(address, static_cast<std::size_t>(bytes), 0, &producerOffset);
+        if (producer != nullptr && producer == region->buffer) {
+            if (producerOffset == 0) {
+                Copies().shadowCopyInsSkipped.fetch_add(1, std::memory_order_relaxed);
+                recorder->Keep(region->buffer);
+                region->snapshot.clear();
+                continue;
+            }
+            producer.reset();
+        }
+        if (producer != nullptr) {
+            copySource = producer->Handle();
+            copyOffset = producerOffset;
+            recorder->Keep(producer);
+            Copies().shadowCopyIns.fetch_add(1, std::memory_order_relaxed);
+        } else if (!pendingWriter && !writable) {
             inputSnapshot = std::make_shared<Buffer>(context, static_cast<std::size_t>(bytes), VK_BUFFER_USAGE_TRANSFER_SRC_BIT);
             std::memcpy(inputSnapshot->Bytes().data(), reinterpret_cast<const void*>(address), static_cast<std::size_t>(bytes));
             copySource = inputSnapshot->Handle();
@@ -5851,6 +5870,12 @@ void GuestBufferMemory::recordGpuCopies(std::span<Region* const> copies, bool ad
         }
     }
     if (stagedAny) reportStaging();
+    if (profile && CopyInFromShadows()) {
+        static std::atomic<std::int64_t> lastReport{0};
+        const auto now = std::chrono::duration_cast<std::chrono::seconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+        auto previous = lastReport.load(std::memory_order_relaxed);
+        if (now - previous >= 10 && lastReport.compare_exchange_strong(previous, now)) std::fprintf(stderr, "[copy-in-shadows] cumulative: %llu copy-ins from a producer's video-memory shadow, %llu skipped (shadow already in place)\n", static_cast<unsigned long long>(Copies().shadowCopyIns.load()), static_cast<unsigned long long>(Copies().shadowCopyInsSkipped.load()));
+    }
     // The copied bytes are visible to the shaders bound to the buffers, which may also store into
     // them. Every stage: dispatches and draws share this path, and draws run mesh, task and
     // tessellation shaders too (the batch's own barriers around dispatches are as wide).
@@ -6257,8 +6282,16 @@ bool ReadGpuProducedShadows() {
     return enabled;
 }
 
+bool CopyInFromShadows() {
+    static const bool enabled = [] {
+        const char* text = std::getenv("APS5_COPY_IN_FROM_SHADOWS");
+        return text != nullptr && text[0] != '0' && text[0] != 0;
+    }();
+    return enabled;
+}
+
 void NoteGpuProduced(std::uint64_t begin, std::uint64_t end, std::uint64_t generation, std::shared_ptr<Buffer> shadow, std::uint64_t shadowBase) {
-    if ((!SkipGpuProducedSnapshots() && !ReadGpuProducedShadows()) || begin >= end || generation == 0) return;
+    if ((!SkipGpuProducedSnapshots() && !ReadGpuProducedShadows() && !CopyInFromShadows()) || begin >= end || generation == 0) return;
     auto& state = gpuProduced();
     std::lock_guard lock(state.mutex);
     if (state.ranges.size() >= 65536) state.ranges.clear();
@@ -6292,7 +6325,7 @@ bool GpuProducedUnchanged(std::uint64_t address, std::size_t bytes) {
 }
 
 std::shared_ptr<Buffer> GpuProducedShadow(std::uint64_t address, std::size_t bytes, VkDeviceSize alignment, VkDeviceSize* offset) {
-    if (!ReadGpuProducedShadows() || bytes == 0) return nullptr;
+    if ((!ReadGpuProducedShadows() && !CopyInFromShadows()) || bytes == 0) return nullptr;
     const auto entry = gpuProducedCovering(address, bytes);
     if (!entry.has_value() || entry->shadow == nullptr || address < entry->shadowBase) return nullptr;
     const auto at = static_cast<VkDeviceSize>(address - entry->shadowBase);
diff --git a/docs/dev/ENVIRONMENT.md b/docs/dev/ENVIRONMENT.md
index 5d5f3d7aa7..0cb64b041d 100644
--- a/docs/dev/ENVIRONMENT.md
+++ b/docs/dev/ENVIRONMENT.md
@@ -114,6 +114,7 @@ The code reads environment names through `getenv`, `IsEnvironmentSet`, `kibSetti
 | `APS5_COPY_DESTINATION_STRICT` | presence | `core/libs/prx/libSceAgcDriver/Execution/src/VulkanDevice.cpp` |  | refuses a CPU copy whose destination has any pending writer, not only an unsettled one |
 | `APS5_COPY_HLE_CPU_MAX` | integer | `core/libs/prx/libSceAgcDriver/Execution/src/Driver/Memory/BufferCopy.cpp` | 262144 | largest copy in bytes the CPU side of the copy HLE handles |
 | `APS5_COPY_HLE_GPU_MAX` | integer | `core/libs/prx/libSceAgcDriver/Execution/src/Driver/Memory/BufferCopy.cpp` |  | largest copy in bytes the GPU side of the copy HLE handles; unset means no limit |
+| `APS5_COPY_IN_FROM_SHADOWS` | presence | `core/libs/prx/libSceAgcDriver/Graphics/src/GuestBufferMemory.cpp` |  | a GPU copy-in of a buffer region reads the device-local staging shadow of the dispatch that last wrote the range (while the CPU has not written it since) instead of the host import, and is skipped when that shadow is the destination itself; an empty value or one starting with `0` leaves it off |
 | `APS5_COPY_READ_TRACKING` | string | `core/libs/prx/libSceAgcDriver/Graphics/src/Recorder.cpp` |  | notes in-place reads of a range; set to 0 to disable, making the CPU copy path require an idle recorder |
 | `APS5_COPY_SYNC` | presence | `core/libs/prx/libSceAgcDriver/Execution/src/VulkanDevice.cpp` |  | treats any pending writer over a copy's range as needing a wait |
 | `APS5_COPY_VERIFY` | presence | `core/libs/prx/libSceAgcDriver/Execution/src/VulkanDevice.cpp` |  | verifies a CPU copy's source and destination bytes against the pre-copy values after a sync |
