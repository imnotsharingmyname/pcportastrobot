From db65974db065a8652f763770f26cd4c3fabd6f93 Mon Sep 17 00:00:00 2001
From: AstroHybrid <noreply@localhost>
Date: Thu, 26 Nov 2026 11:42:59 +0000
Subject: [PATCH] Avoid integer division for power-of-two stream buffer
 alignment

---
 src/graphics/host_gpu/renderer/cache/streamBuffer.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/graphics/host_gpu/renderer/cache/streamBuffer.cpp b/src/graphics/host_gpu/renderer/cache/streamBuffer.cpp
index ee300cdd..5955a30b 100644
--- a/src/graphics/host_gpu/renderer/cache/streamBuffer.cpp
+++ b/src/graphics/host_gpu/renderer/cache/streamBuffer.cpp
@@ -54,6 +54,17 @@ constexpr size_t WATCHES_RESERVE_CHUNK   = 0x1000;
 		result = value;
 		return true;
 	}
+	// Vulkan buffer and atom alignments are commonly powers of two.
+	// Avoid a variable integer divide for those stream-ring reservations.
+	const auto mask = alignment - 1;
+	if ((alignment & mask) == 0) {
+		const auto padding = (uint64_t {0} - value) & mask;
+		if (padding > UINT64_MAX - value) {
+			return false;
+		}
+		result = value + padding;
+		return true;
+	}
 	const auto aligned = Common::AlignUp(value, alignment);
 	if (aligned < value) {
 		return false;
-- 
