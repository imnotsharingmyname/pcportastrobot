From: AstroHybrid contributors <noreply@localhost>
Subject: [PATCH] Backport Kyty descriptor allocation recovery

Adapt upstream 7eded28c58a195f5bbeb8b5133c4a39a67152511 to retain AstroHybrid's last-batch cache.

diff --git a/src/graphics/host_gpu/renderer/pipeline/descriptorHeap.cpp b/src/graphics/host_gpu/renderer/pipeline/descriptorHeap.cpp
--- a/src/graphics/host_gpu/renderer/pipeline/descriptorHeap.cpp
+++ b/src/graphics/host_gpu/renderer/pipeline/descriptorHeap.cpp
@@ -63,7 +63,33 @@ vk::DescriptorSet DescriptorHeap::Commit(vk::DescriptorSetLayout layout) {
 	if (batch.size != 0) {
 		return batch.sets[--batch.size];
 	}
-	if (Allocate(layout, batch)) {
+
+	std::array<vk::DescriptorSetLayout, DescriptorSetBatch> layouts;
+	layouts.fill(layout);
+	vk::DescriptorSetAllocateInfo allocate {};
+	allocate.descriptorPool     = m_current_pool;
+	allocate.descriptorSetCount = DescriptorSetBatch;
+	allocate.pSetLayouts        = layouts.data();
+	const auto result = m_graphics.device.allocateDescriptorSets(&allocate, batch.sets.data());
+	if (result == vk::Result::eSuccess) {
+		batch.size = DescriptorSetBatch;
+		return batch.sets[--batch.size];
+	}
+	EXIT_IF(result != vk::Result::eErrorOutOfPoolMemory &&
+	        result != vk::Result::eErrorFragmentedPool);
+
+	// A failed multi-set allocation can leave a pool unable to allocate even one set until it is
+	// reset, so the rest of this pool and a fresh one are filled one set per call.
+	const auto fill = [&](Batch& target) {
+		while (target.size < DescriptorSetBatch &&
+		       m_graphics.device.allocateDescriptorSets(&allocate, &target.sets[target.size]) ==
+		           vk::Result::eSuccess) {
+			target.size++;
+		}
+		return target.size != 0;
+	};
+	allocate.descriptorSetCount = 1;
+	if (fill(batch)) {
 		return batch.sets[--batch.size];
 	}
 
@@ -81,37 +107,14 @@ vk::DescriptorSet DescriptorHeap::Commit(vk::DescriptorSetLayout layout) {
 	}
 
 	m_last_batch = nullptr;
 	m_last_layout = nullptr;
 	m_sets.clear();
-	auto& fresh_batch = m_sets[layout];
-	m_last_batch = &fresh_batch;
-	m_last_layout = layout;
-	EXIT_IF(!Allocate(layout, fresh_batch));
-	return fresh_batch.sets[--fresh_batch.size];
-}
-
-bool DescriptorHeap::Allocate(vk::DescriptorSetLayout layout, Batch& batch) {
-	std::array<vk::DescriptorSetLayout, DescriptorSetBatch> layouts;
-	layouts.fill(layout);
-
-	vk::DescriptorSetAllocateInfo allocate {};
+	auto& fresh_batch       = m_sets[layout];
+	m_last_batch = &fresh_batch;
+	m_last_layout = layout;
 	allocate.descriptorPool = m_current_pool;
-	allocate.pSetLayouts    = layouts.data();
-
-	for (;;) {
-		allocate.descriptorSetCount = batch.allocation;
-		const auto result = m_graphics.device.allocateDescriptorSets(&allocate, batch.sets.data());
-		if (result == vk::Result::eSuccess) {
-			batch.size = batch.allocation;
-			return true;
-		}
-		EXIT_IF(result != vk::Result::eErrorOutOfPoolMemory &&
-		        result != vk::Result::eErrorFragmentedPool);
-		if (batch.allocation == 1) {
-			return false;
-		}
-		batch.allocation /= 2;
-	}
+	EXIT_IF(!fill(fresh_batch));
+	return fresh_batch.sets[--fresh_batch.size];
 }
 
 void DescriptorHeap::CreateDescriptorPool() {
diff --git a/src/graphics/host_gpu/renderer/pipeline/descriptorHeap.h b/src/graphics/host_gpu/renderer/pipeline/descriptorHeap.h
--- a/src/graphics/host_gpu/renderer/pipeline/descriptorHeap.h
+++ b/src/graphics/host_gpu/renderer/pipeline/descriptorHeap.h
@@ -26,12 +26,10 @@ class DescriptorHeap {
 
 	struct Batch {
 		std::array<vk::DescriptorSet, DescriptorSetBatch> sets {};
-		uint32_t                                          size       = 0;
-		uint32_t                                          allocation = DescriptorSetBatch;
+		uint32_t                                          size = 0;
 	};
 
-	[[nodiscard]] bool Allocate(vk::DescriptorSetLayout layout, Batch& batch);
-	void               CreateDescriptorPool();
+	void CreateDescriptorPool();
 
 	GraphicContext&                                     m_graphics;
 	MasterSemaphore&                                    m_master_semaphore;
