From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AstroHybrid <noreply@localhost>
Subject: [PATCH] Avoid repeated descriptor heap map lookups for the same layout

---
diff --git a/src/graphics/host_gpu/renderer/pipeline/descriptorHeap.h b/src/graphics/host_gpu/renderer/pipeline/descriptorHeap.h
--- a/src/graphics/host_gpu/renderer/pipeline/descriptorHeap.h
+++ b/src/graphics/host_gpu/renderer/pipeline/descriptorHeap.h
@@ -37,7 +37,10 @@
 	MasterSemaphore&                                    m_master_semaphore;
 	vk::DescriptorPool                                  m_current_pool = nullptr;
 	std::deque<std::pair<vk::DescriptorPool, uint64_t>> m_pending_pools;
-	std::unordered_map<vk::DescriptorSetLayout, Batch>  m_sets;
+	std::unordered_map<vk::DescriptorSetLayout, Batch>  m_sets;
+	// Node references survive unordered_map rehash; invalidate before clear.
+	vk::DescriptorSetLayout m_last_layout = nullptr;
+	Batch* m_last_batch = nullptr;
 };
 
 } // namespace Libs::Graphics
diff --git a/src/graphics/host_gpu/renderer/pipeline/descriptorHeap.cpp b/src/graphics/host_gpu/renderer/pipeline/descriptorHeap.cpp
--- a/src/graphics/host_gpu/renderer/pipeline/descriptorHeap.cpp
+++ b/src/graphics/host_gpu/renderer/pipeline/descriptorHeap.cpp
@@ -56,8 +56,12 @@
 	KYTY_PROFILER_FUNCTION();
 	EXIT_IF(layout == nullptr);
 
-	auto& batch = m_sets[layout];
-	if (batch.size != 0) {
+	if (m_last_layout != layout || m_last_batch == nullptr) {
+		m_last_batch = &m_sets[layout];
+		m_last_layout = layout;
+	}
+	auto& batch = *m_last_batch;
+	if (batch.size != 0) {
 		return batch.sets[--batch.size];
 	}
 	if (Allocate(layout, batch)) {
@@ -73,8 +77,12 @@
 		CreateDescriptorPool();
 	}
 
-	m_sets.clear();
-	auto& fresh_batch = m_sets[layout];
+	m_last_batch = nullptr;
+	m_last_layout = nullptr;
+	m_sets.clear();
+	auto& fresh_batch = m_sets[layout];
+	m_last_batch = &fresh_batch;
+	m_last_layout = layout;
 	EXIT_IF(!Allocate(layout, fresh_batch));
 	return fresh_batch.sets[--fresh_batch.size];
 }
-- 
