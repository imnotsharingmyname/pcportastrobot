From eeba7ce8a117df28270bdd44877643fe12a456f1 Mon Sep 17 00:00:00 2001
From: Local Build <local@invalid>
Date: Tue, 24 Nov 2026 15:29:30 +0000
Subject: [PATCH] feat(physics): add F6 live 60Hz fixed physics step toggle for
 sub-60 FPS physics bugs (#142, #177, #201)

---
 src/graphics/presentation/videoOut.cpp      | 16 ++++++++++++++++
 src/graphics/presentation/videoOut.h        |  1 +
 src/graphics/presentation/window/window.cpp |  7 +++++++
 3 files changed, 24 insertions(+)

diff --git a/src/graphics/presentation/videoOut.cpp b/src/graphics/presentation/videoOut.cpp
index 3f17232a..e81c9da6 100644
--- a/src/graphics/presentation/videoOut.cpp
+++ b/src/graphics/presentation/videoOut.cpp
@@ -934,6 +934,8 @@ struct GameStep {
 	uint64_t  last  = 0;
 };
 
+std::atomic<bool> g_fixed_physics_step {false};
+
 // ASTROHYBRID_GAME_SPEED=1 (default off): Astro Bot advances a fixed 1/FrameRate per frame from one
 // global (eboot 0x8ff0040: f64 frame rate, f32 1/rate, u64 microseconds per frame; image +0x400000),
 // so below 60 FPS the game runs in slow motion (30 FPS = half speed). With the switch on, every
@@ -985,6 +987,14 @@ void UpdateGameStep(GameStep& step, uint64_t now, uint64_t frequency, uint32_t l
 	if (step.ema == 0.0) {
 		return;
 	}
+	if (g_fixed_physics_step.load(std::memory_order_relaxed)) {
+		if (std::abs(*step.fps - 60.0) >= 0.01) {
+			*step.fps = 60.0;
+			*step.dt  = 1.0f / 60.0f;
+			*step.us  = 16666u;
+		}
+		return;
+	}
 	double rate = step.ema;
 	if (limit != 0 && std::abs(rate - limit) <= limit * 0.06) {
 		rate = limit;
@@ -1018,6 +1028,12 @@ bool CycleFrameLimit() {
 	return true;
 }
 
+bool ToggleFixedPhysicsStep() {
+	const bool next = !g_fixed_physics_step.load(std::memory_order_relaxed);
+	g_fixed_physics_step.store(next, std::memory_order_relaxed);
+	return next;
+}
+
 void VideoOutDriver::Impl::PresentThread(std::stop_token token) {
 	// A 120 Hz timer loop that blocks between vblanks; it presents and fires the flip events the
 	// guest waits for. Its only spin is the last <= 50 us of a vblank wait (SleepMicro).
diff --git a/src/graphics/presentation/videoOut.h b/src/graphics/presentation/videoOut.h
index c4ce13e7..64a611f2 100644
--- a/src/graphics/presentation/videoOut.h
+++ b/src/graphics/presentation/videoOut.h
@@ -54,6 +54,7 @@ void                          VideoOutShutdown();
 
 [[nodiscard]] const char* FrameLimitLabel();
 bool CycleFrameLimit();
+bool ToggleFixedPhysicsStep();
 
 KYTY_SYSV_ABI int  VideoOutOpen(int user_id, int bus_type, int index, const void* param);
 KYTY_SYSV_ABI int  VideoOutClose(int handle);
diff --git a/src/graphics/presentation/window/window.cpp b/src/graphics/presentation/window/window.cpp
index a46a3762..52631708 100644
--- a/src/graphics/presentation/window/window.cpp
+++ b/src/graphics/presentation/window/window.cpp
@@ -517,6 +517,13 @@ void WindowContext::ProcessEvent(double time_s) {
 	if (event->type == SDL_EVENT_KEY_DOWN || event->type == SDL_EVENT_KEY_UP) {
 		const bool pressed = event->type == SDL_EVENT_KEY_DOWN && event->key.repeat == 0;
 		switch (event->key.key) {
+			case SDLK_F6:
+				if (pressed) {
+					const bool on = VideoOut::ToggleFixedPhysicsStep();
+					Log::WriteToConsoleAndLog(on ? "Game speed: 60Hz fixed physics step ON (F6 to restore real-time)\n"
+					                             : "Game speed: real-time step restored\n");
+				}
+				return;
 			case SDLK_F7:
 				if (pressed) {
 					HostInputToggleMouseToJoystick();
