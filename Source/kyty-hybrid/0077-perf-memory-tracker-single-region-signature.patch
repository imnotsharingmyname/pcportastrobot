From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AstroHybrid <noreply@localhost>
Subject: [PATCH] perf(memory tracker): streamline single-region signature queries

---
diff --git a/src/graphics/host_gpu/memoryTracker.h b/src/graphics/host_gpu/memoryTracker.h
--- a/src/graphics/host_gpu/memoryTracker.h
+++ b/src/graphics/host_gpu/memoryTracker.h
@@ -378,16 +378,27 @@
 		if (size == 0 || vaddr >= TRACKER_ADDRESS_SIZE || size > TRACKER_ADDRESS_SIZE - vaddr) {
 			return 0;
 		}
-		uint64_t   sum  = 0;
-		const auto last = (vaddr + size - 1) / TRACKER_REGION_SIZE;
-		for (auto index = vaddr / TRACKER_REGION_SIZE; index <= last; index++) {
-			const auto* manager = m_regions[index].load(std::memory_order_acquire);
-			if (manager == nullptr) {
-				return 0;
-			}
-			sum += value(*manager);
-		}
-		return sum;
+		const auto first = vaddr / TRACKER_REGION_SIZE;
+		const auto last  = (vaddr + size - 1) / TRACKER_REGION_SIZE;
+		const auto* manager = m_regions[first].load(std::memory_order_acquire);
+		if (manager == nullptr) {
+			return 0;
+		}
+		// Most small buffer bindings cover just one region. Avoid the loop's
+		// initial sum and backedge on this path. Keep exactly the same acquire
+		// reads and range order; a missing region still invalidates the sum.
+		uint64_t sum = value(*manager);
+		if (first == last) {
+			return sum;
+		}
+		for (auto index = first + 1; index <= last; index++) {
+			const auto* next = m_regions[index].load(std::memory_order_acquire);
+			if (next == nullptr) {
+				return 0;
+			}
+			sum += value(*next);
+		}
+		return sum;
 	}
 	inline static thread_local const MemoryTracker* s_upload_owner = nullptr;
 
diff --git a/tests/MemoryTrackerTests.cpp b/tests/MemoryTrackerTests.cpp
--- a/tests/MemoryTrackerTests.cpp
+++ b/tests/MemoryTrackerTests.cpp
@@ -2113,8 +2113,24 @@
   UploadAll(tracker, boundary - page_size, page_size * 2);
   const auto both = span();
   Check(both != 0, "a range over two existing regions has no signature");
-  const auto first_only = tracker.RangeSignature(boundary - page_size, page_size);
-  WriteFault(tracker, boundary + 8);
+  const auto first_only = tracker.RangeSignature(boundary - page_size, page_size);
+  const auto second_only = tracker.RangeSignature(boundary, page_size);
+  const auto first_dirty = tracker.RangeDirtiedSignature(boundary - page_size, page_size);
+  const auto second_dirty = tracker.RangeDirtiedSignature(boundary, page_size);
+  Check(tracker.RangeSignature(boundary - 1, 1) == first_only &&
+            tracker.RangeSignature(boundary, 1) == second_only &&
+            tracker.RangeSignature(boundary - 1, 2) == first_only + second_only,
+        "one-byte and boundary-spanning signatures disagree");
+  Check(tracker.RangeDirtiedSignature(boundary - 1, 1) == first_dirty &&
+            tracker.RangeDirtiedSignature(boundary, 1) == second_dirty &&
+            tracker.RangeDirtiedSignature(boundary - 1, 2) == first_dirty + second_dirty,
+        "one-byte and boundary-spanning dirtying signatures disagree");
+  Check(tracker.RangeSignature(boundary, 0) == 0 &&
+            tracker.RangeDirtiedSignature(boundary, 0) == 0 &&
+            tracker.RangeSignature(TRACKER_ADDRESS_SIZE - 1, 2) == 0 &&
+            tracker.RangeDirtiedSignature(TRACKER_ADDRESS_SIZE - 1, 2) == 0,
+        "invalid ranges must have no signature");
+  WriteFault(tracker, boundary + 8);
   const auto second = span();
   Check(second > both && tracker.RangeSignature(boundary - page_size, page_size) == first_only,
         "a change in the second region kept the two-region signature or moved the first's");
