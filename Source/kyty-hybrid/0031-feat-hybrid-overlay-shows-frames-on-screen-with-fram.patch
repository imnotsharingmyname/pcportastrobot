From 0678e89e3dc91b7bc5b343f2a776b4509889ebea Mon Sep 17 00:00:00 2001
From: faycal <faycalelhandi9@gmail.com>
Date: Thu, 12 Nov 2026 23:00:15 +0000
Subject: [PATCH 31/35] feat(hybrid): overlay shows frames on screen with frame
 generation

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/graphics/host_gpu/renderer/frameGen.cpp     | 12 ++++++++++++
 src/graphics/host_gpu/renderer/frameGen.h       |  3 +++
 .../presentation/performanceOverlay.cpp         | 17 +++++++++++++++--
 3 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/src/graphics/host_gpu/renderer/frameGen.cpp b/src/graphics/host_gpu/renderer/frameGen.cpp
index 49717c4b..619cf064 100644
--- a/src/graphics/host_gpu/renderer/frameGen.cpp
+++ b/src/graphics/host_gpu/renderer/frameGen.cpp
@@ -1,5 +1,6 @@
 #include "graphics/host_gpu/renderer/frameGen.h"
 
+#include <algorithm>
 #include <array>
 #include <atomic>
 #include <chrono>
@@ -61,6 +62,9 @@ uint64_t CurrentFrame() {
 bool CameraWanted() {
 	return false;
 }
+double ShownPerGameFrame() {
+	return 1.0;
+}
 void SetCamera(const float*) {}
 bool TagFrame(VkCommandBuffer, const ImageInput&, const ImageInput&, const float*, uint32_t, uint32_t) {
 	return false;
@@ -156,6 +160,7 @@ struct State {
 	uint32_t              mvec_width = 0, mvec_height = 0;
 	uint64_t              tags = 0, tag_failures = 0, sleeps = 0;
 	uint64_t              presents = 0, presented_frames = 0;
+	std::atomic<double>   shown_ratio {1.0};
 	int64_t               print_ns = 0;
 };
 
@@ -386,6 +391,9 @@ void PresentEnd(uint64_t frame) {
 		if (s.api.dlssg_get_state(viewport, state, nullptr) == sl::Result::eOk) {
 			s.presents++;
 			s.presented_frames += state.numFramesActuallyPresented;
+			const double shown = std::max(1u, state.numFramesActuallyPresented);
+			const double old   = s.shown_ratio.load(std::memory_order_relaxed);
+			s.shown_ratio.store(old + (shown - old) * 0.1, std::memory_order_relaxed);
 		}
 		Summary();
 	}
@@ -395,6 +403,10 @@ uint64_t CurrentFrame() {
 	return Get().cp_frame.load(std::memory_order_acquire) + 1;
 }
 
+double ShownPerGameFrame() {
+	return Active() ? Get().shown_ratio.load(std::memory_order_relaxed) : 1.0;
+}
+
 bool CameraWanted() {
 	auto& s = Get();
 	return Active() && s.camera_wanted;
diff --git a/src/graphics/host_gpu/renderer/frameGen.h b/src/graphics/host_gpu/renderer/frameGen.h
index 0d9fd563..972415e9 100644
--- a/src/graphics/host_gpu/renderer/frameGen.h
+++ b/src/graphics/host_gpu/renderer/frameGen.h
@@ -39,6 +39,9 @@ namespace Libs::Graphics::FrameGen {
 // After the device: Reflex, DLSS-G options and the runtime state.
 void OnDeviceReady();
 [[nodiscard]] bool Active();
+// Frames on screen per game frame, averaged over recent presents (1 when generation is off or
+// paused, e.g. the window lost focus); for the performance overlay. Any thread.
+[[nodiscard]] double ShownPerGameFrame();
 
 // Frame events (frame numbers as in lowLatency.h).
 void GuestFrameEnd(uint64_t frame);
diff --git a/src/graphics/presentation/performanceOverlay.cpp b/src/graphics/presentation/performanceOverlay.cpp
index 622df922..1b784f95 100644
--- a/src/graphics/presentation/performanceOverlay.cpp
+++ b/src/graphics/presentation/performanceOverlay.cpp
@@ -5,6 +5,7 @@
 #include "common/emulatorConfig.h"
 #include "common/hostStats.h"
 #include "graphics/host_gpu/graphicContext.h"
+#include "graphics/host_gpu/renderer/frameGen.h"
 #include "imgui.h"
 #include "kernel/memory.h"
 
@@ -737,14 +738,26 @@ float DrawPerformanceOverlay(const GraphicContext& graphics, vk::Extent2D extent
 		ImGui::SetNextWindowBgAlpha(0.55f);
 	}
 	const bool open = ImGui::Begin("##kyty_performance_overlay", nullptr, FLAGS);
+	// ASTROHYBRID_DLSSG (frameGen.h): with frame generation the screen shows more frames than the
+	// game renders; both are shown.
+	const double generated = Graphics::FrameGen::ShownPerGameFrame();
+	const bool   frame_gen = generated > 1.05;
 	if (open && fps_only) {
-		if (shown.fps > 0.0) {
+		if (shown.fps > 0.0 && frame_gen) {
+			ImGui::TextColored(Color(GOOD), "%.0f FPS on screen", shown.fps * generated);
+			ImGui::TextDisabled("%.0f game x%.1f frame gen", shown.fps, generated);
+		} else if (shown.fps > 0.0) {
 			ImGui::TextColored(Color(FrameTimeColor(shown.frame_ms)), "%.0f FPS", shown.fps);
 		} else {
 			ImGui::TextDisabled("-- FPS");
 		}
 	} else if (open) {
-		if (shown.fps > 0.0) {
+		if (shown.fps > 0.0 && frame_gen) {
+			ImGui::TextColored(Color(GOOD), "%.0f FPS on screen (frame gen x%.1f)", shown.fps * generated,
+			                   generated);
+			ImGui::TextColored(Color(FrameTimeColor(shown.frame_ms)), "Game %.1f FPS   %.1f ms",
+			                   shown.fps, shown.frame_ms);
+		} else if (shown.fps > 0.0) {
 			ImGui::TextColored(Color(FrameTimeColor(shown.frame_ms)), "%.1f FPS   %.1f ms",
 			                   shown.fps, shown.frame_ms);
 		} else if (shown.stalled_s >= 1.0) {
