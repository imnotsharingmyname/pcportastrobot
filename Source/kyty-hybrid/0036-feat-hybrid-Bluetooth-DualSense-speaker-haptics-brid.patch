diff --git a/src/libs/dualSenseBluetooth.cpp b/src/libs/dualSenseBluetooth.cpp
index fa21e965..0bc85692 100644
--- a/src/libs/dualSenseBluetooth.cpp
+++ b/src/libs/dualSenseBluetooth.cpp
@@ -67,30 +67,49 @@ SDL_hid_device* OpenDevice(int controller) {
 	SDL_LockJoysticks();
 	auto*      pad      = SDL_GetGamepadFromID(static_cast<SDL_JoystickID>(controller));
 	const bool wireless = pad != nullptr && SDL_GetGamepadType(pad) == SDL_GAMEPAD_TYPE_PS5 &&
-	                      SDL_GetGamepadConnectionState(pad) == SDL_JOYSTICK_CONNECTION_WIRELESS;
+	                      SDL_GetGamepadConnectionState(pad) != SDL_JOYSTICK_CONNECTION_WIRED;
 	const auto vendor  = wireless ? SDL_GetGamepadVendor(pad) : 0;
 	const auto product = wireless ? SDL_GetGamepadProduct(pad) : 0;
 	const auto address = wireless ? Address(SDL_GetGamepadSerial(pad)) : std::string {};
 	SDL_UnlockJoysticks();
-	if (vendor != 0x054c || (product != 0x0ce6 && product != 0x0df2) || address.empty()) {
+	if (vendor != 0x054c || (product != 0x0ce6 && product != 0x0df2)) {
 		return nullptr;
 	}
-	auto*       devices = SDL_hid_enumerate(vendor, product);
-	std::string path;
-	bool        ambiguous = false;
+	auto*       devices            = SDL_hid_enumerate(vendor, product);
+	std::string path               = {};
+	std::string fallback_path      = {};
+	bool        ambiguous          = false;
+	bool        fallback_ambiguous = false;
 	for (auto* device = devices; device != nullptr; device = device->next) {
-		if (device->bus_type == SDL_HID_API_BUS_BLUETOOTH && device->path != nullptr &&
-		    Address(device->serial_number) == address &&
+		const bool is_bt =
+		    device->bus_type == SDL_HID_API_BUS_BLUETOOTH ||
+		    (device->path != nullptr &&
+		     (SDL_strcasestr(device->path, "00001124-0000-1000-8000-00805f9b34fb") != nullptr ||
+		      SDL_strcasestr(device->path, "bthenum") != nullptr));
+		if (is_bt && device->path != nullptr &&
 		    (device->usage_page == 0 || (device->usage_page == 1 && device->usage == 5))) {
-			if (!path.empty()) {
-				ambiguous = true;
-				break;
+			const auto dev_address = Address(device->serial_number);
+			if (!address.empty() && dev_address == address) {
+				if (!path.empty()) {
+					ambiguous = true;
+					break;
+				}
+				path = device->path;
+			}
+			if (address.empty() || dev_address.empty() ||
+			    SDL_strcasestr(device->path, address.c_str()) != nullptr) {
+				if (!fallback_path.empty()) {
+					fallback_ambiguous = true;
+				} else {
+					fallback_path = device->path;
+				}
 			}
-			path = device->path;
 		}
 	}
 	SDL_hid_free_enumeration(devices);
-	return !ambiguous && !path.empty() ? SDL_hid_open_path(path.c_str()) : nullptr;
+	const std::string& chosen =
+	    (!ambiguous && !path.empty()) ? path : (!fallback_ambiguous ? fallback_path : std::string {});
+	return !chosen.empty() ? SDL_hid_open_path(chosen.c_str()) : nullptr;
 }
 
 void FinishReport(std::array<uint8_t, REPORT_BYTES>& report) {
diff --git a/src/libs/dualSenseHaptics.cpp b/src/libs/dualSenseHaptics.cpp
index d72789c0..21d01299 100644
--- a/src/libs/dualSenseHaptics.cpp
+++ b/src/libs/dualSenseHaptics.cpp
@@ -102,9 +102,10 @@ bool RouteSpeaker(int controller, bool speaker) { // Caller holds g_mutex.
 	report[0] = 0x80; // Audio control valid
 	if (speaker) {
 		report[0] |= 0x20; // Speaker volume valid
-		report[1]  = 0x80; // Audio control 2 valid
+		report[1]  = 0x82; // Audio control 2 valid + audio mute bits valid
 		report[5]  = 0x64; // Speaker volume
 		report[7]  = 0x30; // Output path: right channel to the speaker, headphones muted
+		report[9]  = 0x10; // Mute headphones, unmute internal speaker
 		report[37] = 0x02; // Speaker preamp +6 dB
 	}
 	bool routed = false;
@@ -177,11 +178,24 @@ bool IsWireless(int controller) {
 	SDL_LockJoysticks();
 	auto*      pad = SDL_GetGamepadFromID(static_cast<SDL_JoystickID>(controller));
 	const bool wireless =
-	    pad != nullptr && SDL_GetGamepadConnectionState(pad) == SDL_JOYSTICK_CONNECTION_WIRELESS;
+	    pad != nullptr && SDL_GetGamepadType(pad) == SDL_GAMEPAD_TYPE_PS5 &&
+	    SDL_GetGamepadConnectionState(pad) != SDL_JOYSTICK_CONNECTION_WIRED;
 	SDL_UnlockJoysticks();
 	return wireless;
 }
 
+bool WirelessFeatureEnabled(bool speaker) {
+	static const bool speaker_enabled = [] {
+		const char* value = std::getenv("ASTROHYBRID_DS_WIRELESS_SPEAKER");
+		return value == nullptr || std::strcmp(value, "0") != 0;
+	}();
+	static const bool haptics_enabled = [] {
+		const char* value = std::getenv("ASTROHYBRID_DS_WIRELESS_HAPTICS");
+		return value == nullptr || std::strcmp(value, "0") != 0;
+	}();
+	return speaker ? speaker_enabled : haptics_enabled;
+}
+
 bool CanUseDevice(int controller) {
 	// SDL exposes no portable association between a gamepad and its USB audio endpoint.
 	// Require one wired DualSense; guessing with multiple pads could play on the wrong one.
@@ -391,6 +405,10 @@ uint64_t Queue(Stream* stream, int controller, const void* data, uint32_t frames
 		return static_cast<uint64_t>(frames) * 1000000 / stream->freq;
 	}
 	const bool wireless = IsWireless(controller);
+	if (wireless && !WirelessFeatureEnabled(stream->speaker)) {
+		CloseDevice(stream);
+		return 0;
+	}
 	if (!wireless && !CanUseDevice(controller)) {
 		CloseDevice(stream);
 		stream->next_check = 0; // Look for the device as soon as a DualSense is active again.
@@ -417,12 +435,24 @@ uint64_t Queue(Stream* stream, int controller, const void* data, uint32_t frames
 	stream->buffer.assign(static_cast<size_t>(frames) * output_channels, 0.0f);
 	bool audible = false;
 	for (uint32_t frame = 0; frame < frames; frame++) {
+		float values[2] {};
 		for (uint32_t ch = 0; ch < 2; ch++) {
 			const auto src_ch = channels == 1 ? 0 : ch;
 			const auto index  = (static_cast<size_t>(first_frame) + frame) * channels + src_ch;
 			float      value  = is_float ? static_cast<const float*>(data)[index]
 			                             : static_cast<const int16_t*>(data)[index] / 32768.0f;
 			value *= volume[src_ch] / 32768.0f * gain * (gains != nullptr ? gains[src_ch] : 1.0f);
+			values[ch] = value;
+		}
+		if (stream->speaker && channels >= 2) {
+			const float mono = (values[0] != 0.0f && values[1] != 0.0f)
+			                       ? 0.5f * (values[0] + values[1])
+			                       : (values[0] + values[1]);
+			values[0] = mono;
+			values[1] = mono;
+		}
+		for (uint32_t ch = 0; ch < 2; ch++) {
+			const float value = values[ch];
 			// USB places the speaker in front and the actuators in back; Bluetooth takes stereo.
 			stream->buffer[static_cast<size_t>(frame) * output_channels + ch + channel_offset] =
 			    value;
diff --git a/src/libs/libSaveData.cpp b/src/libs/libSaveData.cpp
index 0b24e296..d7d15b43 100644
--- a/src/libs/libSaveData.cpp
+++ b/src/libs/libSaveData.cpp
@@ -931,11 +931,37 @@ int KYTY_SYSV_ABI SaveDataTransferringMount(const SaveDataTransferringMount* mou
 		return SAVE_DATA_ERROR_MOUNT_FULL;
 	}
 
+	// If the directory doesn't exist, create it with a default block size.
+	// This handles game versions (like 01.007.000) that call SaveDataTransferringMount
+	// before the save directory has been created by SaveDataMount3.
 	if (!Common::File::IsDirectoryExisting(mount_dir)) {
-		return SAVE_DATA_ERROR_NOT_FOUND;
+		constexpr uint64_t default_blocks = 256; // Reasonable default for game saves
+		if (default_blocks < SAVE_DATA_BLOCKS_MIN || default_blocks > SAVE_DATA_BLOCKS_MAX) {
+			return SAVE_DATA_ERROR_PARAMETER;
+		}
+		const auto metadata = mount_dir / "sce_sys";
+		std::error_code error;
+		std::filesystem::create_directories(metadata, error);
+		if (error) {
+			return SAVE_DATA_ERROR_INTERNAL;
+		}
+		const int status = write_save_file(metadata / "blocks.bin", &default_blocks,
+		                                   sizeof(default_blocks));
+		if (status != OK) {
+			std::filesystem::remove_all(mount_dir, error);
+			return status;
+		}
+		const SaveDataParam initial {};
+		const int param_status = write_save_file(save_param_path(mount_dir), &initial,
+		                                         sizeof(initial));
+		if (param_status != OK) {
+			std::filesystem::remove_all(mount_dir, error);
+			return param_status;
+		}
+		LOGF("\t created save directory at %s\n", Common::PathToString(mount_dir).c_str());
 	}
 
-	return mount_save_data(slot, mount_dir, 0, mount_result);
+	return mount_save_data(slot, mount_dir, 1, mount_result); // 1 = newly created
 }
 
 int KYTY_SYSV_ABI SaveDataUmount2(uint32_t mode, const SaveDataMountPoint* mount_point) {
