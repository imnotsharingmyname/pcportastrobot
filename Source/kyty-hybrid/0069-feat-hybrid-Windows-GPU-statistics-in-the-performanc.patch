+#ifndef KYTY_COMMON_HOST_GPU_WINDOWS_H_
+#define KYTY_COMMON_HOST_GPU_WINDOWS_H_
+
+#include "common/hostStats.h"
+
+#include <memory>
+
+namespace Common {
+
+// Windows GPU statistics for HostStatsSampler (hostStats.cpp). Every source is loaded at run time
+// and optional; a missing one leaves its HostStats fields unset:
+//  - PDH "GPU Engine", "GPU Adapter Memory", "GPU Process Memory" (what Task Manager shows, every
+//    vendor): utilization by engine kind, the emulator's share, dedicated and shared memory;
+//  - DXGI: adapter name, memory sizes and driver version, matched by LUID;
+//  - Intel Graphics Control Library (ControlLib.dll, installed with the Intel driver): clock,
+//    power from the energy counter, temperature, throttle reasons, Xe cores;
+//  - D3DKMT adapter/node performance data (the GPU temperature in Task Manager): temperature,
+//    fan, power share and clock on drivers that report them (NVIDIA, AMD; Intel reports zeros);
+//  - PDH "Thermal Zone Information": the hottest ACPI zone as the SoC temperature of an
+//    integrated GPU that has no sensor of its own.
+// Not thread-safe; HostStatsSampler calls it from one thread. The first sample has no rates.
+class HostGpuSampler final {
+public:
+	HostGpuSampler();
+	~HostGpuSampler();
+	HostGpuSampler(const HostGpuSampler&)            = delete;
+	HostGpuSampler& operator=(const HostGpuSampler&) = delete;
+
+	void Sample(HostStats& stats);
+
+private:
+	struct Impl;
+	std::unique_ptr<Impl> m_impl;
+};
+
+} // namespace Common
+
+#endif /* KYTY_COMMON_HOST_GPU_WINDOWS_H_ */
