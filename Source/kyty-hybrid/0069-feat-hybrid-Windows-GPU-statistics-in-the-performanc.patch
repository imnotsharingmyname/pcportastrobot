+static_assert(offsetof(PowerTelemetry, gpu_clock) == 80);
+static_assert(offsetof(PowerTelemetry, vram_energy) == 208);
+static_assert(offsetof(PowerTelemetry, total_card_energy) == 384);
+static_assert(offsetof(PowerTelemetry, fan_speed) == 688);
+static_assert(offsetof(PowerTelemetry, gpu_vr_temperature) == 808);
+static_assert(sizeof(PowerTelemetry) == 1024);
+
+constexpr int32_t UNITS_RPM = 9; // ctl_units_t: fan speeds in RPM (others report percent)
+
+using InitFn          = int32_t(__cdecl*)(InitArgs*, void**);
+using EnumerateFn     = int32_t(__cdecl*)(void*, uint32_t*, void**);
+using PropertiesFn    = int32_t(__cdecl*)(void*, DeviceProperties*);
+using PowerTelemetryFn = int32_t(__cdecl*)(void*, PowerTelemetry*);
+
+std::optional<double> Value(const TelemetryItem& item) {
+	if (!item.supported) {
+		return std::nullopt;
+	}
+	switch (item.type) {
+		case 0: return item.value.i8;
+		case 1: return item.value.u8;
+		case 2: return item.value.i16;
+		case 3: return item.value.u16;
+		case 4: return item.value.i32;
+		case 5: return item.value.u32;
+		case 6: return static_cast<double>(item.value.i64);
+		case 7: return static_cast<double>(item.value.u64);
+		case 8: return item.value.f32;
+		case 9: return item.value.f64;
+		default: return std::nullopt;
+	}
+}
+
+struct Device {
+	void*       handle = nullptr;
+	bool        has_luid = false;
+	LUID        luid {};
+	std::string name;
+	uint32_t    device_id  = 0;
+	uint32_t    xe_cores   = 0;
+	uint32_t    max_mhz    = 0;
+	bool        integrated = false;
+};
+
+struct Library {
+	bool                ready     = false;
+	PowerTelemetryFn    telemetry = nullptr;
+	std::vector<Device> devices;
+	std::mutex          mutex; // Telemetry calls.
+};
+
+// Initialised once per process and kept: the overlay's sampler is recreated whenever the overlay
+// is shown again, and ControlLib's start-up enumerates every adapter.
+Library& Get() {
+	static Library library;
+	static std::once_flag once;
+	std::call_once(once, [] {
+		auto* module = LoadLibraryExW(L"ControlLib.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+		InitFn       init       = nullptr;
+		EnumerateFn  enumerate  = nullptr;
+		PropertiesFn properties = nullptr;
+		if (!Resolve(module, "ctlInit", init) || !Resolve(module, "ctlEnumerateDevices", enumerate) ||
+		    !Resolve(module, "ctlGetDeviceProperties", properties) ||
+		    !Resolve(module, "ctlPowerTelemetryGet", library.telemetry)) {
+			return;
+		}
+		InitArgs args {};
+		args.size        = sizeof(args);
+		args.app_version = (1u << 16u) | 1u; // IGCL 1.1
+		void* api        = nullptr;
+		if (init(&args, &api) != 0 || api == nullptr) {
+			return;
+		}
+		uint32_t count = 0;
+		if (enumerate(api, &count, nullptr) != 0 || count == 0) {
+			return;
+		}
+		std::vector<void*> handles(count);
+		if (enumerate(api, &count, handles.data()) != 0) {
+			return;
+		}
+		handles.resize(count);
+		for (auto* handle: handles) {
+			LUID             luid {};
+			DeviceProperties props {};
+			int32_t          result = -1;
+			for (int version = 3; version >= 0 && result != 0; version--) {
+				props                = {};
+				props.size           = sizeof(props);
+				props.version        = static_cast<uint8_t>(version);
+				props.device_id      = &luid;
+				props.device_id_size = sizeof(luid);
+				result               = properties(handle, &props);
+			}
+			if (result != 0 || props.device_type != 1) {
+				continue;
+			}
+			Device device;
+			device.handle     = handle;
+			device.has_luid   = luid.LowPart != 0 || luid.HighPart != 0;
+			device.luid       = luid;
+			device.name       = std::string(props.name, strnlen(props.name, sizeof(props.name)));
+			device.device_id  = props.pci_device_id;
+			device.xe_cores   = props.version >= 3 ? props.xe_cores : 0;
+			device.max_mhz    = props.frequency;
+			device.integrated = (props.adapter_flags & 1u) != 0;
+			library.devices.push_back(std::move(device));
+		}
+		library.ready = !library.devices.empty();
+		// The api handle stays open for the process.
+	});
+	return library;
+}
