+
+struct PowerTelemetry {
+	uint32_t      size;
+	uint8_t       version;
+	TelemetryItem time_stamp; // s
+	TelemetryItem gpu_energy; // J, monotonic
+	TelemetryItem gpu_voltage;
+	TelemetryItem gpu_clock;       // MHz
+	TelemetryItem gpu_temperature; // C
+	TelemetryItem global_activity; // s busy, monotonic
+	TelemetryItem render_compute_activity;
+	TelemetryItem media_activity;
+	bool          gpu_power_limited;
+	bool          gpu_temperature_limited;
+	bool          gpu_current_limited;
+	bool          gpu_voltage_limited;
