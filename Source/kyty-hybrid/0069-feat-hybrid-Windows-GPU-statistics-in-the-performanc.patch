+// ---------------------------------------------------------------------------------------------
+// PDH: the "GPU Engine" and GPU memory counters (English names, so any Windows language works).
+
+struct PdhApi {
+	decltype(&PdhOpenQueryW)                open_query  = nullptr;
+	decltype(&PdhAddEnglishCounterW)        add_counter = nullptr;
+	decltype(&PdhCollectQueryData)          collect     = nullptr;
+	decltype(&PdhGetFormattedCounterArrayW) get_array   = nullptr;
+	decltype(&PdhCloseQuery)                close_query = nullptr;
+	bool                                    ready       = false;
+};
+
+const PdhApi& Pdh() {
+	static const PdhApi api = [] {
+		PdhApi result;
+		auto*  module = LoadLibraryExW(L"pdh.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+		result.ready  = Resolve(module, "PdhOpenQueryW", result.open_query) &&
+		               Resolve(module, "PdhAddEnglishCounterW", result.add_counter) &&
+		               Resolve(module, "PdhCollectQueryData", result.collect) &&
+		               Resolve(module, "PdhGetFormattedCounterArrayW", result.get_array) &&
+		               Resolve(module, "PdhCloseQuery", result.close_query);
+		return result;
+	}();
+	return api;
+}
+
+// Parsed instance names: "pid_1234_luid_0x00000000_0x00011949_phys_0_eng_3_engtype_3D" (GPU
+// Engine), "luid_0x00000000_0x00011949_phys_0" (GPU Adapter Memory), "pid_1234_luid_..._phys_0"
+// (GPU Process Memory).
+struct Instance {
+	bool        has_pid = false;
+	uint32_t    pid     = 0;
+	LUID        luid {};
+	uint32_t    phys   = 0;
+	uint32_t    engine = 0;
+	std::string type; // Lower case.
+};
+
+bool ParseInstance(const wchar_t* name, Instance& out) {
+	if (name == nullptr) {
+		return false;
+	}
+	if (const auto* pid = std::wcsstr(name, L"pid_"); pid != nullptr) {
+		out.has_pid = true;
+		out.pid     = static_cast<uint32_t>(std::wcstoul(pid + 4, nullptr, 10));
+	}
+	const auto* luid = std::wcsstr(name, L"luid_0x");
+	if (luid == nullptr) {
+		return false;
+	}
+	wchar_t*   end  = nullptr;
+	const auto high = std::wcstoul(luid + 7, &end, 16);
+	if (end == nullptr || std::wcsncmp(end, L"_0x", 3) != 0) {
+		return false;
+	}
+	const auto low     = std::wcstoul(end + 3, &end, 16);
+	out.luid.HighPart = static_cast<LONG>(high);
+	out.luid.LowPart  = static_cast<DWORD>(low);
+	if (const auto* phys = std::wcsstr(end, L"phys_"); phys != nullptr) {
+		out.phys = static_cast<uint32_t>(std::wcstoul(phys + 5, nullptr, 10));
+	}
+	if (const auto* engine = std::wcsstr(end, L"_eng_"); engine != nullptr) {
+		out.engine = static_cast<uint32_t>(std::wcstoul(engine + 5, nullptr, 10));
+	}
+	if (const auto* type = std::wcsstr(end, L"engtype_"); type != nullptr) {
+		out.type = Lower(Utf8(type + 8));
+	}
+	return true;
+}
+
+enum class EngineKind { Other, ThreeD, Compute, Copy, Video };
+
+EngineKind KindOf(const std::string& type) {
+	if (type.find("3d") != std::string::npos) {
+		return EngineKind::ThreeD;
+	}
+	if (type.find("compute") != std::string::npos) {
+		return EngineKind::Compute;
+	}
+	if (type.find("copy") != std::string::npos) {
+		return EngineKind::Copy;
+	}
+	if (type.find("video") != std::string::npos) {
+		return EngineKind::Video;
+	}
+	return EngineKind::Other;
+}
+
+// Every instance of a wildcard counter with valid data.
+template <typename F>
+void ForEachInstance(PDH_HCOUNTER counter, DWORD format, std::vector<std::byte>& buffer, F&& visit) {
+	const auto& pdh = Pdh();
+	if (counter == nullptr) {
+		return;
+	}
+	for (int attempt = 0; attempt < 3; attempt++) {
+		DWORD size  = 0;
+		DWORD count = 0;
+		auto  status = pdh.get_array(counter, format, &size, &count, nullptr);
+		if (status != static_cast<PDH_STATUS>(PDH_MORE_DATA) || size == 0) {
+			return;
+		}
+		buffer.resize(size);
+		auto* items = reinterpret_cast<PDH_FMT_COUNTERVALUE_ITEM_W*>(buffer.data());
+		status      = pdh.get_array(counter, format, &size, &count, items);
+		if (status == static_cast<PDH_STATUS>(PDH_MORE_DATA)) {
+			continue; // Instances appeared in between.
+		}
+		if (status != ERROR_SUCCESS) {
+			return;
+		}
+		for (DWORD i = 0; i < count; i++) {
+			const auto& value = items[i].FmtValue;
+			if (value.CStatus == PDH_CSTATUS_VALID_DATA || value.CStatus == PDH_CSTATUS_NEW_DATA) {
+				visit(items[i].szName, value);
+			}
+		}
+		return;
+	}
+}
