+// ---------------------------------------------------------------------------------------------
+// The renderer's adapter (SetHostGpuAdapter).
+
+struct AdapterChoice {
+	bool        has_luid = false;
+	LUID        luid {};
+	std::string name;
+	uint32_t    vendor_id  = 0;
+	uint32_t    device_id  = 0;
+	bool        integrated = false;
+	bool        known      = false; // Set by the renderer (integrated is meaningful).
+	uint64_t    revision   = 0;
+};
+
+std::mutex    g_adapter_mutex;
+AdapterChoice g_adapter;
+
+AdapterChoice CurrentAdapter() {
+	std::scoped_lock lock(g_adapter_mutex);
+	return g_adapter;
+}
+
+bool SameLuid(const LUID& a, const LUID& b) {
+	return a.LowPart == b.LowPart && a.HighPart == b.HighPart;
+}
+
+const char* VendorName(uint32_t vendor_id) {
+	switch (vendor_id) {
+		case 0x8086: return "Intel";
+		case 0x10DE: return "NVIDIA";
+		case 0x1002:
+		case 0x1022: return "AMD";
+		default: return "";
+	}
+}
+
+std::string Utf8(const wchar_t* text) {
+	if (text == nullptr || text[0] == L'\0') {
+		return {};
+	}
+	const int size = WideCharToMultiByte(CP_UTF8, 0, text, -1, nullptr, 0, nullptr, nullptr);
+	if (size <= 1) {
+		return {};
+	}
+	std::string result(static_cast<size_t>(size), '\0');
+	WideCharToMultiByte(CP_UTF8, 0, text, -1, result.data(), size, nullptr, nullptr);
+	result.resize(static_cast<size_t>(size) - 1);
+	return result;
+}
+
+std::string Lower(std::string text) {
+	std::transform(text.begin(), text.end(), text.begin(), [](char c) {
+		return c >= 'A' && c <= 'Z' ? static_cast<char>(c - 'A' + 'a') : c;
+	});
+	return text;
+}
+
+template <typename T>
+bool Resolve(HMODULE module, const char* name, T& function) {
+	function = module != nullptr
+	               ? reinterpret_cast<T>(reinterpret_cast<void*>(GetProcAddress(module, name)))
+	               : nullptr;
+	return function != nullptr;
+}
+
+// ---------------------------------------------------------------------------------------------
+// DXGI: names, memory sizes and driver versions of every adapter (read once).
+
+struct DxgiAdapter {
+	LUID        luid {};
+	std::string name;
+	uint32_t    vendor_id = 0;
+	uint32_t    device_id = 0;
+	uint64_t    dedicated = 0; // DedicatedVideoMemory
+	uint64_t    shared    = 0; // SharedSystemMemory
+	std::string driver;
+	bool        software = false;
+};
+
+const std::vector<DxgiAdapter>& DxgiAdapters() {
+	static const std::vector<DxgiAdapter> adapters = [] {
+		std::vector<DxgiAdapter> result;
+		auto* module = LoadLibraryExW(L"dxgi.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+		using CreateFactory = HRESULT(WINAPI*)(REFIID, void**);
+		CreateFactory create = nullptr;
+		if (!Resolve(module, "CreateDXGIFactory1", create)) {
+			return result;
+		}
+		IDXGIFactory1* factory = nullptr;
+		if (FAILED(create(__uuidof(IDXGIFactory1), reinterpret_cast<void**>(&factory))) ||
+		    factory == nullptr) {
+			return result;
+		}
+		for (UINT index = 0;; index++) {
+			IDXGIAdapter1* adapter = nullptr;
+			if (factory->EnumAdapters1(index, &adapter) != S_OK || adapter == nullptr) {
+				break;
+			}
+			DXGI_ADAPTER_DESC1 desc {};
+			if (SUCCEEDED(adapter->GetDesc1(&desc))) {
+				DxgiAdapter entry;
+				entry.luid      = desc.AdapterLuid;
+				entry.name      = Utf8(desc.Description);
+				entry.vendor_id = desc.VendorId;
+				entry.device_id = desc.DeviceId;
+				entry.dedicated = desc.DedicatedVideoMemory;
+				entry.shared    = desc.SharedSystemMemory;
+				entry.software  = (desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) != 0;
+				// The user-mode driver version, as the Display adapter properties show it.
+				LARGE_INTEGER umd {};
+				if (SUCCEEDED(adapter->CheckInterfaceSupport(__uuidof(IDXGIDevice), &umd))) {
+					char text[48];
+					std::snprintf(text, sizeof(text), "%u.%u.%u.%u",
+					              static_cast<unsigned>(static_cast<uint32_t>(umd.HighPart) >> 16u),
+					              static_cast<unsigned>(static_cast<uint32_t>(umd.HighPart) & 0xffffu),
+					              static_cast<unsigned>(umd.LowPart >> 16u),
+					              static_cast<unsigned>(umd.LowPart & 0xffffu));
+					entry.driver = text;
+				}
+				result.push_back(std::move(entry));
+			}
+			adapter->Release();
+		}
+		factory->Release();
+		return result;
+	}();
+	return adapters;
+}
+
+const DxgiAdapter* FindDxgi(const LUID& luid) {
+	for (const auto& adapter: DxgiAdapters()) {
+		if (SameLuid(adapter.luid, luid)) {
+			return &adapter;
+		}
+	}
+	return nullptr;
+}
