+struct HostGpuSampler::Impl {
+	PDH_HQUERY   query            = nullptr;
+	PDH_HCOUNTER engines          = nullptr;
+	PDH_HCOUNTER adapter_dedicated = nullptr;
+	PDH_HCOUNTER adapter_shared   = nullptr;
+	PDH_HCOUNTER process_dedicated = nullptr;
+	PDH_HCOUNTER process_shared   = nullptr;
+	PDH_HCOUNTER thermal          = nullptr;
+	double       thermal_scale    = 1.0; // Counter units per kelvin.
+	bool         collected_once   = false;
+	std::vector<std::byte> buffer;
+	uint32_t     pid = GetCurrentProcessId();
+
+	// The adapter described, resolved again when the renderer names another one.
+	uint64_t choice_revision = ~0ull;
+	bool     has_target      = false;
+	LUID     target {};
+	uint32_t engine_3d = 0; // Node ordinal of the 3D engine (D3DKMT node data).
+
+	// D3DKMT handle of the target adapter (0: none).
+	uint32_t kmt_adapter = 0;
+	bool     kmt_tried   = false;
+
+	// IGCL previous counters, for power and activity rates.
+	const Igcl::Device*   igcl_device = nullptr;
+	bool                  igcl_tried  = false;
+	std::optional<double> last_time, last_energy, last_global, last_render;
+
+	Impl() {
+		const auto& pdh = Pdh();
+		if (!pdh.ready || pdh.open_query(nullptr, 0, &query) != ERROR_SUCCESS) {
+			query = nullptr;
+			return;
+		}
+		const auto add = [&](const wchar_t* path) -> PDH_HCOUNTER {
+			PDH_HCOUNTER counter = nullptr;
+			return pdh.add_counter(query, path, 0, &counter) == ERROR_SUCCESS ? counter : nullptr;
+		};
+		engines           = add(L"\\GPU Engine(*)\\Utilization Percentage");
+		adapter_dedicated = add(L"\\GPU Adapter Memory(*)\\Dedicated Usage");
+		adapter_shared    = add(L"\\GPU Adapter Memory(*)\\Shared Usage");
+		process_dedicated = add(L"\\GPU Process Memory(*)\\Dedicated Usage");
+		process_shared    = add(L"\\GPU Process Memory(*)\\Shared Usage");
+		thermal           = add(L"\\Thermal Zone Information(*)\\High Precision Temperature");
+		thermal_scale     = 10.0; // Tenths of a kelvin.
+		if (thermal == nullptr) {
+			thermal       = add(L"\\Thermal Zone Information(*)\\Temperature");
+			thermal_scale = 1.0;
+		}
+	}
+
+	~Impl() {
+		if (query != nullptr) {
+			Pdh().close_query(query);
+		}
+		CloseKmt();
+	}
+
+	Impl(const Impl&)            = delete;
+	Impl& operator=(const Impl&) = delete;
+
+	void CloseKmt() {
+		if (kmt_adapter != 0) {
+			Kmt::CloseAdapter close {kmt_adapter};
+			Kmt::Get().close(&close);
+			kmt_adapter = 0;
+		}
+		kmt_tried = false;
+	}
+
+	void SetTarget(const LUID& luid) {
+		if (has_target && SameLuid(target, luid)) {
+			return;
+		}
+		has_target  = true;
+		target      = luid;
+		igcl_device = nullptr;
+		igcl_tried  = false;
+		last_time.reset();
+		last_energy.reset();
+		last_global.reset();
+		last_render.reset();
+		CloseKmt();
+	}
+
+	void SampleEngines(HostStats& stats, const AdapterChoice& choice);
+	void SampleMemory(HostStats& stats) const;
+	void SampleIgcl(HostStats& stats, const AdapterChoice& choice);
+	void SampleKmt(HostStats& stats);
+	void SampleThermalZones(HostStats& stats);
+};
+
+void HostGpuSampler::Impl::SampleEngines(HostStats& stats, const AdapterChoice& choice) {
+	struct Entry {
+		Instance name;
+		double   value;
+	};
+	std::vector<Entry> entries;
+	ForEachInstance(engines, PDH_FMT_DOUBLE | PDH_FMT_NOCAP100, buffer,
+	                [&](const wchar_t* instance, const PDH_FMT_COUNTERVALUE& value) {
+		                Entry entry {};
+		                if (ParseInstance(instance, entry.name)) {
+			                entry.value = value.doubleValue;
+			                entries.push_back(std::move(entry));
+		                }
+	                });
+
+	// Without the renderer's LUID: the adapter this process uses most.
+	if (!has_target && !choice.has_luid) {
+		std::vector<std::pair<LUID, double>> ours;
+		for (const auto& entry: entries) {
+			if (!entry.name.has_pid || entry.name.pid != pid) {
+				continue;
+			}
+			auto it = std::find_if(ours.begin(), ours.end(),
+			                       [&](const auto& p) { return SameLuid(p.first, entry.name.luid); });
+			if (it == ours.end()) {
+				ours.emplace_back(entry.name.luid, entry.value);
+			} else {
+				it->second += entry.value;
+			}
+		}
+		const auto best = std::max_element(ours.begin(), ours.end(),
+		                                   [](const auto& a, const auto& b) { return a.second < b.second; });
+		if (best != ours.end() && best->second > 0.0) {
+			SetTarget(best->first);
+		}
+	}
+	if (!has_target || entries.empty()) {
+		return;
+	}
+
+	// Task Manager's figures: an engine's utilization is the sum over processes; the device's is
+	// that of its busiest engine.
+	struct Engine {
+		double     total = 0.0;
+		double     ours  = 0.0;
+		EngineKind kind  = EngineKind::Other;
+	};
+	std::unordered_map<uint64_t, Engine> by_engine;
+	for (const auto& entry: entries) {
+		if (!SameLuid(entry.name.luid, target)) {
+			continue;
+		}
+		auto& engine = by_engine[(static_cast<uint64_t>(entry.name.phys) << 32u) | entry.name.engine];
+		engine.total += entry.value;
+		engine.kind = KindOf(entry.name.type);
+		if (entry.name.has_pid && entry.name.pid == pid) {
+			engine.ours += entry.value;
+		}
+		if (engine.kind == EngineKind::ThreeD && entry.name.phys == 0) {
+			engine_3d = entry.name.engine;
+		}
+	}
+	if (by_engine.empty() || !collected_once) {
+		return; // The first collection has no interval yet.
+	}
+	double device = 0.0;
+	double ours   = 0.0;
+	std::optional<double> kinds[5];
+	for (const auto& [key, engine]: by_engine) {
+		const double total = std::clamp(engine.total, 0.0, 100.0);
+		device             = std::max(device, total);
+		ours               = std::max(ours, std::clamp(engine.ours, 0.0, 100.0));
+		auto& kind         = kinds[static_cast<size_t>(engine.kind)];
+		kind               = std::max(kind.value_or(0.0), total);
+	}
+	stats.gpu_percent         = device;
+	stats.gpu_process_percent = ours;
+	stats.gpu_3d_percent      = kinds[static_cast<size_t>(EngineKind::ThreeD)];
+	stats.gpu_compute_percent = kinds[static_cast<size_t>(EngineKind::Compute)];
+	stats.gpu_copy_percent    = kinds[static_cast<size_t>(EngineKind::Copy)];
+	stats.gpu_video_percent   = kinds[static_cast<size_t>(EngineKind::Video)];
+}
+
+void HostGpuSampler::Impl::SampleMemory(HostStats& stats) const {
+	if (!has_target) {
+		return;
+	}
+	std::vector<std::byte> scratch;
+	const auto sum = [&](PDH_HCOUNTER counter, bool own) -> std::optional<uint64_t> {
+		std::optional<uint64_t> total;
+		ForEachInstance(counter, PDH_FMT_LARGE, scratch,
+		                [&](const wchar_t* instance, const PDH_FMT_COUNTERVALUE& value) {
+			                Instance name;
+			                if (!ParseInstance(instance, name) || !SameLuid(name.luid, target) ||
+			                    (own && (!name.has_pid || name.pid != pid)) || value.largeValue < 0) {
+				                return;
+			                }
+			                total = total.value_or(0) + static_cast<uint64_t>(value.largeValue);
+		                });
+		return total;
+	};
+	stats.gpu_dedicated_used    = sum(adapter_dedicated, false);
+	stats.gpu_shared_used       = sum(adapter_shared, false);
+	stats.gpu_process_dedicated = sum(process_dedicated, true);
+	stats.gpu_process_shared    = sum(process_shared, true);
+}
+
+void HostGpuSampler::Impl::SampleIgcl(HostStats& stats, const AdapterChoice& choice) {
+	if (!igcl_tried) {
+		igcl_tried   = true;
+		auto& library = Igcl::Get();
+		if (library.ready) {
+			for (const auto& device: library.devices) {
+				if (device.has_luid ? SameLuid(device.luid, target)
+				                    : (choice.device_id != 0 && device.device_id == choice.device_id)) {
+					igcl_device = &device;
+					break;
+				}
+			}
+		}
+	}
+	if (igcl_device == nullptr) {
+		return;
+	}
+	const auto& device = *igcl_device;
+	if (device.xe_cores != 0) {
+		stats.gpu_cores     = device.xe_cores;
+		stats.gpu_core_name = "Xe cores";
+	}
+	if (device.max_mhz != 0) {
+		stats.gpu_max_clock_mhz = device.max_mhz;
+	}
+	if (stats.gpu_kind.empty()) {
+		stats.gpu_kind = device.integrated ? "integrated" : "discrete";
+	}
+
+	Igcl::PowerTelemetry telemetry {};
+	telemetry.size    = sizeof(telemetry);
+	telemetry.version = 1;
+	auto& library     = Igcl::Get();
+	{
+		std::scoped_lock lock(library.mutex);
+		if (library.telemetry(device.handle, &telemetry) != 0) {
+			return;
+		}
+	}
+	const auto now      = Igcl::Value(telemetry.time_stamp);
+	const auto energy   = Igcl::Value(telemetry.gpu_energy);
+	const auto global   = Igcl::Value(telemetry.global_activity);
+	const auto render   = Igcl::Value(telemetry.render_compute_activity);
+	if (now && last_time && *now > *last_time) {
+		const double elapsed = *now - *last_time;
+		if (energy && last_energy && *energy >= *last_energy) {
+			stats.gpu_power_w = (*energy - *last_energy) / elapsed;
+		}
+		// Busy time over wall time: the utilization when the engine counters are missing.
+		if (!stats.gpu_percent && global && last_global && *global >= *last_global) {
+			stats.gpu_percent = std::clamp((*global - *last_global) / elapsed * 100.0, 0.0, 100.0);
+		}
+		if (!stats.gpu_3d_percent && render && last_render && *render >= *last_render) {
+			stats.gpu_3d_percent = std::clamp((*render - *last_render) / elapsed * 100.0, 0.0, 100.0);
+		}
+	}
+	last_time   = now;
+	last_energy = energy;
+	last_global = global;
+	last_render = render;
+
+	if (const auto clock = Igcl::Value(telemetry.gpu_clock); clock && *clock > 0.0) {
+		stats.gpu_clock_mhz = *clock;
+	}
+	if (const auto temperature = Igcl::Value(telemetry.gpu_temperature);
+	    temperature && *temperature > 0.0 && *temperature < 150.0) {
+		stats.gpu_temperature_c = *temperature;
+	}
+	if (const auto percent = Igcl::Value(telemetry.gpu_power_percent); percent && *percent > 0.0) {
+		stats.gpu_power_percent = *percent;
+	}
+	for (const auto& fan: telemetry.fan_speed) {
+		if (const auto speed = Igcl::Value(fan); speed && fan.units == Igcl::UNITS_RPM && *speed > 0.0) {
+			stats.gpu_fan_rpm = static_cast<uint32_t>(*speed);
+			break;
+		}
+	}
+	std::string throttle;
+	const auto  reason = [&](bool limited, const char* name) {
+		if (limited) {
+			throttle += throttle.empty() ? std::string(name) : std::string(", ") + name;
+		}
+	};
+	reason(telemetry.gpu_power_limited, "power");
+	reason(telemetry.gpu_temperature_limited, "thermal");
+	reason(telemetry.gpu_current_limited, "current");
+	reason(telemetry.gpu_voltage_limited, "voltage");
+	stats.gpu_throttle = std::move(throttle);
+}
+
+void HostGpuSampler::Impl::SampleKmt(HostStats& stats) {
+	const auto& kmt = Kmt::Get();
+	if (!kmt.ready) {
+		return;
+	}
+	if (!kmt_tried) {
+		kmt_tried = true;
+		Kmt::OpenAdapterFromLuid open {};
+		open.luid = target;
+		if (kmt.open(&open) >= 0) {
+			kmt_adapter = open.adapter;
+		}
+	}
+	if (kmt_adapter == 0) {
+		return;
+	}
+	// Drivers without the data report zeros (Intel); only non-zero values are taken.
+	Kmt::AdapterPerfData adapter {};
+	if (Kmt::Query(kmt_adapter, Kmt::QUERY_ADAPTER_PERF_DATA, adapter)) {
+		if (!stats.gpu_temperature_c && adapter.temperature > 0 && adapter.temperature < 1500) {
+			stats.gpu_temperature_c = adapter.temperature / 10.0;
+		}
+		if (!stats.gpu_fan_rpm && adapter.fan_rpm > 0) {
+			stats.gpu_fan_rpm = adapter.fan_rpm;
+		}
+		if (!stats.gpu_power_percent && adapter.power > 0) {
+			stats.gpu_power_percent = adapter.power / 10.0;
+		}
+	}
+	Kmt::NodePerfData node {};
+	node.node_ordinal = engine_3d;
+	if (Kmt::Query(kmt_adapter, Kmt::QUERY_NODE_PERF_DATA, node)) {
+		if (!stats.gpu_clock_mhz && node.frequency > 0) {
+			stats.gpu_clock_mhz = static_cast<double>(node.frequency) / 1e6;
+		}
+		if (!stats.gpu_max_clock_mhz && node.max_frequency > 0) {
+			stats.gpu_max_clock_mhz = static_cast<double>(node.max_frequency) / 1e6;
+		}
+	}
+}
+
+void HostGpuSampler::Impl::SampleThermalZones(HostStats& stats) {
+	std::optional<double> hottest;
+	ForEachInstance(thermal, PDH_FMT_DOUBLE, buffer,
+	                [&](const wchar_t* /*instance*/, const PDH_FMT_COUNTERVALUE& value) {
+		                const double celsius = value.doubleValue / thermal_scale - 273.15;
+		                if (celsius > 0.0 && celsius < 125.0) {
+			                hottest = std::max(hottest.value_or(celsius), celsius);
+		                }
+	                });
+	if (hottest) {
+		stats.gpu_temperature_c      = *hottest;
+		stats.gpu_temperature_is_soc = true;
+	}
+}
+
+HostGpuSampler::HostGpuSampler(): m_impl(std::make_unique<Impl>()) {}
+
+HostGpuSampler::~HostGpuSampler() = default;
+
+void HostGpuSampler::Sample(HostStats& stats) {
+	auto&      s      = *m_impl;
+	const auto choice = CurrentAdapter();
+	if (choice.revision != s.choice_revision) {
+		s.choice_revision = choice.revision;
+		if (choice.has_luid) {
+			s.SetTarget(choice.luid);
+		}
+	}
+	if (s.query != nullptr) {
+		const bool collected = Pdh().collect(s.query) == ERROR_SUCCESS;
+		if (collected) {
+			s.SampleEngines(stats, choice);
+			s.collected_once = true;
+		}
+	}
+	// No LUID and no usage yet: the named adapter, else the first hardware adapter.
+	if (!s.has_target) {
+		const auto& adapters = DxgiAdapters();
+		const DxgiAdapter* pick = nullptr;
+		for (const auto& adapter: adapters) {
+			if (!adapter.software && !choice.name.empty() &&
+			    (Lower(adapter.name).find(Lower(choice.name)) != std::string::npos ||
+			     Lower(choice.name).find(Lower(adapter.name)) != std::string::npos)) {
+				pick = &adapter;
+				break;
+			}
+		}
+		for (const auto& adapter: adapters) {
+			if (pick == nullptr && !adapter.software) {
+				pick = &adapter;
+			}
+		}
+		if (pick == nullptr) {
+			return;
+		}
+		s.SetTarget(pick->luid);
+	}
+
+	const auto* dxgi      = FindDxgi(s.target);
+	const auto  vendor_id = choice.vendor_id != 0 ? choice.vendor_id : dxgi != nullptr ? dxgi->vendor_id : 0;
+	stats.gpu_model       = !choice.name.empty() ? choice.name : dxgi != nullptr ? dxgi->name : std::string();
+	stats.gpu_vendor      = VendorName(vendor_id);
+	if (choice.known) {
+		stats.gpu_kind = choice.integrated ? "integrated" : "discrete";
+	}
+	if (dxgi != nullptr) {
+		stats.gpu_driver = dxgi->driver;
+		if (dxgi->dedicated != 0) {
+			stats.gpu_dedicated_total = dxgi->dedicated;
+		}
+		if (dxgi->shared != 0) {
+			stats.gpu_shared_total = dxgi->shared;
+		}
+	}
+	if (s.query != nullptr && s.collected_once) {
+		s.SampleMemory(stats);
+	}
+	if (vendor_id == 0x8086) {
+		s.SampleIgcl(stats, choice);
+	}
+	s.SampleKmt(stats);
+	if (stats.gpu_kind.empty() && dxgi != nullptr) {
+		// No better source: integrated GPUs reserve little or no dedicated memory.
+		stats.gpu_kind = dxgi->dedicated < (512ull << 20u) ? "integrated" : "discrete";
+	}
+	if (!stats.gpu_temperature_c && stats.gpu_kind == "integrated") {
+		s.SampleThermalZones(stats);
+	}
+}
+
+void SetHostGpuAdapter(const uint8_t* luid, const char* name, uint32_t vendor_id, uint32_t device_id,
+                       bool integrated) {
+	std::scoped_lock lock(g_adapter_mutex);
+	g_adapter.has_luid = luid != nullptr;
+	g_adapter.luid     = {};
+	if (luid != nullptr) {
+		std::memcpy(&g_adapter.luid.LowPart, luid, 4);
+		std::memcpy(&g_adapter.luid.HighPart, luid + 4, 4);
+	}
+	g_adapter.name       = name != nullptr ? name : "";
+	g_adapter.vendor_id  = vendor_id;
+	g_adapter.device_id  = device_id;
+	g_adapter.integrated = integrated;
+	g_adapter.known      = true;
+	g_adapter.revision++;
+}
