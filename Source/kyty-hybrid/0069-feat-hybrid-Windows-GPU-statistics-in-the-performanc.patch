+// ---------------------------------------------------------------------------------------------
+// Intel Graphics Control Library (ControlLib.dll from the Intel driver). Only the few entry points
+// and structures used here are declared, laid out as the public IGCL 1.1 interface defines them.
+
+namespace Igcl {
+
+struct ApplicationId {
+	uint32_t data1;
+	uint16_t data2;
+	uint16_t data3;
+	uint8_t  data4[8];
+};
+
+struct InitArgs {
+	uint32_t      size;
+	uint8_t       version;
+	uint32_t      app_version;
+	uint32_t      flags; // 0: no Level Zero; power telemetry works without it.
+	uint32_t      supported_version;
+	ApplicationId application_uid;
+};
+static_assert(sizeof(InitArgs) == 36);
+
+struct DeviceProperties {
+	uint32_t size;
+	uint8_t  version;
+	void*    device_id; // LUID on Windows
+	uint32_t device_id_size;
+	int32_t  device_type; // 1 = graphics
+	uint32_t supported_functions;
+	uint64_t driver_version;
+	uint64_t firmware_version[3];
+	uint32_t pci_vendor_id;
+	uint32_t pci_device_id;
+	uint32_t rev_id;
+	uint32_t eus_per_sub_slice;
+	uint32_t sub_slices_per_slice;
+	uint32_t slices;
+	char     name[100];
+	uint32_t adapter_flags; // bit 0: integrated
+	uint32_t frequency;     // MHz
+	uint16_t subsys_id;
+	uint16_t subsys_vendor_id;
