+static_assert(offsetof(DeviceProperties, name) == 88);
+static_assert(offsetof(DeviceProperties, xe_cores) == 204);
+static_assert(sizeof(DeviceProperties) == 320);
+
+struct TelemetryItem {
+	bool    supported;
+	int32_t units;
+	int32_t type;
+	union {
+		int8_t   i8;
+		uint8_t  u8;
+		int16_t  i16;
+		uint16_t u16;
+		int32_t  i32;
+		uint32_t u32;
+		int64_t  i64;
+		uint64_t u64;
+		float    f32;
+		double   f64;
