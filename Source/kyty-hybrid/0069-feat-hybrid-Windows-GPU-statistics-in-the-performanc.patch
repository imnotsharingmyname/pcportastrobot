+
+using OpenFn  = LONG(APIENTRY*)(OpenAdapterFromLuid*);
+using CloseFn = LONG(APIENTRY*)(const CloseAdapter*);
+using QueryFn = LONG(APIENTRY*)(const QueryAdapterInfo*);
+
+struct Api {
+	OpenFn  open  = nullptr;
+	CloseFn close = nullptr;
+	QueryFn query = nullptr;
+	bool    ready = false;
+};
+
+const Api& Get() {
+	static const Api api = [] {
+		Api   result;
+		auto* module = LoadLibraryExW(L"gdi32.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+		result.ready = Resolve(module, "D3DKMTOpenAdapterFromLuid", result.open) &&
+		               Resolve(module, "D3DKMTCloseAdapter", result.close) &&
+		               Resolve(module, "D3DKMTQueryAdapterInfo", result.query);
+		return result;
+	}();
+	return api;
+}
+
+template <typename T>
+bool Query(uint32_t adapter, int32_t type, T& data) {
+	QueryAdapterInfo info {};
+	info.adapter = adapter;
+	info.type    = type;
+	info.data    = &data;
+	info.size    = sizeof(T);
+	return Get().query(&info) >= 0;
+}
+
+} // namespace Kmt
