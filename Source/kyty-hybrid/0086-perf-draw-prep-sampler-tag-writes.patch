From 8079383e75d076a72d3a25c69898bc69f0736f82 Mon Sep 17 00:00:00 2001
From: AstroHybrid <noreply@localhost>
Date: Thu, 26 Nov 2026 11:43:00 +0000
Subject: [PATCH] Avoid redundant sampler and texture tag initialization during
 draw preparation

---
 .../host_gpu/renderer/drawPrep/bindingPlan.cpp     | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/src/graphics/host_gpu/renderer/drawPrep/bindingPlan.cpp b/src/graphics/host_gpu/renderer/drawPrep/bindingPlan.cpp
index ba1af8ed..641b4d37 100644
--- a/src/graphics/host_gpu/renderer/drawPrep/bindingPlan.cpp
+++ b/src/graphics/host_gpu/renderer/drawPrep/bindingPlan.cpp
@@ -161,7 +161,8 @@ vk::Sampler FindPlanSampler(SamplerCache& cache, const ShaderSamplerResource& de
 bool PlanSamplers(SamplerCache& cache, const CompiledShaderInfo& program,
                   const ResourceSnapshot& resources, StagePlan& stage) {
 	const auto count = program.info.samplers.size();
-	stage.samplers.assign(count, vk::Sampler {});
+	// Each valid plan overwrites every sampler; keep the existing storage.
+	stage.samplers.resize(count);
 	uint32_t absent = 0;
 	for (size_t i = 0; i < count; i++) {
 		const auto snapshot_index = program.info.samplers[i].snapshot_index;
@@ -193,7 +194,7 @@ bool PlanTextureHashes(const CompiledShaderInfo& program, const ResourceSnapshot
 	}
 	stage.texture_hashes.resize(count);
 	if (memo != nullptr) {
-		stage.texture_tags.assign(count, 0);
+		stage.texture_tags.resize(count);
 	}
 	uint32_t hints = 0;
 	for (size_t i = 0; i < count; i++) {
@@ -203,10 +204,11 @@ bool PlanTextureHashes(const CompiledShaderInfo& program, const ResourceSnapshot
 		}
 		const auto key          = TextureBindingMemo::MakeKey(program.info.images[i], descriptor.fields);
 		stage.texture_hashes[i] = TextureBindingMemo::Hash(key);
-		uint64_t tag            = 0;
-		if (memo != nullptr && memo->FindHint(key, stage.texture_hashes[i], tag)) {
-			stage.texture_tags[i] = tag;
-			hints++;
+		if (memo != nullptr) {
+			uint64_t tag = 0;
+			const bool hit = memo->FindHint(key, stage.texture_hashes[i], tag);
+			stage.texture_tags[i] = hit ? tag : 0;
+			hints += hit ? 1u : 0u;
 		}
 	}
 	stage.texture_tags_valid = memo != nullptr;
-- 
