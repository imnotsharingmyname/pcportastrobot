diff --git a/src/hybrid/kytyGpuApi.h b/src/hybrid/kytyGpuApi.h
new file mode 100644
index 00000000..1be37cd5
--- /dev/null
+++ b/src/hybrid/kytyGpuApi.h
@@ -0,0 +1,149 @@
+#ifndef KYTY_HYBRID_KYTYGPUAPI_H_
+#define KYTY_HYBRID_KYTYGPUAPI_H_
+
+/* AstroHybrid: the C interface between AnyPS5's native AstroBot.exe and kyty_gpu.dll.
+ *
+ * Both sides include this header with different toolchains (AnyPS5: MinGW GCC, Itanium C++ ABI;
+ * Kyty: clang-cl, MSVC ABI). Only C types cross it. Functions in the two tables below use the
+ * platform's default C calling convention (Microsoft x64 on Windows), which both toolchains agree
+ * on. The NID-named exports of kyty_gpu.dll are different: they are called by game code and use
+ * the System V calling convention, like AnyPS5's own prx exports (APS5_VABI).
+ *
+ * Versioning: the host passes KYTY_GPU_ABI_VERSION and sizeof() of its structs. The DLL refuses a
+ * different major version or a struct smaller than the fields it reads; fields are only ever
+ * appended. */
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define KYTY_GPU_ABI_VERSION_MAJOR 1u
+#define KYTY_GPU_ABI_VERSION_MINOR 0u
+#define KYTY_GPU_ABI_VERSION ((KYTY_GPU_ABI_VERSION_MAJOR << 16u) | KYTY_GPU_ABI_VERSION_MINOR)
+
+#if defined(_WIN32)
+#if defined(KYTY_GPU_BUILDING_DLL)
+#define KYTY_GPU_EXPORT __declspec(dllexport)
+#else
+#define KYTY_GPU_EXPORT __declspec(dllimport)
+#endif
+#else
+#define KYTY_GPU_EXPORT __attribute__((visibility("default")))
+#endif
+
+typedef enum KytyGpuStatus {
+	KYTY_GPU_OK                  = 0,
+	KYTY_GPU_E_VERSION           = -1, /* major version or struct size not supported */
+	KYTY_GPU_E_ARGUMENT          = -2,
+	KYTY_GPU_E_STATE             = -3, /* called in the wrong lifecycle state */
+	KYTY_GPU_E_NOT_IMPLEMENTED   = -4, /* interface present, implementation is a later milestone */
+	KYTY_GPU_E_HOST_CALLBACK     = -5, /* a required host callback is missing */
+	KYTY_GPU_E_UNKNOWN_NID       = -6,
+} KytyGpuStatus;
+
+/* How an exported NID reaches its implementation. */
+typedef enum KytyGpuBinding {
+	KYTY_GPU_BINDING_KYTY_VERIFIED = 1, /* Kyty's HLE function; argument layout compared with AnyPS5's */
+	KYTY_GPU_BINDING_KYTY          = 2, /* Kyty's HLE function; game ABI, layout not yet compared */
+	KYTY_GPU_BINDING_BRIDGE        = 3, /* implemented by the bridge (host handles, AnyPS5 semantics) */
+} KytyGpuBinding;
+
+typedef struct KytyGpuNidInfo {
+	const char* nid;      /* export name, e.g. "UglJIZjGssM" */
+	const char* library;  /* AnyPS5 prx the game imports it from, e.g. "libSceAgcDriver.prx" */
+	const char* function; /* implementation name, for logs */
+	uint32_t    binding;  /* KytyGpuBinding */
+	uint32_t    bound;    /* nonzero once the export reaches its implementation */
+} KytyGpuNidInfo;
+
+/* Memory flags for register_memory. */
+#define KYTY_GPU_MEMORY_GPU_READ  0x1u
+#define KYTY_GPU_MEMORY_GPU_WRITE 0x2u
+#define KYTY_GPU_MEMORY_DIRECT    0x4u /* direct memory (has a backing alias) */
+
+/* GPU -> host event kinds (host_callbacks.gpu_event). */
+#define KYTY_GPU_EVENT_EOP_INTERRUPT 1u /* ident: AGC event id (queue), data: unused */
+#define KYTY_GPU_EVENT_FLIP          2u /* ident: video out handle, data: flip argument */
+#define KYTY_GPU_EVENT_VBLANK        3u /* ident: video out handle */
+
+typedef struct KytyGpuHostCallbacks {
+	uint32_t struct_size; /* sizeof(KytyGpuHostCallbacks) on the host */
+	uint32_t abi_version; /* KYTY_GPU_ABI_VERSION of the host */
+	void*    user;        /* passed back to every callback */
+
+	/* Diagnostics. level: 0 info, 1 warning, 2 error. May be null. */
+	void (*log)(void* user, int level, const char* message);
+
+	/* The game's event queues live in AnyPS5's libkernel. The bridge forwards the AGC and VideoOut
+	 * event registrations to the host, which owns the queue handles, and raises events through
+	 * deliver_event. Return 0 or a negative SCE error. */
+	int (*add_gpu_event)(void* user, int64_t equeue, uint32_t kind, int64_t ident, void* udata);
+	int (*delete_gpu_event)(void* user, int64_t equeue, uint32_t kind, int64_t ident);
+	void (*deliver_event)(void* user, uint32_t kind, int64_t ident, uint64_t data);
+
+	/* Guest memory as AnyPS5's libkernel maps it. Return 0 and fill the range holding address, or
+	 * a negative value when it is not mapped. alias: an always-readable host view of the same
+	 * bytes, or null when the guest view itself is the backing. */
+	int (*query_memory)(void* user, uint64_t address, uint64_t* base, uint64_t* size,
+	                    uint32_t* flags, const void** alias);
+
+	/* The title's app0 directory (UTF-8), for shader and pipeline caches. May be null. */
+	const char* (*app0_path)(void* user);
+} KytyGpuHostCallbacks;
+
+typedef struct KytyGpuPacket { /* identical to AGC's Packet and AnyPS5's Packet */
+	uint32_t* addr;
+	uint32_t  dw_num;
+	uint8_t   flags;
+	uint8_t   reserved[3];
+} KytyGpuPacket;
+
+typedef struct KytyGpuApi {
+	uint32_t struct_size;
+	uint32_t abi_version;
+	const char* build; /* Kyty git version of the DLL */
+
+	/* Lifecycle. init binds every NID export (no graphics device yet); start_graphics creates
+	 * Kyty's Vulkan renderer and presentation; shutdown stops them. */
+	int (*init)(const KytyGpuHostCallbacks* host);
+	int (*start_graphics)(void);
+	void (*shutdown)(void);
+
+	/* Guest memory notifications from AnyPS5's libkernel. */
+	int (*register_memory)(uint64_t base, uint64_t size, uint32_t flags, const void* alias);
+	int (*unregister_memory)(uint64_t base, uint64_t size);
+	int (*invalidate_memory)(uint64_t base, uint64_t size); /* the CPU wrote the range */
+
+	/* Command submission (same semantics as the AGC driver calls). */
+	int (*submit_dcb)(const KytyGpuPacket* packet);
+	int (*submit_acb)(uint32_t queue, const KytyGpuPacket* packet);
+
+	/* Export table: count and the entry for an index or NID (null when out of range / unknown). */
+	uint32_t (*nid_count)(void);
+	const KytyGpuNidInfo* (*nid_info)(uint32_t index);
+	const KytyGpuNidInfo* (*find_nid)(const char* nid);
+} KytyGpuApi;
+
+/* The DLL's only C entry point; the host asks for the major version it was built with. Returns
+ * null for an unsupported version. */
+KYTY_GPU_EXPORT const KytyGpuApi* KytyGpuGetApi(uint32_t abi_version);
+typedef const KytyGpuApi* (*KytyGpuGetApiFn)(uint32_t abi_version);
+
+#ifdef __cplusplus
+}
+#endif
+
+#if defined(__cplusplus)
+static_assert(sizeof(KytyGpuPacket) == 16, "KytyGpuPacket layout");
+static_assert(offsetof(KytyGpuPacket, dw_num) == 8, "KytyGpuPacket layout");
+static_assert(offsetof(KytyGpuPacket, flags) == 12, "KytyGpuPacket layout");
+#else
+_Static_assert(sizeof(KytyGpuPacket) == 16, "KytyGpuPacket layout");
+_Static_assert(offsetof(KytyGpuPacket, dw_num) == 8, "KytyGpuPacket layout");
+_Static_assert(offsetof(KytyGpuPacket, flags) == 12, "KytyGpuPacket layout");
+#endif
+
+#endif /* KYTY_HYBRID_KYTYGPUAPI_H_ */
diff --git a/src/hybrid/kytyGpuBridge.cpp b/src/hybrid/kytyGpuBridge.cpp
new file mode 100644
index 00000000..6e54a300
--- /dev/null
+++ b/src/hybrid/kytyGpuBridge.cpp
@@ -0,0 +1,289 @@
+// AstroHybrid bridge: Kyty's GPU stack as kyty_gpu.dll for AnyPS5's native AstroBot.exe.
+//
+// The DLL exports every graphics NID the game imports from libSceAgc, libSceAgcDriver and
+// libSceVideoOut (src/hybrid/kytyGpuNids.inc, generated by tools/hybrid/gen_kyty_gpu_exports.py).
+// Each export is a two-instruction System V-transparent thunk that jumps through a slot. Before
+// KytyGpuGetApi()->init() binds them, every slot points at a trap that names the NID and stops the
+// process, so a call that reaches an unbound export never runs on uninitialized state.
+//
+// init() resolves the slots through Kyty's own HLE registrations (the same LIB_FUNC tables
+// kyty_emulator uses), except for the calls that carry AnyPS5 kernel handles: those go to the
+// bridge functions below, which forward to the host callbacks.
+
+#define KYTY_GPU_BUILDING_DLL
+#include "hybrid/kytyGpuApi.h"
+
+#include "common/abi.h"
+#include "kytyGitVersion.h"
+#include "libs/agc.h"
+#include "loader/symbolDatabase.h"
+
+#include <atomic>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+#if defined(_WIN32)
+#include <windows.h>
+#endif
+
+namespace Libs {
+void InitAgcDriver_1(Loader::SymbolDatabase* s);
+namespace LibGen5 {
+void InitVideoOut_1(Loader::SymbolDatabase* s);
+} // namespace LibGen5
+} // namespace Libs
+
+namespace {
+
+enum class State : int { Loaded, Initialized, Graphics, Stopped };
+
+struct NidRow {
+	const char* nid;
+	const char* library;
+	const char* function;
+	uint32_t    binding;
+};
+
+constexpr NidRow g_rows[] = {
+#define KYTY_GPU_NID(index, nid, library, function, binding) {nid, library, function, binding},
+#include "hybrid/kytyGpuNids.inc"
+#undef KYTY_GPU_NID
+};
+constexpr uint32_t g_row_count = static_cast<uint32_t>(sizeof(g_rows) / sizeof(g_rows[0]));
+
+KytyGpuNidInfo        g_info[g_row_count];
+KytyGpuHostCallbacks  g_host {};
+std::atomic<State>    g_state {State::Loaded};
+std::mutex            g_lifecycle;
+
+void Log(int level, const char* format, ...) {
+	char text[1024];
+	va_list args;
+	va_start(args, format);
+	std::vsnprintf(text, sizeof(text), format, args);
+	va_end(args);
+	if (g_host.log != nullptr) {
+		g_host.log(g_host.user, level, text);
+	} else {
+		std::fprintf(stderr, "[kyty_gpu] %s\n", text);
+	}
+}
+
+} // namespace
+
+extern "C" {
+
+// One slot per export; the thunks read them with a RIP-relative indirect jump.
+void* g_kyty_gpu_slots[g_row_count];
+
+[[noreturn]] void KytyGpuUnboundNid(uint32_t index) {
+	const char* nid      = index < g_row_count ? g_rows[index].nid : "?";
+	const char* function = index < g_row_count ? g_rows[index].function : "?";
+	char text[256];
+	std::snprintf(text, sizeof(text),
+	              "kyty_gpu: %s (%s, export %u) was called before KytyGpuGetApi()->init() bound it",
+	              nid, function, index);
+	std::fprintf(stderr, "%s\n", text);
+	std::fflush(stderr);
+#if defined(_WIN32)
+	OutputDebugStringA(text);
+#endif
+	std::abort();
+}
+
+// Reached from a thunk with the export index in r11d. Jumps (does not call) to the reporter, so
+// the stack is exactly as at the guest's call.
+__attribute__((naked)) void KytyGpuUnboundTrap() {
+	__asm__ volatile("movl %r11d, %ecx\n\t"
+	                 "jmp KytyGpuUnboundNid\n\t");
+}
+
+#define KYTY_GPU_NID(index, nid, library, function, binding)                                       \
+	__attribute__((naked)) void kyty_gpu_nid_##index() {                                           \
+		__asm__ volatile("movl $" #index ", %r11d\n\t"                                             \
+		                 "jmpq *g_kyty_gpu_slots+" #index "*8(%rip)\n\t");                         \
+	}
+#include "hybrid/kytyGpuNids.inc"
+#undef KYTY_GPU_NID
+
+} // extern "C"
+
+namespace {
+
+// ---- Bridge implementations (System V, called by game code through the thunks) ----
+
+constexpr int SceAgcErrorInvalidArgument = static_cast<int>(0x8A6C0002u);
+constexpr int SceVideoOutErrorInvalidEventQueue = static_cast<int>(0x80290012u);
+
+int KYTY_SYSV_ABI BridgeAgcDriverAddEqEvent(int64_t equeue, int id, void* udata) {
+	if (g_host.add_gpu_event == nullptr) {
+		Log(2, "sceAgcDriverAddEqEvent: the host registered no add_gpu_event callback");
+		return SceAgcErrorInvalidArgument;
+	}
+	return g_host.add_gpu_event(g_host.user, equeue, KYTY_GPU_EVENT_EOP_INTERRUPT, id, udata);
+}
+
+int KYTY_SYSV_ABI BridgeVideoOutAddFlipEvent(int64_t equeue, int handle, void* udata) {
+	if (g_host.add_gpu_event == nullptr) {
+		Log(2, "sceVideoOutAddFlipEvent: the host registered no add_gpu_event callback");
+		return SceVideoOutErrorInvalidEventQueue;
+	}
+	return g_host.add_gpu_event(g_host.user, equeue, KYTY_GPU_EVENT_FLIP, handle, udata);
+}
+
+void* BridgeFunction(const char* name) {
+	if (std::strcmp(name, "BridgeAgcDriverAddEqEvent") == 0) {
+		return reinterpret_cast<void*>(&BridgeAgcDriverAddEqEvent);
+	}
+	if (std::strcmp(name, "BridgeVideoOutAddFlipEvent") == 0) {
+		return reinterpret_cast<void*>(&BridgeVideoOutAddFlipEvent);
+	}
+	return nullptr;
+}
+
+// ---- C API ----
+
+int ApiInit(const KytyGpuHostCallbacks* host) {
+	if (host == nullptr) {
+		return KYTY_GPU_E_ARGUMENT;
+	}
+	if ((host->abi_version >> 16u) != KYTY_GPU_ABI_VERSION_MAJOR ||
+	    host->struct_size < sizeof(KytyGpuHostCallbacks)) {
+		Log(2, "init: host ABI %u.%u with %u-byte callbacks, this DLL needs %u.x and %zu bytes",
+		    host->abi_version >> 16u, host->abi_version & 0xffffu, host->struct_size,
+		    KYTY_GPU_ABI_VERSION_MAJOR, sizeof(KytyGpuHostCallbacks));
+		return KYTY_GPU_E_VERSION;
+	}
+	std::lock_guard lock(g_lifecycle);
+	if (g_state.load() != State::Loaded) {
+		return KYTY_GPU_E_STATE;
+	}
+	g_host = *host;
+
+	Loader::SymbolDatabase symbols;
+	Libs::InitAgcDriver_1(&symbols);
+	Libs::LibGen5::InitVideoOut_1(&symbols);
+
+	uint32_t missing = 0;
+	for (uint32_t i = 0; i < g_row_count; ++i) {
+		void* target = nullptr;
+		if (g_rows[i].binding == KYTY_GPU_BINDING_BRIDGE) {
+			target = BridgeFunction(g_rows[i].function);
+		} else if (const auto* record = symbols.FindByNid(g_rows[i].nid, Loader::SymbolType::Func);
+		           record != nullptr) {
+			target = reinterpret_cast<void*>(record->vaddr);
+		}
+		if (target == nullptr) {
+			Log(2, "init: %s %s (%s) has no implementation", g_rows[i].library, g_rows[i].nid,
+			    g_rows[i].function);
+			++missing;
+			continue;
+		}
+		g_kyty_gpu_slots[i] = target;
+		g_info[i].bound     = 1;
+	}
+	if (missing != 0) {
+		return KYTY_GPU_E_UNKNOWN_NID;
+	}
+	g_state.store(State::Initialized);
+	Log(0, "init: %u graphics NIDs bound (Kyty %s)", g_row_count, KYTY_GIT_VERSION);
+	return KYTY_GPU_OK;
+}
+
+int ApiStartGraphics() {
+	if (g_state.load() != State::Initialized) {
+		return KYTY_GPU_E_STATE;
+	}
+	Log(2, "start_graphics: Kyty's renderer start-up inside the host process is milestone 2 "
+	       "(Config/Log/Timer/Pthread/Memory/Graphics lifecycles, window thread, memory adapter)");
+	return KYTY_GPU_E_NOT_IMPLEMENTED;
+}
+
+void ApiShutdown() {
+	std::lock_guard lock(g_lifecycle);
+	g_state.store(State::Stopped);
+}
+
+int ApiRegisterMemory(uint64_t base, uint64_t size, uint32_t flags, const void* alias) {
+	Log(2, "register_memory(0x%llx, 0x%llx, 0x%x, %p): Kyty memory adapter is milestone 2",
+	    static_cast<unsigned long long>(base), static_cast<unsigned long long>(size), flags, alias);
+	return KYTY_GPU_E_NOT_IMPLEMENTED;
+}
+
+int ApiUnregisterMemory(uint64_t base, uint64_t size) {
+	Log(2, "unregister_memory(0x%llx, 0x%llx): Kyty memory adapter is milestone 2",
+	    static_cast<unsigned long long>(base), static_cast<unsigned long long>(size));
+	return KYTY_GPU_E_NOT_IMPLEMENTED;
+}
+
+int ApiInvalidateMemory(uint64_t base, uint64_t size) {
+	Log(2, "invalidate_memory(0x%llx, 0x%llx): Kyty memory adapter is milestone 2",
+	    static_cast<unsigned long long>(base), static_cast<unsigned long long>(size));
+	return KYTY_GPU_E_NOT_IMPLEMENTED;
+}
+
+static_assert(sizeof(KytyGpuPacket) == sizeof(Libs::Graphics::Gen5Driver::Packet));
+static_assert(offsetof(KytyGpuPacket, dw_num) == offsetof(Libs::Graphics::Gen5Driver::Packet, dw_num));
+static_assert(offsetof(KytyGpuPacket, flags) == offsetof(Libs::Graphics::Gen5Driver::Packet, flags));
+
+int ApiSubmitDcb(const KytyGpuPacket* packet) {
+	if (g_state.load() != State::Graphics) {
+		return KYTY_GPU_E_STATE;
+	}
+	return Libs::Graphics::Gen5Driver::AgcDriverSubmitDcb(
+	    reinterpret_cast<const Libs::Graphics::Gen5Driver::Packet*>(packet));
+}
+
+int ApiSubmitAcb(uint32_t queue, const KytyGpuPacket* packet) {
+	if (g_state.load() != State::Graphics) {
+		return KYTY_GPU_E_STATE;
+	}
+	return Libs::Graphics::Gen5Driver::AgcDriverSubmitAcb(
+	    queue, reinterpret_cast<const Libs::Graphics::Gen5Driver::Packet*>(packet));
+}
+
+uint32_t ApiNidCount() {
+	return g_row_count;
+}
+
+const KytyGpuNidInfo* ApiNidInfo(uint32_t index) {
+	return index < g_row_count ? &g_info[index] : nullptr;
+}
+
+const KytyGpuNidInfo* ApiFindNid(const char* nid) {
+	if (nid == nullptr) {
+		return nullptr;
+	}
+	for (uint32_t i = 0; i < g_row_count; ++i) {
+		if (std::strcmp(g_rows[i].nid, nid) == 0) {
+			return &g_info[i];
+		}
+	}
+	return nullptr;
+}
+
+struct Tables {
+	Tables() {
+		for (uint32_t i = 0; i < g_row_count; ++i) {
+			g_kyty_gpu_slots[i] = reinterpret_cast<void*>(&KytyGpuUnboundTrap);
+			g_info[i]           = {g_rows[i].nid, g_rows[i].library, g_rows[i].function,
+			                       g_rows[i].binding, 0};
+		}
+	}
+};
+const Tables g_tables;
+
+const KytyGpuApi g_api = {
+    sizeof(KytyGpuApi),  KYTY_GPU_ABI_VERSION, KYTY_GIT_VERSION, ApiInit,     ApiStartGraphics,
+    ApiShutdown,         ApiRegisterMemory,    ApiUnregisterMemory, ApiInvalidateMemory, ApiSubmitDcb,
+    ApiSubmitAcb,        ApiNidCount,          ApiNidInfo,          ApiFindNid,
+};
+
+} // namespace
+
+extern "C" KYTY_GPU_EXPORT const KytyGpuApi* KytyGpuGetApi(uint32_t abi_version) {
+	return (abi_version >> 16u) == KYTY_GPU_ABI_VERSION_MAJOR ? &g_api : nullptr;
+}
diff --git a/src/hybrid/kytyGpuNids.inc b/src/hybrid/kytyGpuNids.inc
new file mode 100644
index 00000000..2565546f
--- /dev/null
+++ b/src/hybrid/kytyGpuNids.inc
@@ -0,0 +1,83 @@
+// Generated by tools/hybrid/gen_kyty_gpu_exports.py from AstroBot.registry.json. Do not edit.
+KYTY_GPU_NID(0, "+kSrjIVxKFE", "libSceAgc.prx", "AgcDcbPushMarker", KYTY_GPU_BINDING_KYTY)
+KYTY_GPU_NID(1, "-HOOCn0JY48", "libSceAgc.prx", "AgcDcbSetShRegistersIndirect", KYTY_GPU_BINDING_KYTY)
+KYTY_GPU_NID(2, "-KRzWekV120", "libSceAgc.prx", "AgcDcbSetIndexSize_0600", KYTY_GPU_BINDING_KYTY)
+KYTY_GPU_NID(3, "-RnpfpxIhec", "libSceAgc.prx", "AgcAcbDmaData", KYTY_GPU_BINDING_KYTY)
+KYTY_GPU_NID(4, "0fWWK5uG9rQ", "libSceAgc.prx", "AgcQueueEndOfPipeActionPatchAddress", KYTY_GPU_BINDING_KYTY)
+KYTY_GPU_NID(5, "1rZSWUv1IRc", "libSceAgc.prx", "AgcDcbCopyData", KYTY_GPU_BINDING_KYTY)
