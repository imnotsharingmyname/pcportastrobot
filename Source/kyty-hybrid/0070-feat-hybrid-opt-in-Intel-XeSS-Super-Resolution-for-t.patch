+// ---------------------------------------------------------------------------------------------
+// libxess.dll
+
+struct Api {
+	bool ready = false;
+	decltype(&xessGetVersion)                      get_version         = nullptr;
+	decltype(&xessGetIntelXeFXVersion)             xefx_version        = nullptr;
+	decltype(&xessIsOptimalDriver)                 optimal_driver      = nullptr;
+	decltype(&xessSetLoggingCallback)              set_logging         = nullptr;
+	decltype(&xessVKGetRequiredInstanceExtensions) instance_extensions = nullptr;
+	decltype(&xessVKGetRequiredDeviceExtensions)   device_extensions   = nullptr;
+	decltype(&xessVKGetRequiredDeviceFeatures)     device_features     = nullptr;
+	decltype(&xessVKCreateContext)                 create_context      = nullptr;
+	decltype(&xessVKBuildPipelines)                build_pipelines     = nullptr;
+	decltype(&xessGetPipelineBuildStatus)          build_status        = nullptr;
+	decltype(&xessGetOptimalInputResolution)       optimal_input       = nullptr;
+	decltype(&xessVKInit)                          init                = nullptr;
+	decltype(&xessSetVelocityScale)                set_velocity_scale  = nullptr;
+	decltype(&xessVKExecute)                       execute             = nullptr;
+	decltype(&xessDestroyContext)                  destroy_context     = nullptr;
+};
+
+template <typename T>
+bool Resolve(HMODULE module, const char* name, T& function) {
+	function = reinterpret_cast<T>(reinterpret_cast<void*>(GetProcAddress(module, name)));
+	if (function == nullptr) {
+		std::printf("XeSS: libxess.dll has no %s\n", name);
+	}
+	return function != nullptr;
+}
+
+const Api& GetApi() {
+	static const Api api = [] {
+		Api result;
+		if (!Xess::Requested()) {
+			return result;
+		}
+		// ASTROHYBRID_XESS_PATH: the folder holding libxess.dll; else the game's folder and the
+		// usual DLL search order.
+		HMODULE     module = nullptr;
+		const char* folder = std::getenv("ASTROHYBRID_XESS_PATH");
+		if (folder != nullptr && folder[0] != '\0') {
+			const std::string path = std::string(folder) + "\\libxess.dll";
+			module = LoadLibraryExA(path.c_str(), nullptr, LOAD_WITH_ALTERED_SEARCH_PATH);
+		}
+		if (module == nullptr) {
+			module = LoadLibraryA("libxess.dll");
+		}
+		if (module == nullptr) {
+			std::printf("XeSS: libxess.dll not found (put it next to the game or set "
+			            "ASTROHYBRID_XESS_PATH); the game's own upscaling stays\n");
+			std::fflush(stdout);
+			return result;
+		}
+		result.ready = Resolve(module, "xessGetVersion", result.get_version) &&
+		               Resolve(module, "xessGetIntelXeFXVersion", result.xefx_version) &&
+		               Resolve(module, "xessIsOptimalDriver", result.optimal_driver) &&
+		               Resolve(module, "xessSetLoggingCallback", result.set_logging) &&
+		               Resolve(module, "xessVKGetRequiredInstanceExtensions", result.instance_extensions) &&
+		               Resolve(module, "xessVKGetRequiredDeviceExtensions", result.device_extensions) &&
+		               Resolve(module, "xessVKGetRequiredDeviceFeatures", result.device_features) &&
+		               Resolve(module, "xessVKCreateContext", result.create_context) &&
+		               Resolve(module, "xessVKBuildPipelines", result.build_pipelines) &&
+		               Resolve(module, "xessGetPipelineBuildStatus", result.build_status) &&
+		               Resolve(module, "xessGetOptimalInputResolution", result.optimal_input) &&
+		               Resolve(module, "xessVKInit", result.init) &&
+		               Resolve(module, "xessSetVelocityScale", result.set_velocity_scale) &&
+		               Resolve(module, "xessVKExecute", result.execute) &&
+		               Resolve(module, "xessDestroyContext", result.destroy_context);
+		xess_version_t version {};
+		if (result.ready && result.get_version(&version) == XESS_RESULT_SUCCESS) {
+			std::printf("XeSS: libxess.dll %u.%u.%u loaded\n", version.major, version.minor,
+			            version.patch);
+		}
+		std::fflush(stdout);
+		return result;
+	}();
+	return api;
+}
+
+const char* ResultName(xess_result_t result) {
+	switch (result) {
+		case XESS_RESULT_WARNING_NONEXISTING_FOLDER: return "warning: no dump folder";
+		case XESS_RESULT_WARNING_OLD_DRIVER: return "warning: old driver";
+		case XESS_RESULT_SUCCESS: return "success";
+		case XESS_RESULT_ERROR_UNSUPPORTED_DEVICE: return "unsupported device";
+		case XESS_RESULT_ERROR_UNSUPPORTED_DRIVER: return "unsupported driver";
+		case XESS_RESULT_ERROR_UNINITIALIZED: return "uninitialized";
+		case XESS_RESULT_ERROR_INVALID_ARGUMENT: return "invalid argument";
+		case XESS_RESULT_ERROR_DEVICE_OUT_OF_MEMORY: return "out of device memory";
+		case XESS_RESULT_ERROR_DEVICE: return "device error";
+		case XESS_RESULT_ERROR_NOT_IMPLEMENTED: return "not implemented";
+		case XESS_RESULT_ERROR_INVALID_CONTEXT: return "invalid context";
+		case XESS_RESULT_ERROR_OPERATION_IN_PROGRESS: return "in progress";
+		case XESS_RESULT_ERROR_UNSUPPORTED: return "unsupported";
+		case XESS_RESULT_ERROR_CANT_LOAD_LIBRARY: return "cannot load library";
+		case XESS_RESULT_ERROR_WRONG_CALL_ORDER: return "wrong call order";
+		default: return "unknown error";
+	}
+}
+
+void LogCallback(const char* message, xess_logging_level_t level) {
+	std::printf("XeSS [%s]: %s\n", level >= XESS_LOGGING_LEVEL_ERROR ? "error" : "warning", message);
+	std::fflush(stdout);
+}
+
+// ---------------------------------------------------------------------------------------------
+// Options and per-size contexts.
+
+enum class Fallback : uint32_t {
+	NotLoaded,
+	NoContext,
+	Warming,
+	InitFailed,
+	Bindings,
+	Sizes,
+	NoDepth,
+	NoMotionVectors,
+	ExecuteFailed,
+	Count
+};
+constexpr std::array<const char*, static_cast<size_t>(Fallback::Count)> FALLBACK_NAMES {
+    "not-loaded", "no-context", "warming", "init", "bindings", "sizes", "no-depth", "no-mv", "execute"};
+
+constexpr std::array<xess_quality_settings_t, 7> QUALITIES {
+    XESS_QUALITY_SETTING_AA,          XESS_QUALITY_SETTING_ULTRA_QUALITY_PLUS,
+    XESS_QUALITY_SETTING_ULTRA_QUALITY, XESS_QUALITY_SETTING_QUALITY,
+    XESS_QUALITY_SETTING_BALANCED,    XESS_QUALITY_SETTING_PERFORMANCE,
+    XESS_QUALITY_SETTING_ULTRA_PERFORMANCE};
+
+const char* QualityName(int quality) {
+	switch (quality) {
+		case XESS_QUALITY_SETTING_AA: return "native AA";
+		case XESS_QUALITY_SETTING_ULTRA_QUALITY_PLUS: return "ultra quality plus";
+		case XESS_QUALITY_SETTING_ULTRA_QUALITY: return "ultra quality";
+		case XESS_QUALITY_SETTING_QUALITY: return "quality";
+		case XESS_QUALITY_SETTING_BALANCED: return "balanced";
+		case XESS_QUALITY_SETTING_PERFORMANCE: return "performance";
+		case XESS_QUALITY_SETTING_ULTRA_PERFORMANCE: return "ultra performance";
+		default: return "auto";
+	}
+}
+
+// One XeSS context per input/output size. Its pipelines are built and it is initialised on a
+// worker thread; the game's pass runs until it is ready.
+struct Context {
+	xess_context_handle_t handle = nullptr;
+	uint32_t              in_w = 0, in_h = 0, out_w = 0, out_h = 0;
+	std::atomic<int>      quality {0};
+	std::atomic<int>      status {0}; // 0 preparing, 1 ready, -1 failed
+	std::thread           worker;
+
+	~Context() {
+		// The worker holds a reference too: the last one may be dropped on that thread.
+		if (worker.joinable()) {
+			if (worker.get_id() == std::this_thread::get_id()) {
+				worker.detach();
+			} else {
+				worker.join();
+			}
+		}
+		if (handle != nullptr && GetApi().ready) {
+			GetApi().destroy_context(handle);
+		}
+	}
+};
+
+struct State {
+	uint64_t pass_hash      = 0x2936e5eca99d75e7ull;
+	float    jitter_sign    = 1.0f;
+	bool     depth_inverted = false;
+	int      quality        = 0; // 0: auto, else xess_quality_settings_t
+	bool     log            = false;
+	uint32_t init_flags     = 0;
+
+	// Created at device creation (OnDeviceReady) with its pipeline build started; the first size
+	// takes it over.
+	std::shared_ptr<Context> spare;
+	std::shared_ptr<Context> current;
+	VkInstance               instance = VK_NULL_HANDLE;
+	VkPhysicalDevice         physical = VK_NULL_HANDLE;
+	VkDevice                 device   = VK_NULL_HANDLE;
+
+	uint32_t last_frame = 0;
+	uint64_t executions = 0;
+	std::array<uint64_t, static_cast<size_t>(Fallback::Count)> fallbacks {};
+	int64_t  print_ns = 0;
+	float    last_jitter[2] {};
+};
+
+State& Get() {
+	static State state = [] {
+		State      s;
+		const auto env = [](const char* xess, const char* dlss) -> const char* {
+			const char* value = std::getenv(xess);
+			return value != nullptr ? value : std::getenv(dlss);
+		};
+		if (const char* value = env("ASTROHYBRID_XESS_PASS", "ASTROHYBRID_DLSS_PASS"); value != nullptr) {
+			s.pass_hash = std::strtoull(value, nullptr, 16);
+		}
+		if (const char* value = env("ASTROHYBRID_XESS_JITTER_SIGN", "ASTROHYBRID_DLSS_JITTER_SIGN");
+		    value != nullptr) {
+			s.jitter_sign = std::strtof(value, nullptr) < 0 ? -1.0f : 1.0f;
+		}
+		if (const char* value = env("ASTROHYBRID_XESS_DEPTH_INVERTED", "ASTROHYBRID_DLSS_DEPTH_INVERTED");
+		    value != nullptr) {
+			s.depth_inverted = std::strcmp(value, "0") != 0;
+		}
+		if (const char* value = std::getenv("ASTROHYBRID_XESS_QUALITY"); value != nullptr) {
+			const std::string q = value;
+			s.quality = q == "aa" || q == "native" || q == "dlaa" ? XESS_QUALITY_SETTING_AA
+			            : q == "ultra_quality_plus"             ? XESS_QUALITY_SETTING_ULTRA_QUALITY_PLUS
+			            : q == "ultra_quality"                  ? XESS_QUALITY_SETTING_ULTRA_QUALITY
+			            : q == "quality"                        ? XESS_QUALITY_SETTING_QUALITY
+			            : q == "balanced"                       ? XESS_QUALITY_SETTING_BALANCED
+			            : q == "performance"                    ? XESS_QUALITY_SETTING_PERFORMANCE
+			            : q == "ultra_performance"              ? XESS_QUALITY_SETTING_ULTRA_PERFORMANCE
+			                                                    : 0;
+		}
+		if (const char* value = std::getenv("ASTROHYBRID_XESS_LOG"); value != nullptr) {
+			s.log = std::strcmp(value, "1") == 0;
+		}
+		// HDR colour (the default), low-resolution motion vectors that include the jitter, auto
+		// exposure: as DLSS is created for this pass (dlss.cpp).
+		s.init_flags = XESS_INIT_FLAG_JITTERED_MV | XESS_INIT_FLAG_ENABLE_AUTOEXPOSURE |
+		               (s.depth_inverted ? XESS_INIT_FLAG_INVERTED_DEPTH : 0u);
+		return s;
+	}();
+	return state;
+}
+
+int64_t NowNs() {
+	return std::chrono::duration_cast<std::chrono::nanoseconds>(
+	           std::chrono::steady_clock::now().time_since_epoch())
+	    .count();
+}
+
+void Summary(State& s) {
+	const auto now = NowNs();
+	if (s.print_ns == 0) {
+		s.print_ns = now;
+		return;
+	}
+	if (now - s.print_ns < 10'000'000'000LL) {
+		return;
+	}
+	s.print_ns = now;
+	std::string text;
+	for (size_t i = 0; i < s.fallbacks.size(); i++) {
+		if (s.fallbacks[i] != 0) {
+			text += " " + std::string(FALLBACK_NAMES[i]) + "=" + std::to_string(s.fallbacks[i]);
+		}
+	}
+	const auto& c = s.current;
+	std::printf("XeSS 10s: executions %llu (%ux%u -> %ux%u, %s, jitter %.3f %.3f px) | game pass kept:%s\n",
+	            static_cast<unsigned long long>(s.executions), c ? c->in_w : 0, c ? c->in_h : 0,
+	            c ? c->out_w : 0, c ? c->out_h : 0, c ? QualityName(c->quality.load()) : "-",
+	            static_cast<double>(s.last_jitter[0]), static_cast<double>(s.last_jitter[1]),
+	            text.empty() ? " none" : text.c_str());
+	std::fflush(stdout);
+	s.executions = 0;
+	s.fallbacks  = {};
+}
+
+bool Fail(State& s, Fallback reason) {
+	s.fallbacks[static_cast<size_t>(reason)]++;
+	Summary(s);
+	return false;
+}
+
+std::shared_ptr<Context> CreateContext(State& s) {
+	const auto& api     = GetApi();
+	auto        context = std::make_shared<Context>();
+	const auto  result  = api.create_context(s.instance, s.physical, s.device, &context->handle);
+	if (result != XESS_RESULT_SUCCESS || context->handle == nullptr) {
+		std::printf("XeSS: context creation failed (%s)\n", ResultName(result));
+		std::fflush(stdout);
+		context->handle = nullptr;
+		return nullptr;
+	}
+	if (api.set_logging != nullptr) {
+		api.set_logging(context->handle, s.log ? XESS_LOGGING_LEVEL_WARNING : XESS_LOGGING_LEVEL_ERROR,
+		                LogCallback);
+	}
+	return context;
+}
+
+// The preset whose input range holds the game's input size, closest to its optimal size (or the
+// requested one when it accepts this size).
+int PickQuality(const State& s, xess_context_handle_t handle, uint32_t in_w, uint32_t in_h,
+                uint32_t out_w, uint32_t out_h) {
+	const auto&     api = GetApi();
+	const xess_2d_t output {out_w, out_h};
+	int             best      = 0;
+	uint32_t        best_diff = ~0u;
+	for (const auto quality: QUALITIES) {
+		xess_2d_t optimal {};
+		xess_2d_t minimum {};
+		xess_2d_t maximum {};
+		if (api.optimal_input(handle, &output, quality, &optimal, &minimum, &maximum) !=
+		    XESS_RESULT_SUCCESS) {
+			continue;
+		}
+		if (in_w < minimum.x || in_h < minimum.y || in_w > maximum.x || in_h > maximum.y) {
+			continue;
+		}
+		if (s.quality == quality) {
+			return quality;
+		}
+		const uint32_t diff = optimal.x > in_w ? optimal.x - in_w : in_w - optimal.x;
+		if (diff < best_diff) {
+			best      = quality;
+			best_diff = diff;
+		}
+	}
+	if (s.quality != 0 && best != 0) {
+		std::printf("XeSS: preset %s does not take %ux%u -> %ux%u, using %s\n", QualityName(s.quality),
+		            in_w, in_h, out_w, out_h, QualityName(best));
+	}
+	return best;
+}
+
+// Worker: waits for (or runs) the pipeline build, picks the preset and initialises the context.
+// xessVKInit may upload data through a device queue, so Kyty's queues are held meanwhile.
+void Prepare(const std::shared_ptr<Context>& context, GraphicContext* graphics, bool build_started) {
+	auto&       s   = Get();
+	const auto& api = GetApi();
+	const auto  t0  = NowNs();
+	if (!build_started) {
+		const auto built = api.build_pipelines(context->handle, VK_NULL_HANDLE, true, s.init_flags);
+		if (built != XESS_RESULT_SUCCESS) {
+			std::printf("XeSS: pipeline build failed (%s)\n", ResultName(built));
+			std::fflush(stdout);
+			context->status.store(-1, std::memory_order_release);
+			return;
+		}
+	} else {
+		while (api.build_status(context->handle) == XESS_RESULT_ERROR_OPERATION_IN_PROGRESS) {
+			std::this_thread::sleep_for(std::chrono::milliseconds(5));
+		}
+	}
+	const int quality = PickQuality(s, context->handle, context->in_w, context->in_h, context->out_w,
+	                                context->out_h);
+	if (quality == 0) {
+		std::printf("XeSS: no preset takes %ux%u -> %ux%u; the game's own upscaling stays\n",
+		            context->in_w, context->in_h, context->out_w, context->out_h);
+		std::fflush(stdout);
+		context->status.store(-1, std::memory_order_release);
+		return;
+	}
+	context->quality = quality;
+	xess_vk_init_params_t params {};
+	params.outputResolution = {context->out_w, context->out_h};
+	params.qualitySetting   = static_cast<xess_quality_settings_t>(quality);
+	params.initFlags        = s.init_flags;
+	xess_result_t result    = XESS_RESULT_ERROR_UNKNOWN;
+	{
+		graphics->queue_mutex.Lock();
+		if (graphics->side_queue != nullptr) {
+			graphics->side_queue_mutex.Lock();
+		}
+		result = api.init(context->handle, &params);
+		if (graphics->side_queue != nullptr) {
+			graphics->side_queue_mutex.Unlock();
+		}
+		graphics->queue_mutex.Unlock();
+	}
+	if (result != XESS_RESULT_SUCCESS) {
+		std::printf("XeSS: initialisation failed (%s) for %ux%u -> %ux%u\n", ResultName(result),
+		            context->in_w, context->in_h, context->out_w, context->out_h);
+		std::fflush(stdout);
+		context->status.store(-1, std::memory_order_release);
+		return;
+	}
+	// The game's motion vectors are in UV and point from the previous position to the current
+	// one; XeSS wants pixels from the current to the previous (dlss.h).
+	api.set_velocity_scale(context->handle, -static_cast<float>(context->in_w),
+	                       -static_cast<float>(context->in_h));
+	std::printf("XeSS: Super Resolution ready, %ux%u -> %ux%u, preset %s, depth inverted %d, jitter "
+	            "sign %+.0f (%.0f ms)\n",
+	            context->in_w, context->in_h, context->out_w, context->out_h, QualityName(quality),
+	            s.depth_inverted ? 1 : 0, static_cast<double>(s.jitter_sign),
+	            static_cast<double>(NowNs() - t0) / 1e6);
+	std::fflush(stdout);
+	context->status.store(1, std::memory_order_release);
+}
+
+// ---------------------------------------------------------------------------------------------
+// Device feature merging (Xess::DeviceFeatures).
+
+struct FeatureHeader {
+	VkStructureType sType;
+	void*           pNext;
+};
+
+VkBool32* Bools(void* structure) {
+	return reinterpret_cast<VkBool32*>(static_cast<uint8_t*>(structure) + sizeof(FeatureHeader));
+}
+
+void Or(VkBool32& target, VkBool32 value) {
+	target = (target != VK_FALSE || value != VK_FALSE) ? VK_TRUE : VK_FALSE;
+}
+
+// Sizes of the feature structures XeSS may ask for, so they can be checked against the device and
+// copied (0: unknown).
+size_t FeatureSize(VkStructureType type) {
+	switch (type) {
+#define KYTY_XESS_SIZE(TYPE, STRUCT)                                                                \
+	case TYPE: return sizeof(STRUCT);
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES, VkPhysicalDeviceVulkan11Features)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES, VkPhysicalDeviceVulkan12Features)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES, VkPhysicalDeviceVulkan13Features)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MUTABLE_DESCRIPTOR_TYPE_FEATURES_EXT,
+		               VkPhysicalDeviceMutableDescriptorTypeFeaturesEXT)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_16BIT_STORAGE_FEATURES, VkPhysicalDevice16BitStorageFeatures)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_DRAW_PARAMETERS_FEATURES,
+		               VkPhysicalDeviceShaderDrawParametersFeatures)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_8BIT_STORAGE_FEATURES, VkPhysicalDevice8BitStorageFeatures)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_FLOAT16_INT8_FEATURES,
+		               VkPhysicalDeviceShaderFloat16Int8Features)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_ATOMIC_INT64_FEATURES,
+		               VkPhysicalDeviceShaderAtomicInt64Features)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SCALAR_BLOCK_LAYOUT_FEATURES,
+		               VkPhysicalDeviceScalarBlockLayoutFeatures)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_SUBGROUP_EXTENDED_TYPES_FEATURES,
+		               VkPhysicalDeviceShaderSubgroupExtendedTypesFeatures)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_BUFFER_DEVICE_ADDRESS_FEATURES,
+		               VkPhysicalDeviceBufferDeviceAddressFeatures)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_MEMORY_MODEL_FEATURES,
+		               VkPhysicalDeviceVulkanMemoryModelFeatures)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TIMELINE_SEMAPHORE_FEATURES,
+		               VkPhysicalDeviceTimelineSemaphoreFeatures)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_UNIFORM_BUFFER_STANDARD_LAYOUT_FEATURES,
+		               VkPhysicalDeviceUniformBufferStandardLayoutFeatures)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_INTEGER_DOT_PRODUCT_FEATURES,
+		               VkPhysicalDeviceShaderIntegerDotProductFeatures)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_SIZE_CONTROL_FEATURES,
+		               VkPhysicalDeviceSubgroupSizeControlFeatures)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SYNCHRONIZATION_2_FEATURES,
+		               VkPhysicalDeviceSynchronization2Features)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DYNAMIC_RENDERING_FEATURES,
+		               VkPhysicalDeviceDynamicRenderingFeatures)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MAINTENANCE_4_FEATURES, VkPhysicalDeviceMaintenance4Features)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_DEMOTE_TO_HELPER_INVOCATION_FEATURES,
+		               VkPhysicalDeviceShaderDemoteToHelperInvocationFeatures)
+		KYTY_XESS_SIZE(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_COOPERATIVE_MATRIX_FEATURES_KHR,
+		               VkPhysicalDeviceCooperativeMatrixFeaturesKHR)
+#undef KYTY_XESS_SIZE
+		default: return 0;
+	}
+}
