+struct CoreFeatures {
+	VkPhysicalDeviceFeatures*         v10 = nullptr;
+	VkPhysicalDeviceVulkan11Features* v11 = nullptr;
+	VkPhysicalDeviceVulkan12Features* v12 = nullptr;
+	VkPhysicalDeviceVulkan13Features* v13 = nullptr;
+};
+
+// A structure promoted to Vulkan 1.1/1.2/1.3 must not be chained next to that version's
+// VkPhysicalDeviceVulkan1xFeatures: its fields go there. False: not a promoted structure this
+// knows, or that version's structure is not in the chain.
+bool MergePromoted(const FeatureHeader* source, const CoreFeatures& core) {
+#define KYTY_XESS_FIELD(CORE, STRUCT, FIELD) Or(core.CORE->FIELD, reinterpret_cast<const STRUCT*>(source)->FIELD)
+	switch (source->sType) {
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_16BIT_STORAGE_FEATURES:
+			if (core.v11 == nullptr) return false;
+			KYTY_XESS_FIELD(v11, VkPhysicalDevice16BitStorageFeatures, storageBuffer16BitAccess);
+			KYTY_XESS_FIELD(v11, VkPhysicalDevice16BitStorageFeatures, uniformAndStorageBuffer16BitAccess);
+			KYTY_XESS_FIELD(v11, VkPhysicalDevice16BitStorageFeatures, storagePushConstant16);
+			KYTY_XESS_FIELD(v11, VkPhysicalDevice16BitStorageFeatures, storageInputOutput16);
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_DRAW_PARAMETERS_FEATURES:
+			if (core.v11 == nullptr) return false;
+			KYTY_XESS_FIELD(v11, VkPhysicalDeviceShaderDrawParametersFeatures, shaderDrawParameters);
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_8BIT_STORAGE_FEATURES:
+			if (core.v12 == nullptr) return false;
+			KYTY_XESS_FIELD(v12, VkPhysicalDevice8BitStorageFeatures, storageBuffer8BitAccess);
+			KYTY_XESS_FIELD(v12, VkPhysicalDevice8BitStorageFeatures, uniformAndStorageBuffer8BitAccess);
+			KYTY_XESS_FIELD(v12, VkPhysicalDevice8BitStorageFeatures, storagePushConstant8);
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_FLOAT16_INT8_FEATURES:
+			if (core.v12 == nullptr) return false;
+			KYTY_XESS_FIELD(v12, VkPhysicalDeviceShaderFloat16Int8Features, shaderFloat16);
+			KYTY_XESS_FIELD(v12, VkPhysicalDeviceShaderFloat16Int8Features, shaderInt8);
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_ATOMIC_INT64_FEATURES:
+			if (core.v12 == nullptr) return false;
+			KYTY_XESS_FIELD(v12, VkPhysicalDeviceShaderAtomicInt64Features, shaderBufferInt64Atomics);
+			KYTY_XESS_FIELD(v12, VkPhysicalDeviceShaderAtomicInt64Features, shaderSharedInt64Atomics);
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SCALAR_BLOCK_LAYOUT_FEATURES:
+			if (core.v12 == nullptr) return false;
+			KYTY_XESS_FIELD(v12, VkPhysicalDeviceScalarBlockLayoutFeatures, scalarBlockLayout);
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_SUBGROUP_EXTENDED_TYPES_FEATURES:
+			if (core.v12 == nullptr) return false;
+			KYTY_XESS_FIELD(v12, VkPhysicalDeviceShaderSubgroupExtendedTypesFeatures, shaderSubgroupExtendedTypes);
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_BUFFER_DEVICE_ADDRESS_FEATURES:
+			if (core.v12 == nullptr) return false;
+			KYTY_XESS_FIELD(v12, VkPhysicalDeviceBufferDeviceAddressFeatures, bufferDeviceAddress);
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_MEMORY_MODEL_FEATURES:
+			if (core.v12 == nullptr) return false;
+			KYTY_XESS_FIELD(v12, VkPhysicalDeviceVulkanMemoryModelFeatures, vulkanMemoryModel);
+			KYTY_XESS_FIELD(v12, VkPhysicalDeviceVulkanMemoryModelFeatures, vulkanMemoryModelDeviceScope);
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TIMELINE_SEMAPHORE_FEATURES:
+			if (core.v12 == nullptr) return false;
+			KYTY_XESS_FIELD(v12, VkPhysicalDeviceTimelineSemaphoreFeatures, timelineSemaphore);
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_UNIFORM_BUFFER_STANDARD_LAYOUT_FEATURES:
+			if (core.v12 == nullptr) return false;
+			KYTY_XESS_FIELD(v12, VkPhysicalDeviceUniformBufferStandardLayoutFeatures, uniformBufferStandardLayout);
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_INTEGER_DOT_PRODUCT_FEATURES:
+			if (core.v13 == nullptr) return false;
+			KYTY_XESS_FIELD(v13, VkPhysicalDeviceShaderIntegerDotProductFeatures, shaderIntegerDotProduct);
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_SIZE_CONTROL_FEATURES:
+			if (core.v13 == nullptr) return false;
+			KYTY_XESS_FIELD(v13, VkPhysicalDeviceSubgroupSizeControlFeatures, subgroupSizeControl);
+			KYTY_XESS_FIELD(v13, VkPhysicalDeviceSubgroupSizeControlFeatures, computeFullSubgroups);
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SYNCHRONIZATION_2_FEATURES:
+			if (core.v13 == nullptr) return false;
+			KYTY_XESS_FIELD(v13, VkPhysicalDeviceSynchronization2Features, synchronization2);
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DYNAMIC_RENDERING_FEATURES:
+			if (core.v13 == nullptr) return false;
+			KYTY_XESS_FIELD(v13, VkPhysicalDeviceDynamicRenderingFeatures, dynamicRendering);
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MAINTENANCE_4_FEATURES:
+			if (core.v13 == nullptr) return false;
+			KYTY_XESS_FIELD(v13, VkPhysicalDeviceMaintenance4Features, maintenance4);
+			return true;
+		case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_DEMOTE_TO_HELPER_INVOCATION_FEATURES:
+			if (core.v13 == nullptr) return false;
+			KYTY_XESS_FIELD(v13, VkPhysicalDeviceShaderDemoteToHelperInvocationFeatures,
+			                shaderDemoteToHelperInvocation);
+			return true;
+		default: return false;
+	}
+#undef KYTY_XESS_FIELD
+}
