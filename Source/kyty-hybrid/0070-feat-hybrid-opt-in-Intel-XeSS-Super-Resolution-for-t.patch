diff --git a/src/graphics/host_gpu/renderer/xess.h b/src/graphics/host_gpu/renderer/xess.h
new file mode 100644
index 00000000..da1341f8
--- /dev/null
+++ b/src/graphics/host_gpu/renderer/xess.h
@@ -0,0 +1,74 @@
+#ifndef EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_XESS_H_
+#define EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_XESS_H_
+
+#include <vulkan/vulkan.h>
+
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+// ASTROHYBRID_XESS=1 (default 0): Intel XeSS Super Resolution (XeSS 3 SDK, Vulkan path) in place of
+// Astro Bot's own temporal upscale pass (RenderExecutor::TryXessUpscale, xess.cpp). It replaces the
+// same pass as ASTROHYBRID_DLSS (dlss.h: pixel shader 2936e5eca99d75e7) with the same inputs: the
+// SMAA-resolved colour, the game's UV motion vectors (previous to current, jitter included), the
+// depth attachment the G-buffer draws used, and the jitter and sizes from the pass's constants.
+// XeSS writes the game's output target, which every later pass reads.
+//
+// Unlike DLSS it runs on every GPU with DP4a (Intel Arc and Iris Xe use their XMX/DP4a paths,
+// NVIDIA GTX 10 and newer, AMD RDNA) and needs no CUDA address window. Runtime: libxess.dll from
+// the XeSS SDK (https://github.com/intel/xess, redistributable) next to the game or in
+// ASTROHYBRID_XESS_PATH; it is loaded at run time, so a build without it still starts and keeps
+// the game's pass. XeSS frame generation and Xe Low Latency are D3D12-only in the SDK, so this
+// Vulkan port has XeSS Super Resolution only.
+//
+// The XeSS context is created with the device and builds its pipelines in the background; until
+// they are ready (and whenever anything is missing or inconsistent: no libxess.dll, an unsupported
+// device, another size, no depth, the game not using motion vectors this frame) the game's own
+// pass runs. ASTROHYBRID_DLSS and ASTROHYBRID_FSR (dlss.h) take precedence: XeSS runs only when
+// neither is set.
+//
+// Options: ASTROHYBRID_XESS_QUALITY=auto|aa|ultra_quality_plus|ultra_quality|quality|balanced|
+// performance|ultra_performance (default auto: the preset whose input range holds the game's
+// input size, closest to its optimal size; the game decides the input size itself);
+// ASTROHYBRID_XESS_JITTER_SIGN=1|-1 (default ASTROHYBRID_DLSS_JITTER_SIGN, else 1);
+// ASTROHYBRID_XESS_DEPTH_INVERTED=1|0 (default ASTROHYBRID_DLSS_DEPTH_INVERTED, else 0);
+// ASTROHYBRID_XESS_PASS (hex hash, default the DLSS pass); ASTROHYBRID_XESS_LOG=1 (XeSS's own
+// warnings and errors on the console). One "XeSS 10s:" console line every 10 s with executions
+// and fallbacks by reason.
+namespace Libs::Graphics::Xess {
+
+[[nodiscard]] bool Requested();
+
+// Before instance creation: the instance extensions XeSS needs (empty when not requested or
+// libxess.dll is missing).
+[[nodiscard]] std::vector<const char*> InstanceExtensions();
+
+// After the physical device is chosen: the device extensions XeSS needs.
+[[nodiscard]] std::vector<const char*> DeviceExtensions(VkInstance instance, VkPhysicalDevice physical);
+
+// Device creation: the features XeSS needs, merged into a VkDeviceCreateInfo chain. Kyty enables
+// VkPhysicalDeviceFeatures through pEnabledFeatures and the Vulkan 1.1/1.2/1.3 feature structures:
+// XeSS's requests go into those (promoted extension structures into their core fields), other
+// structures are appended; only features the device supports are turned on. Keep the object
+// alive until vkCreateDevice returned.
+class DeviceFeatures final {
+public:
+	DeviceFeatures();
+	~DeviceFeatures();
+	DeviceFeatures(const DeviceFeatures&)            = delete;
+	DeviceFeatures& operator=(const DeviceFeatures&) = delete;
+
+	void Merge(VkInstance instance, VkPhysicalDevice physical, VkDeviceCreateInfo& info,
+	           VkPhysicalDeviceFeatures& features);
+
+private:
+	struct Impl;
+	std::unique_ptr<Impl> m_impl;
+};
+
+// After device creation: creates the XeSS context and starts its pipeline build.
+void OnDeviceReady(VkInstance instance, VkPhysicalDevice physical, VkDevice device);
+
+} // namespace Libs::Graphics::Xess
+
+#endif // EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_XESS_H_
