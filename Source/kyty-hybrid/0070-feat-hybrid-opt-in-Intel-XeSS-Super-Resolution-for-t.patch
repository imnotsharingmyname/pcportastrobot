@@ -34,6 +34,7 @@
 #include "graphics/presentation/window.h"
 #include "graphics/presentation/window/lowLatency.h"
 #include "graphics/host_gpu/renderer/dlss.h"
+#include "graphics/host_gpu/renderer/xess.h"
 #include "graphics/host_gpu/renderer/frameGen.h"
 #include "graphics/host_gpu/renderer/fsr.h"
 #include "graphics/presentation/window/windowInternal.h"
@@ -1518,6 +1519,16 @@ static vk::Device VulkanCreateDevice(GraphicContext& graphics,
 	create_info.ppEnabledExtensionNames = device_extensions.data();
 	create_info.pEnabledFeatures        = &device_features;
 
+	// ASTROHYBRID_XESS (renderer/xess.h): the features XeSS needs, merged into this chain; the
