+bool Requested() {
+	static const bool requested = [] {
+		const char* value = std::getenv("ASTROHYBRID_XESS");
+		return value != nullptr && std::strcmp(value, "1") == 0;
+	}();
+	return requested;
+}
+
+std::vector<const char*> InstanceExtensions() {
+	std::vector<const char*> names;
+	const auto&              api = GetApi();
+	if (!api.ready) {
+		return names;
+	}
+	uint32_t           count       = 0;
+	const char* const* extensions  = nullptr;
+	uint32_t           min_version = 0;
+	const auto         result      = api.instance_extensions(&count, &extensions, &min_version);
+	if (result != XESS_RESULT_SUCCESS) {
+		std::printf("XeSS: no Vulkan instance requirements (%s)\n", ResultName(result));
+		std::fflush(stdout);
+		return names;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		std::printf("XeSS: instance extension %s\n", extensions[i]);
+		names.push_back(extensions[i]);
+	}
+	if (min_version > VK_API_VERSION_1_3) {
+		std::printf("XeSS: needs Vulkan %u.%u, Kyty creates 1.3\n", VK_API_VERSION_MAJOR(min_version),
+		            VK_API_VERSION_MINOR(min_version));
+	}
+	std::fflush(stdout);
+	return names;
+}
+
+std::vector<const char*> DeviceExtensions(VkInstance instance, VkPhysicalDevice physical) {
+	std::vector<const char*> names;
+	const auto&              api = GetApi();
+	if (!api.ready) {
+		return names;
+	}
+	uint32_t           count      = 0;
+	const char* const* extensions = nullptr;
+	const auto         result     = api.device_extensions(instance, physical, &count, &extensions);
+	if (result != XESS_RESULT_SUCCESS) {
+		std::printf("XeSS: this GPU cannot run XeSS (%s); the game's own upscaling stays\n",
+		            ResultName(result));
+		std::fflush(stdout);
+		return names;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		names.push_back(extensions[i]);
+	}
+	return names;
+}
+
+struct DeviceFeatures::Impl {
+	std::vector<std::unique_ptr<uint8_t[]>> copies;
+};
+
+DeviceFeatures::DeviceFeatures(): m_impl(std::make_unique<Impl>()) {}
+
+DeviceFeatures::~DeviceFeatures() = default;
+
+void DeviceFeatures::Merge(VkInstance instance, VkPhysicalDevice physical, VkDeviceCreateInfo& info,
+                           VkPhysicalDeviceFeatures& features) {
+	const auto& api = GetApi();
+	if (!api.ready) {
+		return;
+	}
+	void*      requested = nullptr;
+	const auto result    = api.device_features(instance, physical, &requested);
+	if (result != XESS_RESULT_SUCCESS) {
+		std::printf("XeSS: no device feature requirements (%s)\n", ResultName(result));
+		std::fflush(stdout);
+		return;
+	}
+	CoreFeatures core;
+	core.v10 = &features;
+	for (auto* node = static_cast<FeatureHeader*>(const_cast<void*>(info.pNext)); node != nullptr;
+	     node       = static_cast<FeatureHeader*>(node->pNext)) {
+		switch (node->sType) {
+			case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES:
+				core.v11 = reinterpret_cast<VkPhysicalDeviceVulkan11Features*>(node);
+				break;
+			case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES:
+				core.v12 = reinterpret_cast<VkPhysicalDeviceVulkan12Features*>(node);
+				break;
+			case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES:
+				core.v13 = reinterpret_cast<VkPhysicalDeviceVulkan13Features*>(node);
+				break;
+			default: break;
+		}
+	}
+	const auto find = [&](VkStructureType type) -> FeatureHeader* {
+		for (auto* node = static_cast<FeatureHeader*>(const_cast<void*>(info.pNext)); node != nullptr;
+		     node       = static_cast<FeatureHeader*>(node->pNext)) {
+			if (node->sType == type) {
+				return node;
+			}
+		}
+		return nullptr;
+	};
+
+	// XeSS's chain is walked first: appending copies to Kyty's chain must not change it.
+	std::vector<FeatureHeader*> nodes;
+	for (auto* node = static_cast<FeatureHeader*>(requested); node != nullptr;
+	     node       = static_cast<FeatureHeader*>(node->pNext)) {
+		nodes.push_back(node);
+	}
+	for (auto* node: nodes) {
+		// What the device supports of it: only those features are turned on.
+		if (node->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2) {
+			VkPhysicalDeviceFeatures2 supported {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+			VULKAN_HPP_DEFAULT_DISPATCHER.vkGetPhysicalDeviceFeatures2(physical, &supported);
+			const auto* wanted = reinterpret_cast<const VkPhysicalDeviceFeatures2*>(node);
+			auto*       target = reinterpret_cast<VkBool32*>(&features);
+			const auto* want   = reinterpret_cast<const VkBool32*>(&wanted->features);
+			const auto* have   = reinterpret_cast<const VkBool32*>(&supported.features);
+			for (size_t i = 0; i < sizeof(VkPhysicalDeviceFeatures) / sizeof(VkBool32); i++) {
+				Or(target[i], want[i] != VK_FALSE && have[i] != VK_FALSE ? VK_TRUE : VK_FALSE);
+			}
+			continue;
+		}
+		const size_t size = FeatureSize(node->sType);
+		if (size == 0) {
+			// Unknown to this build: chained as XeSS gave it, unless Kyty has one.
+			if (find(node->sType) == nullptr) {
+				std::printf("XeSS: device feature structure %d chained unchecked\n",
+				            static_cast<int>(node->sType));
+				node->pNext = const_cast<void*>(info.pNext);
+				info.pNext  = node;
+			}
+			continue;
+		}
+		auto copy = std::make_unique<uint8_t[]>(size);
+		std::memcpy(copy.get(), node, size);
+		auto* wanted = reinterpret_cast<FeatureHeader*>(copy.get());
+		{
+			auto query = std::make_unique<uint8_t[]>(size);
+			std::memset(query.get(), 0, size);
+			reinterpret_cast<FeatureHeader*>(query.get())->sType = node->sType;
+			VkPhysicalDeviceFeatures2 chain {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+			chain.pNext = query.get();
+			VULKAN_HPP_DEFAULT_DISPATCHER.vkGetPhysicalDeviceFeatures2(physical, &chain);
+			auto*       want  = Bools(wanted);
+			const auto* have  = Bools(query.get());
+			const auto  count = (size - sizeof(FeatureHeader)) / sizeof(VkBool32);
+			for (size_t i = 0; i < count; i++) {
+				want[i] = want[i] != VK_FALSE && have[i] != VK_FALSE ? VK_TRUE : VK_FALSE;
+			}
+		}
+		if (auto* existing = find(node->sType); existing != nullptr) {
+			auto*       target = Bools(existing);
+			const auto* want   = Bools(wanted);
+			for (size_t i = 0; i < (size - sizeof(FeatureHeader)) / sizeof(VkBool32); i++) {
+				Or(target[i], want[i]);
+			}
+			continue;
+		}
+		if (MergePromoted(wanted, core)) {
+			continue;
+		}
+		wanted->pNext = const_cast<void*>(info.pNext);
+		info.pNext    = wanted;
+		m_impl->copies.push_back(std::move(copy));
+	}
+	std::printf("XeSS: device features merged\n");
+	std::fflush(stdout);
+}
+
+void OnDeviceReady(VkInstance instance, VkPhysicalDevice physical, VkDevice device) {
+	const auto& api = GetApi();
+	if (!api.ready) {
+		return;
+	}
+	auto& s    = Get();
+	s.instance = instance;
+	s.physical = physical;
+	s.device   = device;
+	auto context = CreateContext(s);
+	if (context == nullptr) {
+		return;
+	}
+	xess_version_t xefx {};
+	if (api.xefx_version(context->handle, &xefx) == XESS_RESULT_SUCCESS && xefx.major != 0) {
+		std::printf("XeSS: Intel XeFX %u.%u.%u (XMX path)\n", xefx.major, xefx.minor, xefx.patch);
+	}
+	if (api.optimal_driver(context->handle) == XESS_RESULT_WARNING_OLD_DRIVER) {
+		std::printf("XeSS: the graphics driver is older than XeSS recommends\n");
+	}
+	// Non-blocking: the pipelines compile while the game boots.
+	const auto result = api.build_pipelines(context->handle, VK_NULL_HANDLE, false, s.init_flags);
+	if (result != XESS_RESULT_SUCCESS) {
+		std::printf("XeSS: pipeline build failed to start (%s)\n", ResultName(result));
+		std::fflush(stdout);
+		return;
+	}
+	std::printf("XeSS: context created, pipelines building\n");
+	std::fflush(stdout);
+	s.spare = std::move(context);
+}
+
+} // namespace Xess
+
+bool RenderExecutor::TryXessUpscale(CommandBuffer& buffer, PreparedBindings& pixel, ImageId output) {
+	if (!Xess::Requested() || pixel.runtime == nullptr || !*pixel.runtime) {
+		return false;
+	}
+	auto& s = Get();
+	if (pixel.runtime->program->shader_hash != s.pass_hash) {
+		return false;
+	}
+	const auto& api = GetApi();
+	if (!api.ready) {
+		return Fail(s, Fallback::NotLoaded);
+	}
+	if (s.device == VK_NULL_HANDLE) {
+		return Fail(s, Fallback::NoContext);
+	}
+	// The pass's bindings: motion vectors, colour, history; its constants (dlss.h).
+	if (pixel.images.size() < 2 || !output || pixel.buffer_sources.empty() ||
+	    pixel.buffer_sources[0].address == 0 || pixel.buffer_sources[0].size < 56) {
+		return Fail(s, Fallback::Bindings);
+	}
+	const auto* cb = reinterpret_cast<const uint32_t*>(pixel.buffer_sources[0].address);
+	float       jitter_uv[2];
+	std::memcpy(jitter_uv, cb, sizeof(jitter_uv));
+	const uint32_t out_w = cb[4], out_h = cb[5], in_w = cb[6], in_h = cb[7], frame = cb[11];
+	if (cb[13] == 0) {
+		return Fail(s, Fallback::NoMotionVectors);
+	}
+	auto&      cache    = m_context.GetTextureCache();
+	const auto mv_id    = pixel.images[0].image_id;
+	const auto color_id = pixel.images[1].image_id;
+	const auto depth_id = UpscalerDepthFor(mv_id);
+	if (!depth_id || cache.m_slot_images.try_get(depth_id) == nullptr) {
+		return Fail(s, Fallback::NoDepth);
+	}
+	auto&      mv    = cache.GetImage(mv_id);
+	auto&      color = cache.GetImage(color_id);
+	auto&      depth = cache.GetImage(depth_id);
+	auto&      out   = cache.GetImage(output);
+	const auto same  = [](const Image& image, uint32_t w, uint32_t h) {
+		return image.info.extent.width == w && image.info.extent.height == h &&
+		       image.backing.image != nullptr && image.info.samples == 1;
+	};
+	if (!same(mv, in_w, in_h) || !same(color, in_w, in_h) || !same(depth, in_w, in_h) ||
+	    !same(out, out_w, out_h) || !depth.info.IsDepth() ||
+	    !(out.backing.usage & vk::ImageUsageFlagBits::eStorage)) {
+		return Fail(s, Fallback::Sizes);
+	}
+
+	// A context for this size: the spare one from device creation, else a new one; both get
+	// ready on a worker while the game's pass keeps running.
+	auto& graphics = m_context.GetGraphics();
+	if (s.current == nullptr || s.current->in_w != in_w || s.current->in_h != in_h ||
+	    s.current->out_w != out_w || s.current->out_h != out_h) {
+		std::shared_ptr<Context> context;
+		bool                     build_started = false;
+		if (s.spare != nullptr) {
+			context       = std::move(s.spare);
+			build_started = true;
+		} else {
+			context = CreateContext(s);
+		}
+		if (context == nullptr) {
+			return Fail(s, Fallback::NoContext);
+		}
+		if (s.current != nullptr) {
+			// Destroyed once this command buffer completed: its earlier executions did too.
+			auto old = std::move(s.current);
+			m_context.GetCommandScheduler().DeferOperation([old]() mutable { old.reset(); });
+		}
+		context->in_w   = in_w;
+		context->in_h   = in_h;
+		context->out_w  = out_w;
+		context->out_h  = out_h;
+		auto* raw       = context.get();
+		auto* target    = &graphics;
+		raw->worker     = std::thread(
+            [context, target, build_started]() { Prepare(context, target, build_started); });
+		s.current    = std::move(context);
+		s.last_frame = 0;
+	}
+	const int status = s.current->status.load(std::memory_order_acquire);
+	if (status == 0) {
+		return Fail(s, Fallback::Warming);
+	}
+	if (status < 0) {
+		return Fail(s, Fallback::InitFailed);
+	}
+
+	// Native recording: outside rendering, the recorder drained (CommandBuffer::Handle). Layouts
+	// as XeSS needs them: inputs sampled, output storage (GENERAL), compute stage.
+	buffer.EndRendering();
+	const auto cmd = buffer.Handle();
+	mv.Transit(vk::ImageLayout::eShaderReadOnlyOptimal, vk::AccessFlagBits2::eShaderSampledRead, {}, cmd);
+	color.Transit(vk::ImageLayout::eShaderReadOnlyOptimal, vk::AccessFlagBits2::eShaderSampledRead, {},
+	              cmd);
+	depth.Transit(vk::ImageLayout::eShaderReadOnlyOptimal, vk::AccessFlagBits2::eShaderSampledRead, {},
+	              cmd);
+	out.Transit(vk::ImageLayout::eGeneral,
+	            vk::AccessFlagBits2::eShaderStorageRead | vk::AccessFlagBits2::eShaderStorageWrite, {},
+	            cmd);
+
+	// Views for this execution, destroyed once the command buffer completed.
+	const auto                   device = graphics.device;
+	std::array<vk::ImageView, 4> views {};
+	const auto make_view = [&](const Image& image, vk::ImageAspectFlags aspect) {
+		vk::ImageViewCreateInfo view_info {};
+		view_info.image            = image.backing.image;
+		view_info.viewType         = vk::ImageViewType::e2D;
+		view_info.format           = image.backing.format;
+		view_info.subresourceRange = vk::ImageSubresourceRange {aspect, 0, 1, 0, 1};
+		vk::ImageView view;
+		return device.createImageView(&view_info, nullptr, &view) == vk::Result::eSuccess ? view
+		                                                                                   : vk::ImageView {};
+	};
+	views[0] = make_view(color, vk::ImageAspectFlagBits::eColor);
+	views[1] = make_view(mv, vk::ImageAspectFlagBits::eColor);
+	views[2] = make_view(depth, vk::ImageAspectFlagBits::eDepth);
+	views[3] = make_view(out, vk::ImageAspectFlagBits::eColor);
+	const auto resource = [](const Image& image, vk::ImageView view, vk::ImageAspectFlags aspect) {
+		xess_vk_image_view_info info {};
+		info.imageView        = static_cast<VkImageView>(view);
+		info.image            = static_cast<VkImage>(image.backing.image);
+		info.subresourceRange = {static_cast<VkImageAspectFlags>(aspect), 0, 1, 0, 1};
+		info.format           = static_cast<VkFormat>(image.backing.format);
+		info.width            = image.info.extent.width;
+		info.height           = image.info.extent.height;
+		return info;
+	};
+	bool execute_ok = views[0] && views[1] && views[2] && views[3];
+	if (execute_ok) {
+		xess_vk_execute_params_t params {};
+		params.colorTexture    = resource(color, views[0], vk::ImageAspectFlagBits::eColor);
+		params.velocityTexture = resource(mv, views[1], vk::ImageAspectFlagBits::eColor);
+		params.depthTexture    = resource(depth, views[2], vk::ImageAspectFlagBits::eDepth);
+		params.outputTexture   = resource(out, views[3], vk::ImageAspectFlagBits::eColor);
+		// Jitter in input pixels, as for DLSS (dlss.h).
+		params.jitterOffsetX = s.jitter_sign * jitter_uv[0] * static_cast<float>(in_w);
+		params.jitterOffsetY = s.jitter_sign * jitter_uv[1] * static_cast<float>(in_h);
+		params.exposureScale = 1.0f;
+		params.resetHistory  = (s.last_frame == 0 || frame != s.last_frame + 1) ? 1u : 0u;
+		params.inputWidth    = in_w;
+		params.inputHeight   = in_h;
+		s.last_frame         = frame;
+		s.last_jitter[0]     = params.jitterOffsetX;
+		s.last_jitter[1]     = params.jitterOffsetY;
+		const auto result = api.execute(s.current->handle, static_cast<VkCommandBuffer>(cmd), &params);
+		if (result != XESS_RESULT_SUCCESS) {
+			static std::atomic<uint32_t> logged {0};
+			if (logged.fetch_add(1) < 8) {
+				std::printf("XeSS: execution failed (%s)\n", ResultName(result));
+				std::fflush(stdout);
+			}
+			execute_ok = false;
+		}
+	}
+	buffer.ForgetBoundState();
+	m_context.GetCommandScheduler().DeferOperation([device, views]() {
+		for (const auto view: views) {
+			if (view) {
+				device.destroyImageView(view);
+			}
+		}
+	});
+	if (!execute_ok) {
+		// The layouts changed, nothing was written: the game's pass still draws the output.
+		return Fail(s, Fallback::ExecuteFailed);
+	}
+	// The output now holds XeSS's image: a GPU write of the target, as the draw's would be.
+	out.NoteContentWrite();
+	cache.CommitGpuWrite(out);
+	s.executions++;
+	Summary(s);
+	return true;
+}
+
+} // namespace Libs::Graphics
+
+#else // KYTY_XESS_HEADERS
+
+// Without the SDK headers (unit-test targets): XeSS is never requested and the game's pass runs.
+namespace Libs::Graphics {
+
+namespace Xess {
+
+bool Requested() {
+	return false;
+}
+
+std::vector<const char*> InstanceExtensions() {
+	return {};
+}
+
+std::vector<const char*> DeviceExtensions(VkInstance /*instance*/, VkPhysicalDevice /*physical*/) {
+	return {};
+}
+
+struct DeviceFeatures::Impl {};
+
+DeviceFeatures::DeviceFeatures(): m_impl(std::make_unique<Impl>()) {}
+
+DeviceFeatures::~DeviceFeatures() = default;
+
+void DeviceFeatures::Merge(VkInstance /*instance*/, VkPhysicalDevice /*physical*/,
+                           VkDeviceCreateInfo& /*info*/, VkPhysicalDeviceFeatures& /*features*/) {}
+
+void OnDeviceReady(VkInstance /*instance*/, VkPhysicalDevice /*physical*/, VkDevice /*device*/) {}
+
+} // namespace Xess
+
+bool RenderExecutor::TryXessUpscale(CommandBuffer& /*buffer*/, PreparedBindings& /*pixel*/,
+                                    ImageId /*output*/) {
+	return false;
+}
+
+} // namespace Libs::Graphics
+
