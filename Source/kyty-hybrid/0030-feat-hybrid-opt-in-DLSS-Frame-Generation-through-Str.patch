+void Copy(sl::float4x4& to, const Mat& from) {
+	for (int r = 0; r < 4; r++) {
+		to.row[r] = sl::float4(from[r * 4 + 0], from[r * 4 + 1], from[r * 4 + 2], from[r * 4 + 3]);
+	}
+}
