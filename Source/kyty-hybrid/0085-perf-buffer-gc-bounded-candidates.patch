From b2836551224d2a9b8b9c2219c4afe1e3969143bf Mon Sep 17 00:00:00 2001
From: AstroHybrid <noreply@localhost>
Date: Thu, 26 Nov 2026 11:42:59 +0000
Subject: [PATCH] Remove bounded buffer-cache GC candidate heap allocations

---
 .../host_gpu/renderer/cache/bufferCache.cpp   | 24 ++++++++++---------
 1 file changed, 13 insertions(+), 11 deletions(-)

diff --git a/src/graphics/host_gpu/renderer/cache/bufferCache.cpp b/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
index b4142423..1bafdcbf 100644
--- a/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
+++ b/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
@@ -5250,21 +5250,22 @@ void BufferCache::RetireUnusedBuffers(uint64_t frame, uint64_t min_age) {
 		return;
 	}
 	const auto            limit_tick = std::prev(newer)->second;
-	std::vector<BufferId> candidates;
-	size_t                scanned = 0;
+	std::array<BufferId, 64> candidates {};
+	size_t candidate_count = 0;
+	size_t scanned = 0;
 	m_lru_cache.ForEachItemBelow(limit_tick, [&](BufferId id) {
 		const auto& buffer = m_slot_buffers[id];
 		if (!buffer.is_deleted && !m_gpu_modified_ranges.Intersects(buffer.CpuAddress(), buffer.Size())) {
-			candidates.push_back(id);
+			candidates[candidate_count++] = id;
 		}
-		return ++scanned >= 4096 || candidates.size() >= 64;
+		return ++scanned >= 4096 || candidate_count >= candidates.size();
 	});
-	if (candidates.empty()) {
+	if (candidate_count == 0) {
 		return;
 	}
 	// As the collector below: settle pending side readbacks before the ownership checks.
 	CompleteAllSideReadbacks();
-	for (const auto id: candidates) {
+	for (const auto id: std::span(candidates).first(candidate_count)) {
 		if (IsBufferInvalid(id)) {
 			continue;
 		}
@@ -5340,8 +5341,9 @@ void BufferCache::RunGarbageCollector() {
 	const uint64_t age        = std::min<uint64_t>(aggressive ? 80 : 160, tick);
 	const size_t   limit      = aggressive ? 64 : 32;
 
-	std::vector<BufferId> dirty_buffers;
-	size_t                retire_count = 0;
+	std::array<BufferId, 64> dirty_buffers {};
+	size_t dirty_count = 0;
+	size_t retire_count = 0;
 	m_lru_cache.ForEachItemBelow(tick - age, [&](BufferId id) {
 		auto& buffer = m_slot_buffers[id];
 		EXIT_IF(buffer.is_deleted);
@@ -5353,7 +5355,7 @@ void BufferCache::RunGarbageCollector() {
 		}
 		if (dirty) {
 			EXIT_IF(!DownloadBufferMemory(buffer, buffer.CpuAddress(), buffer.Size()));
-			dirty_buffers.push_back(id);
+			dirty_buffers[dirty_count++] = id;
 		} else {
 			m_memory_tracker.UntrackMemory(buffer.CpuAddress(), buffer.Size());
 			DeleteBuffer(id);
@@ -5361,7 +5363,7 @@ void BufferCache::RunGarbageCollector() {
 		}
 		return ++retire_count == limit;
 	});
-	if (dirty_buffers.empty()) {
+	if (dirty_count == 0) {
 		return;
 	}
 
@@ -5369,7 +5371,7 @@ void BufferCache::RunGarbageCollector() {
 	const auto completion_tick = m_scheduler.CurrentTick();
 	m_scheduler.Wait(completion_tick);
 	m_scheduler.WaitPriorityOperations(completion_tick);
-	for (const auto id: dirty_buffers) {
+	for (const auto id: std::span(dirty_buffers).first(dirty_count)) {
 		auto& buffer = m_slot_buffers[id];
 		m_memory_tracker.UnmarkRegionAsGpuModified(buffer.CpuAddress(), buffer.Size());
 		if (m_memory_tracker.IsRegionGpuModified(buffer.CpuAddress(), buffer.Size()) ||
