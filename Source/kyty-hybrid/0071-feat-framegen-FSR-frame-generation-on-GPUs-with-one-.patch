@@ -281,15 +286,184 @@ VkResult SubmitGameQueue(uint32_t count, const VkSubmitInfo* submits, VkFence fe
 // vkGetBufferMemoryRequirements2KHR without a null check when the GPU supports dedicated
 // allocations). Kyty's device has them as core Vulkan 1.1+ functions without those extensions
 // enabled, so the loader answers null for the KHR name: the core name is tried then.
+// The functions FSR gets for these calls are wrapped so that it works on more than AMD's driver:
+//  - its graphics pipelines have a static line width of 0, valid only with the wideLines feature
+//    (VUID-VkGraphicsPipelineCreateInfo-pDynamicStates-00749): the width is set to 1;
+//  - its descriptor pools ask for 8,192,000 descriptors of each type, which Intel's driver refuses
+//    (VK_ERROR_OUT_OF_HOST_MEMORY, and the frame generation context fails with
+//    FFX_API_RETURN_ERROR_RUNTIME_ERROR): fewer descriptors per set are asked for, and frame
+//    generation turns off instead of hanging the GPU when FSR cannot allocate its sets;
+//  - failures of the other calls are printed (FSR's runtime reports only an error code).
+PFN_vkCreateGraphicsPipelines g_ffx_create_graphics = nullptr;
+
+void LogFfxFailure(const char* call, VkResult result) {
+	static std::atomic<uint32_t> logged {0};
+	if (result < VK_SUCCESS && logged.fetch_add(1) < 16) {
+		std::printf("FSR FG: %s for FSR failed (VkResult %d)\n", call, static_cast<int>(result));
+		std::fflush(stdout);
+	}
+}
+
+VkResult VKAPI_CALL FfxCreateGraphicsPipelines(VkDevice device, VkPipelineCache cache, uint32_t count,
+                                               const VkGraphicsPipelineCreateInfo* infos,
+                                               const VkAllocationCallbacks* allocator, VkPipeline* pipelines) {
+	std::vector<VkGraphicsPipelineCreateInfo>          fixed(infos, infos + count);
+	std::vector<VkPipelineRasterizationStateCreateInfo> raster(count);
+	for (uint32_t i = 0; i < count; i++) {
+		if (fixed[i].pRasterizationState != nullptr && fixed[i].pRasterizationState->lineWidth == 0.0f) {
+			raster[i]                     = *fixed[i].pRasterizationState;
+			raster[i].lineWidth           = 1.0f;
+			fixed[i].pRasterizationState = &raster[i];
+		}
+	}
+	const auto result = g_ffx_create_graphics(device, cache, count, fixed.data(), allocator, pipelines);
+	LogFfxFailure("vkCreateGraphicsPipelines", result);
+	return result;
+}
+
+// FFX sizes its descriptor pools for 512 descriptors of each type per set (up to 16,000 sets, 8,192,000
+// descriptors of each type); Intel's driver refuses such a pool with VK_ERROR_OUT_OF_HOST_MEMORY, which
+// fails the frame generation context (the driver charges per set as well as per descriptor). FFX uses
+// far less, so a refused pool is asked for again at a size that still covers FFX's real use. A pool
+// that is too small makes vkAllocateDescriptorSets fail (VK_ERROR_OUT_OF_POOL_MEMORY) and the
+// interpolation then hangs the GPU, so failed set allocations turn frame generation off
+// (g_ffx_descriptor_failures).
+PFN_vkCreateDescriptorPool g_ffx_create_pool = nullptr;
+std::atomic<uint32_t>      g_ffx_descriptor_failures {0};
+
+VkResult VKAPI_CALL FfxCreateDescriptorPool(VkDevice device, const VkDescriptorPoolCreateInfo* info,
+                                            const VkAllocationCallbacks* allocator, VkDescriptorPool* pool) {
+	auto result = g_ffx_create_pool(device, info, allocator, pool);
+	if (result >= VK_SUCCESS || info == nullptr) {
+		return result;
+	}
+	std::string sizes;
+	for (uint32_t i = 0; i < info->poolSizeCount; i++) {
+		sizes += " " + std::to_string(info->pPoolSizes[i].type) + ":" + std::to_string(info->pPoolSizes[i].descriptorCount);
+	}
+	std::printf("FSR FG: vkCreateDescriptorPool for FSR failed (VkResult %d): flags 0x%x, max sets %u, type:count%s\n",
+	            static_cast<int>(result), static_cast<unsigned>(info->flags), info->maxSets, sizes.c_str());
+	VkDescriptorPoolCreateInfo        smaller = *info;
+	std::vector<VkDescriptorPoolSize> pool_sizes(info->pPoolSizes, info->pPoolSizes + info->poolSizeCount);
+	smaller.pPoolSizes = pool_sizes.data();
+	// Measured on FSR 3.1.6 frame generation: 720 sets in all (allocated with the context, none while
+	// running), the largest with 19 descriptors. Pools of at most 4096 / 2048 / 1024 sets with 32
+	// descriptors of each type per set cover that with room to spare and cost the driver little.
+	for (const uint32_t sets: {4096u, 2048u, 1024u}) {
+		smaller.maxSets    = std::min(info->maxSets, sets);
+		const uint64_t cap = static_cast<uint64_t>(smaller.maxSets) * 32u;
+		for (uint32_t i = 0; i < info->poolSizeCount; i++) {
+			pool_sizes[i].descriptorCount =
+			    static_cast<uint32_t>(std::min<uint64_t>(info->pPoolSizes[i].descriptorCount, cap));
+		}
+		result = g_ffx_create_pool(device, &smaller, allocator, pool);
+		std::printf("FSR FG: descriptor pool with %u sets of up to 32 descriptors of each type: VkResult %d\n",
+		            smaller.maxSets, static_cast<int>(result));
+		if (result >= VK_SUCCESS) {
+			break;
+		}
+	}
+	std::fflush(stdout);
+	return result;
+}
+
+// FSR's descriptor use: sets allocated and the largest set layout, printed with the context.
+PFN_vkAllocateDescriptorSets      g_ffx_allocate_sets = nullptr;
+PFN_vkCreateDescriptorSetLayout   g_ffx_create_layout = nullptr;
+std::atomic<uint32_t>             g_ffx_sets_allocated {0};
+std::atomic<uint32_t>             g_ffx_largest_layout {0};
+
+VkResult VKAPI_CALL FfxAllocateDescriptorSets(VkDevice device, const VkDescriptorSetAllocateInfo* info,
+                                              VkDescriptorSet* sets) {
+	const auto result = g_ffx_allocate_sets(device, info, sets);
+	if (result >= VK_SUCCESS) {
+		g_ffx_sets_allocated.fetch_add(info->descriptorSetCount);
+	} else {
+		g_ffx_descriptor_failures.fetch_add(1);
+		LogFfxFailure("vkAllocateDescriptorSets", result);
+	}
+	return result;
+}
+
+VkResult VKAPI_CALL FfxCreateDescriptorSetLayout(VkDevice device, const VkDescriptorSetLayoutCreateInfo* info,
+                                                 const VkAllocationCallbacks* allocator, VkDescriptorSetLayout* layout) {
+	uint32_t descriptors = 0;
+	for (uint32_t i = 0; i < info->bindingCount; i++) {
+		descriptors += info->pBindings[i].descriptorCount;
+	}
+	uint32_t largest = g_ffx_largest_layout.load();
+	while (descriptors > largest && !g_ffx_largest_layout.compare_exchange_weak(largest, descriptors)) {
+	}
+	const auto result = g_ffx_create_layout(device, info, allocator, layout);
+	LogFfxFailure("vkCreateDescriptorSetLayout", result);
+	return result;
+}
+
+// Every other VkResult call FFX makes is forwarded through LoggedCall, which prints failures.
+#define KYTY_FFX_LOGGED_CALLS(X)                                                                       \
+	X(0, vkCreateComputePipelines) X(1, vkCreateImage) X(2, vkAllocateMemory) X(3, vkCreateBuffer)    \
+	X(4, vkBindBufferMemory) X(5, vkBindImageMemory) X(6, vkCreateShaderModule)                       \
+	X(7, vkResetCommandBuffer) X(8, vkCreatePipelineLayout) X(9, vkResetDescriptorPool)             \
+	X(10, vkResetCommandPool) X(11, vkCreateImageView) X(12, vkCreateBufferView)                      \
+	X(13, vkCreateSampler) X(14, vkCreateRenderPass) X(15, vkCreateFramebuffer)                       \
+	X(16, vkCreateCommandPool) X(17, vkAllocateCommandBuffers) X(18, vkCreateSemaphore)               \
+	X(19, vkMapMemory) X(20, vkBeginCommandBuffer) X(21, vkEndCommandBuffer) X(22, vkQueueSubmit)     \
+	X(23, vkWaitSemaphores) X(24, vkGetSemaphoreCounterValue) X(25, vkQueueWaitIdle)                  \
+	X(26, vkDeviceWaitIdle) X(27, vkFlushMappedMemoryRanges)
+constexpr size_t FFX_LOGGED_COUNT = 28;
+std::array<PFN_vkVoidFunction, FFX_LOGGED_COUNT> g_ffx_logged_original {};
+#define KYTY_FFX_NAME(index, call) #call,
+constexpr std::array<const char*, FFX_LOGGED_COUNT> FFX_LOGGED_NAMES {KYTY_FFX_LOGGED_CALLS(KYTY_FFX_NAME)};
+#undef KYTY_FFX_NAME
+
+template <size_t Index, typename Pfn>
+struct LoggedCall;
+template <size_t Index, typename... Args>
+struct LoggedCall<Index, VkResult(VKAPI_PTR*)(Args...)> {
+	static VkResult VKAPI_CALL Call(Args... args) {
+		const auto original = reinterpret_cast<VkResult(VKAPI_PTR*)(Args...)>(g_ffx_logged_original[Index]);
+		const auto result   = original(args...);
+		LogFfxFailure(FFX_LOGGED_NAMES[Index], result);
+		return result;
+	}
+};
+
 PFN_vkVoidFunction VKAPI_CALL DeviceProcAddr(VkDevice device, const char* name) {
 	const auto real     = VULKAN_HPP_DEFAULT_DISPATCHER.vkGetDeviceProcAddr;
 	auto       function = real(device, name);
+	if (function != nullptr && name != nullptr) {
+		const auto wrap = [&](const char* wanted, auto& original, auto wrapper) {
+			if (std::strcmp(name, wanted) == 0) {
+				original = reinterpret_cast<std::remove_reference_t<decltype(original)>>(function);
+				function = reinterpret_cast<PFN_vkVoidFunction>(wrapper);
+			}
+		};
+		wrap("vkCreateGraphicsPipelines", g_ffx_create_graphics, &FfxCreateGraphicsPipelines);
+		wrap("vkCreateDescriptorPool", g_ffx_create_pool, &FfxCreateDescriptorPool);
+		wrap("vkAllocateDescriptorSets", g_ffx_allocate_sets, &FfxAllocateDescriptorSets);
+		wrap("vkCreateDescriptorSetLayout", g_ffx_create_layout, &FfxCreateDescriptorSetLayout);
+#define KYTY_FFX_WRAP(index, call)                                                                       \
+	if (std::strcmp(name, #call) == 0) {                                                                 \
+		g_ffx_logged_original[index] = function;                                                         \
+		return reinterpret_cast<PFN_vkVoidFunction>(&LoggedCall<index, PFN_##call>::Call);                \
+	}
+		KYTY_FFX_LOGGED_CALLS(KYTY_FFX_WRAP)
+#undef KYTY_FFX_WRAP
+	}
 	if (function == nullptr && name != nullptr) {
 		const size_t length = std::strlen(name);
 		if (length > 3 && std::strcmp(name + length - 3, "KHR") == 0) {
 			const std::string core(name, length - 3);
 			function = real(device, core.c_str());
 		}
+		// AMD's buffer markers are optional (asked for on every GPU); other missing functions are printed.
+		if (function == nullptr && std::strstr(name, "BufferMarker") == nullptr) {
+			static std::atomic<uint32_t> missing {0};
+			if (missing.fetch_add(1) < 32) {
+				std::printf("FSR FG: device function %s for FSR is unavailable\n", name);
+				std::fflush(stdout);
+			}
+		}
 	}
 	return function;
 }
