<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Design tokens mirrored from the Windows launcher.

    Reference of record: AstroHybrid.App/Resources/Styles.xaml at upstream/main
    f59fb37. Do not take values from docs/screenshots/*.png: those predate the
    redesign. When upstream repaints, recompute only this file.

    Two text tokens are deliberate accessibility deviations from the reference;
    every other colour is the exact WPF value. See the PR body for the reasons
    and the measured contrast ratios. No view carries a hex value.
  -->

  <!-- ============ Palette: exact WPF values ============ -->
  <Color x:Key="BackgroundColor">#1A1A2E</Color>
  <Color x:Key="SurfaceColor">#16213E</Color>
  <Color x:Key="SurfaceLightColor">#1F2A44</Color>
  <Color x:Key="BorderColor">#2D3A5E</Color>
  <Color x:Key="PrimaryColor">#0066CC</Color>
  <Color x:Key="PrimaryDarkColor">#0052A3</Color>
  <Color x:Key="PrimaryLightColor">#3385D6</Color>
  <Color x:Key="AccentColor">#00D4AA</Color>
  <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
  <Color x:Key="TextSecondaryColor">#B0B8D0</Color>
  <Color x:Key="TextMutedColor">#6A7490</Color>
  <Color x:Key="TextMutedReadableColor">#8A93AD</Color>
  <Color x:Key="NavSelectedTextColor">#66A3E0</Color>
  <Color x:Key="ErrorColor">#FF4444</Color>
  <Color x:Key="WarningColor">#FFAA00</Color>
  <Color x:Key="SuccessColor">#00D4AA</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLightColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
  <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="TextMutedReadableBrush" Color="{StaticResource TextMutedReadableColor}" />
  <SolidColorBrush x:Key="NavSelectedTextBrush" Color="{StaticResource NavSelectedTextColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

  <!-- Literal overlay and disabled values used by the WPF control styles. -->
  <SolidColorBrush x:Key="NavHoverBrush" Color="#22FFFFFF" />
  <SolidColorBrush x:Key="NavActiveBrush" Color="#330066CC" />
  <SolidColorBrush x:Key="TextButtonHoverBrush" Color="#220066CC" />
  <SolidColorBrush x:Key="TextButtonPressedBrush" Color="#440066CC" />
  <SolidColorBrush x:Key="PrimaryDisabledBackgroundBrush" Color="#444466" />
  <SolidColorBrush x:Key="PrimaryDisabledForegroundBrush" Color="#888888" />
  <SolidColorBrush x:Key="SecondaryDisabledBackgroundBrush" Color="#222233" />
  <SolidColorBrush x:Key="SecondaryDisabledForegroundBrush" Color="#666666" />
  <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#33AA0000" />
  <SolidColorBrush x:Key="DangerBorderBrush" Color="#AA0000" />
  <SolidColorBrush x:Key="BannerPrimaryTextBrush" Color="#CCFFFFFF" />
  <SolidColorBrush x:Key="BannerSecondaryTextBrush" Color="#AAFFFFFF" />

  <!-- ============ Typography ============ -->
  <!-- Selawik is metric-compatible with Segoe UI, the reference typeface.
       Inter stays embedded as the symbol fallback (U+2605 star, U+2713 check). -->
  <FontFamily x:Key="AppFont">avares://AstroHybrid/Assets/Fonts#Selawik</FontFamily>
  <FontFamily x:Key="SymbolFont">Inter</FontFamily>
  <FontFamily x:Key="MonoFont">monospace</FontFamily>

  <!-- ============ Legacy aliases ============ -->
  <!-- Kept while the views migrate to the WPF token names. -->
  <SolidColorBrush x:Key="AppBackground" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceLightColor}" />
  <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="AccentHover" Color="{StaticResource PrimaryLightColor}" />
  <SolidColorBrush x:Key="Danger" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />

  <!-- ============ Fluent theme overrides ============ -->
  <!-- TextBox focus uses the WPF Primary border rather than the Fluent accent. -->
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource SurfaceColor}" />
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
</ResourceDictionary>
