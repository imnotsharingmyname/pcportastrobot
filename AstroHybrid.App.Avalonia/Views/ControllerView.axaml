<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:AstroHybrid.App.Avalonia.Services"
             x:Class="AstroHybrid.App.Avalonia.Views.ControllerView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,20">

      <!-- Controller -->
      <Border Classes="card">
        <StackPanel>
          <TextBlock Text="Controller" Classes="section" Margin="0,0,0,10" />
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Preferred Controller" Classes="body"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ControllerBox" Width="400"
                      HorizontalAlignment="Left" SelectionChanged="OnCommitted" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted"
                       Text="Auto detects the controller you press. PlayStation and Switch Pro controllers support motion and haptics. Xbox controllers use View/Back button for tilt." />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Vibration -->
      <Border Classes="card">
        <StackPanel>
          <TextBlock Text="Vibration" Classes="section" Margin="0,0,0,10" />
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Strength" Classes="body" VerticalAlignment="Center" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
              <ComboBox x:Name="RumbleBox" Width="300" SelectionChanged="OnCommitted" />
              <TextBox x:Name="RumbleCustomBox" Width="70" VerticalAlignment="Center"
                       ToolTip.Tip="0 to 200 percent; choose Custom in the list to change it"
                       LostFocus="OnCustomRumble" />
              <TextBlock Text="%" Classes="body" VerticalAlignment="Center" />
            </StackPanel>

            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="SwitchBoostBox"
                      Content="Stronger vibration on Switch-style pads (third-party ones)"
                      IsCheckedChanged="OnCheckCommitted" />
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="muted"
                       Text="Scales the pad's rumble motors. DualSense keeps its own amplitude." />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Motion -->
      <Border Classes="card">
        <StackPanel>
          <TextBlock Text="Motion Controls" Classes="section" Margin="0,0,0,10" />
          <CheckBox x:Name="MotionBox" Content="Enable the pad motion relay"
                    IsCheckedChanged="OnCheckCommitted" />
          <TextBlock Classes="body" Margin="0,10,0,0" TextWrapping="Wrap"
                     Text="Publishes gyro and accelerometer samples from the detected pad to the game." />
          <TextBlock Classes="muted" Margin="0,8,0,0"
                     Text="DualSense and Switch Pro controllers have built-in motion sensors. Xbox and generic pads use the View/Back button for tilt." />
        </StackPanel>
      </Border>

      <!-- DualSense -->
      <Border Classes="card">
        <StackPanel>
          <TextBlock Text="DualSense Features (Triggers, Speaker &amp; Haptics)" Classes="section"
                     Margin="0,0,0,10" />
          <TextBlock Classes="body" TextWrapping="Wrap"
                     Text="Adaptive trigger state is forwarded from the game when trigger state is on. The wireless options use the controller's Bluetooth HID channels." />
          <CheckBox x:Name="DsSpeakerBox" Content="DualSense Wireless Speaker over Bluetooth"
                    IsCheckedChanged="OnCheckCommitted" Margin="0,12,0,0" />
          <CheckBox x:Name="DsHapticsBox" Content="DualSense Wireless HD Haptics over Bluetooth"
                    IsCheckedChanged="OnCheckCommitted" Margin="0,8,0,0" />
          <TextBlock Classes="muted" Margin="0,8,0,0"
                     Text="The runtime decides whether the pad is wireless; the launcher only forwards the preference." />
        </StackPanel>
      </Border>

      <!-- Connected controllers -->
      <Border Classes="card">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Connected Controllers" Classes="section" Margin="0,0,0,10" />
            <Button Grid.Column="1" Theme="{StaticResource TextButton}" Content="Refresh"
                    VerticalAlignment="Center" Click="RefreshControllers" />
          </Grid>
          <ItemsControl x:Name="PadList" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="services:GamePadInfo">
                <Border Classes="panel" Margin="0,5,0,0">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Path Grid.Column="0" Data="{StaticResource IconController}" Width="18" Height="18"
                          Stretch="Uniform" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                          Stroke="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0"
                          VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Classes="body" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Type}" Classes="muted" />
                      <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="8">
                        <TextBlock Text="✓ Connected" Classes="muted" FontSize="11"
                                   Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="Haptics" Classes="muted" FontSize="11"
                                   IsVisible="{Binding HasHaptics}" />
                        <TextBlock Text="Motion" Classes="muted" FontSize="11"
                                   IsVisible="{Binding HasMotion}" />
                        <TextBlock Text="Triggers" Classes="muted" FontSize="11"
                                   IsVisible="{Binding HasTriggers}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="EmptyText" Classes="muted" Margin="0,6,0,0"
                     Text="No gamepad with a joystick device was found." IsVisible="False" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
