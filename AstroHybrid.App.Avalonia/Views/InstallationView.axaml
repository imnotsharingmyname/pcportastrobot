<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AstroHybrid.App.Avalonia.Views.InstallationView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,20">

      <!-- Not installed: the setup route comes first, never behind empty cards. -->
      <Border x:Name="EmptyStateCard" Classes="card" IsVisible="False">
        <StackPanel>
          <TextBlock Text="Installation Status" Classes="section" Margin="0,0,0,10" />
          <TextBlock Classes="body" TextWrapping="Wrap"
                     Text="No hybrid runtime yet. Setup reads your own Astro Bot dump and builds Build/RunHybrid; it never modifies the dump." />
          <Button Theme="{StaticResource PrimaryButton}" Content="Set Up" MinWidth="140"
                  HorizontalAlignment="Left" Margin="0,16,0,0" Click="RunSetup" />
        </StackPanel>
      </Border>

      <!-- Status -->
      <Border x:Name="StatusCard" Classes="card">
        <StackPanel>
          <TextBlock Text="Installation Status" Classes="section" Margin="0,0,0,10" />
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" Classes="label" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StatusValue" Classes="body" FontWeight="SemiBold" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Install Path:" Classes="label" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InstallPathValue" Classes="body" TextWrapping="Wrap" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Game Dump:" Classes="label" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DumpValue" Classes="body" TextWrapping="Wrap" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Game Version:" Classes="label" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="VersionValue" Classes="body" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Title ID:" Classes="label" />
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TitleIdValue" Classes="body" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Installed:" Classes="label" />
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="InstalledValue" Classes="body" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Size -->
      <Border x:Name="SizeCard" Classes="card">
        <StackPanel>
          <TextBlock Text="Installation Size" Classes="section" Margin="0,0,0,10" />
          <TextBlock x:Name="SizeValue" Classes="body" FontSize="24" FontWeight="Bold"
                     Foreground="{DynamicResource PrimaryLightBrush}" Text="—" />
        </StackPanel>
      </Border>

      <!-- Tool versions -->
      <Border x:Name="ToolsCard" Classes="card">
        <StackPanel>
          <TextBlock Text="Tool Versions" Classes="section" Margin="0,0,0,10" />
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="AnyPS5:" Classes="label" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AnyPs5Value" Classes="body" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Kyty GPU:" Classes="label" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="KytyValue" Classes="body" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Actions -->
      <Border Classes="card">
        <StackPanel>
          <TextBlock Text="Actions" Classes="section" Margin="0,0,0,10" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Repair Installation" Click="RunSetup"
                    ToolTip.Tip="Re-runs the setup against the current dump." />
            <Button Content="Rebuild Installation" Click="RunSetup" />
            <Button Content="Change Location" Click="RunSetup"
                    ToolTip.Tip="Opens setup, where the game dump folder can be changed. The runtime always lives in Build/RunHybrid." />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
            <Button Theme="{StaticResource TextButton}" Content="Open Install Folder" Click="OpenInstallFolder" />
            <Button Theme="{StaticResource TextButton}" Content="Open Log Folder" Click="OpenLogFolder" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Danger zone -->
      <Border Classes="dangerCard">
        <StackPanel>
          <TextBlock Text="⚠ Danger Zone" Classes="section" Margin="0,0,0,10"
                     Foreground="{DynamicResource ErrorBrush}" />
          <TextBlock Classes="muted" Margin="0,0,0,10"
                     Text="These actions are irreversible. Your original game dump will NOT be deleted." />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Run Setup Again" Click="RunSetup" />
            <Button x:Name="RemoveButton" Content="Remove Runtime" Click="RemoveRuntime"
                    Background="{DynamicResource DangerSurfaceBrush}"
                    BorderBrush="{DynamicResource DangerBorderBrush}"
                    Foreground="{DynamicResource WarningBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
