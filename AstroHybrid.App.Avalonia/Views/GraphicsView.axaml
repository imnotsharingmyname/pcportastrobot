<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AstroHybrid.App.Avalonia.Views.GraphicsView">
  <ScrollViewer>
    <StackPanel Margin="0,0,0,20" Spacing="20">

      <!-- Display -->
      <Border Classes="card">
        <StackPanel>
          <TextBlock Text="Display" Classes="section" />
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
              <TextBlock Text="Window resolution" Classes="label" />
              <TextBlock Text="Sets the Kyty window and swapchain; the game still renders its internal targets."
                         Classes="muted" />
            </StackPanel>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ResolutionBox" Width="190"
                      SelectionChanged="OnSelectionChanged" />

            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
              <TextBlock Text="Frame limit" Classes="label" />
              <TextBlock Text="The port is CPU-limited; a 60 FPS cap usually gives steadier pacing."
                         Classes="muted" />
            </StackPanel>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FpsBox" Width="190"
                      SelectionChanged="OnSelectionChanged" />

            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="3">
              <TextBlock Text="Fullscreen" Classes="label" />
              <TextBlock Text="Start the Kyty window in desktop fullscreen; F11 or Alt+Enter toggles it."
                         Classes="muted" />
            </StackPanel>
            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="FullscreenBox"
                      Content="Start fullscreen" HorizontalAlignment="Right"
                      Checked="OnCheckChanged" Unchecked="OnCheckChanged" />

            <StackPanel Grid.Row="3" Grid.Column="0" Spacing="3">
              <TextBlock Text="Real-time game speed" Classes="label" />
              <TextBlock Text="Rewrites the game's frame-rate block so below-60 FPS does not run in slow motion."
                         Classes="muted" />
            </StackPanel>
            <CheckBox Grid.Row="3" Grid.Column="1" x:Name="GameSpeedBox"
                      Content="Keep real time" HorizontalAlignment="Right"
                      Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Upscaling -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Text="Upscaling" Classes="section" />
          <TextBlock Classes="body"
                     Text="The Linux build uses the game's own temporal upscaler and the Vulkan driver. An experimental FSR 4.1.2 path is proposed in a separate PR." />
        </StackPanel>
      </Border>

      <!-- Audio -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Audio" Classes="section" />
          <CheckBox x:Name="DirectAudioBox"
                    Content="Route game audio directly to the default sink"
                    Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
          <TextBlock Classes="muted"
                     Text="Bypasses desktop filter chains such as JamesDSP / virtual surround, which can add a lot of latency. The sink below is optional; empty uses the current default sink." />
          <TextBox x:Name="AudioSinkBox" Watermark="alsa_output.… (optional)"
                   LostFocus="OnAudioSinkLostFocus" />
        </StackPanel>
      </Border>

      <!-- Not in this build -->
      <Border Classes="card">
        <StackPanel>
          <TextBlock Text="What is not here" Classes="section" />
          <TextBlock Classes="body"
                     Text="NVIDIA DLSS Super Resolution, DLSS Frame Generation and Reflex need NVIDIA's Windows runtime. The Linux build on AMD or NVIDIA uses the game's own temporal upscale and the Vulkan driver. An experimental FSR 4.1.2 path is proposed separately." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
