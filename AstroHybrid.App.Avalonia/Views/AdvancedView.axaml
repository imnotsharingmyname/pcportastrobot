<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AstroHybrid.App.Avalonia.Views.AdvancedView">
  <ScrollViewer>
    <StackPanel Margin="0,0,0,20" Spacing="20">

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Environment Variables" Classes="section" />
          <TextBlock Classes="muted"
                     Text="Extra variables are passed to the runtime for diagnostics and experiments. The normal settings already cover the common cases. One KEY=VALUE per line." />
          <TextBox x:Name="EnvBox" Height="140" AcceptsReturn="True" TextWrapping="NoWrap"
                   FontFamily="{DynamicResource MonoFont}" FontSize="12"
                   Watermark="APS5_TRACE_SUMMARY_EVERY=10&#10;KYTY_GPU_VBLANK_HZ=60"
                   LostFocus="OnEnvLostFocus" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Reset advanced settings" Click="Reset" />
            <Button Content="Open logs" Click="OpenLogs" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel>
          <TextBlock Text="Runtime" Classes="section" />
          <TextBlock x:Name="InfoText" Classes="mono" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel>
          <TextBlock Text="Logs" Classes="section" />
          <TextBlock Classes="body"
                     Text="The runtime writes its stdout/stderr and the launch wrappers into the project's Logs folder. Open it here when a launch or install fails." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
