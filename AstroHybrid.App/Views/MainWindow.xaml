<Window x:Class="AstroHybrid.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AstroHybrid.App.Views"
        xmlns:vm="clr-namespace:AstroHybrid.App.ViewModels"
        mc:Ignorable="d"
        Title="AstroHybrid" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="900"
        Style="{StaticResource MainWindowStyle}"
        Icon="/Resources/astrohybrid.ico">


    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                Width="240">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" Padding="20,20,20,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource PrimaryBrush}">
                            <TextBlock Text="★" FontSize="24" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="AstroHybrid" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Astro Bot PC Port" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="10,20,10,0">
                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Home}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Home">
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Home"/>
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=GraphicsSettings}"
                                 Command="{Binding NavigateCommand}" CommandParameter="GraphicsSettings"
                                 Margin="0,4,0,0">
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎮" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Graphics"/>
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ControllerSettings}"
                                 Command="{Binding NavigateCommand}" CommandParameter="ControllerSettings"
                                 Margin="0,4,0,0">
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎯" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Controller"/>
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AdvancedSettings}"
                                 Command="{Binding NavigateCommand}" CommandParameter="AdvancedSettings"
                                 Margin="0,4,0,0">
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Advanced"/>
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Installation}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Installation"
                                 Margin="0,4,0,0">
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Installation"/>
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>
                </StackPanel>

                <!-- Status Bar -->
                <Border Grid.Row="2" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="STATUS" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                        <ProgressBar Value="{Binding IsLoading, Converter={StaticResource BoolToProgressConverter}}"
                                     Maximum="1" IsIndeterminate="{Binding IsLoading}"
                                     Style="{StaticResource ModernProgressBarStyle}" Height="4" Margin="0,8,0,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Page Content -->
                <ContentControl Grid.Row="0" Content="{Binding CurrentPage, Converter={StaticResource PageTemplateSelector}}"
                                Margin="30,30,30,0"/>

                <!-- Bottom Action Bar -->
                <Border Grid.Row="1" Padding="30,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="Best Settings for This PC" Command="{Binding ApplyBestSettingsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                                    Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=GraphicsSettings}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Play" Command="{Binding LaunchGameCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" MinHeight="48"
                                    FontSize="16" FontWeight="SemiBold"
                                    IsEnabled="{Binding InstallationState.IsInstalled}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>