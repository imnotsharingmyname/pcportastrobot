<Window x:Class="AstroHybrid.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AstroHybrid.App.Views"
        xmlns:app="clr-namespace:AstroHybrid.App"
        mc:Ignorable="d"
        Title="AstroHybrid" Height="760" Width="1240"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        MinHeight="560" MinWidth="900"
        Style="{StaticResource MainWindowStyle}"
        Icon="/Resources/astrohybrid.ico"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56"
                      ResizeBorderThickness="6"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <app:UpdateStateToVisibilityConverter x:Key="UpdateStateToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <!-- Icon used in the rail: stroke follows the RadioButton foreground -->
        <Style x:Key="RailIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootWindowBorder" BorderBrush="#FF161A22" BorderThickness="1" Background="{StaticResource BackgroundBrush}">
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Key art from the player's dump fills the whole content area; shades keep text readable -->
            <Grid Grid.Column="1" IsHitTestVisible="False">
                <Image Source="{Binding HeroImage}" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border Background="{StaticResource HeroShadeBrush}"/>
                <Border Background="{StaticResource HeroFloorBrush}"/>
                <!-- Soft blue glow when no key art is available -->
                <Ellipse Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-420,-300,0" Opacity="0.35">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#661F6FFF" Offset="0"/>
                            <GradientStop Color="#001F6FFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Settings pages sit on a darker veil so the art stays in the background -->
                <Border Background="#FF050608">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0.86"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                                    <Setter Property="Opacity" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>

            <!-- Icon rail -->
            <Border Grid.Column="0" Background="{StaticResource SidebarSpaceBrush}" BorderBrush="#FF12151C" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- AstroHybrid logo -->
                    <Image Grid.Row="0" Source="/Resources/astrohybrid.png" Width="48" Height="48" Margin="0,16,0,24"
                           HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="AstroHybrid"/>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                        <RadioButton Style="{StaticResource NavButtonStyle}" ToolTip="Home"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Home}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Home">
                            <Path Style="{StaticResource RailIcon}" Data="M3,10.5 L12,3 L21,10.5 M5.5,8.8 L5.5,20 L18.5,20 L18.5,8.8 M10,20 L10,14 L14,14 L14,20"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButtonStyle}" ToolTip="Graphics" Margin="0,10,0,0"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=GraphicsSettings}"
                                     Command="{Binding NavigateCommand}" CommandParameter="GraphicsSettings">
                            <Path Style="{StaticResource RailIcon}" Data="M3,5 L21,5 L21,16 L3,16 Z M8,20 L16,20 M12,16 L12,20 M7,12 L10,9 L13,11.5 L17,8"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButtonStyle}" ToolTip="Controller" Margin="0,10,0,0"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ControllerSettings}"
                                     Command="{Binding NavigateCommand}" CommandParameter="ControllerSettings">
                            <Path Style="{StaticResource RailIcon}" Width="22"
                                  Data="M6,7 L18,7 C20.5,7 22,9.2 21.5,12.5 L20.8,16.5 C20.5,18 19.2,18.5 18,17.5 L15.5,15 L8.5,15 L6,17.5 C4.8,18.5 3.5,18 3.2,16.5 L2.5,12.5 C2,9.2 3.5,7 6,7 Z M7,10 L7,13 M5.5,11.5 L8.5,11.5 M16,10.5 L16,10.6 M17.5,12 L17.5,12.1"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButtonStyle}" ToolTip="Advanced" Margin="0,10,0,0"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AdvancedSettings}"
                                     Command="{Binding NavigateCommand}" CommandParameter="AdvancedSettings">
                            <Path Style="{StaticResource RailIcon}" Data="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18 M9,4 L9,8 M15,10 L15,14 M11,16 L11,20"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButtonStyle}" ToolTip="Installation" Margin="0,10,0,0"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Installation}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Installation">
                            <Path Style="{StaticResource RailIcon}" Data="M12,3 L12,14 M8,10 L12,14 L16,10 M4,16 L4,20 L20,20 L20,16"/>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <!-- Ko-fi -->
                        <Button Command="{Binding OpenSupportCommand}" Cursor="Hand" Width="52" Height="52"
                                ToolTip="Fund me: buy me a coffee on Ko-fi (opens ko-fi.com/justhappyguy in your browser)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="B" CornerRadius="14" Background="#141F6FFF" BorderBrush="#331F6FFF" BorderThickness="1">
                                        <Path x:Name="Heart" Data="M5,8 C5,8 0,5 0,2.5 C0,1 1.2,0 2.5,0 C3.6,0 4.4,0.7 5,1.6 C5.6,0.7 6.4,0 7.5,0 C8.8,0 10,1 10,2.5 C10,5 5,8 5,8 Z"
                                              Fill="#FF6FA6FF" Width="20" Height="17" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="Background" Value="#331F6FFF"/>
                                            <Setter TargetName="B" Property="BorderBrush" Value="#FF3A86FF"/>
                                            <Setter TargetName="Heart" Property="Fill" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Text="{Binding AppVersionText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="76" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Grid Grid.Row="0" Margin="36,12,12,4" MinHeight="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource FontFamilyDisplay}" FontSize="15" VerticalAlignment="Center">
                            <Run Text="ASTRO" Foreground="White"/><Run Text="HYBRID" Foreground="{StaticResource AccentBrush}"/>
                        </TextBlock>
                        <Border CornerRadius="10" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center"
                                Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InstallationState.IsInstalled}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="SETUP REQUIRED"/>
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InstallationState.IsInstalled}" Value="True">
                                                    <Setter Property="Text" Value="NATIVE WINDOWS BUILD"/>
                                                    <Setter Property="Foreground" Value="#FFB3BAC7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding CheckForUpdatesCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center" Margin="12,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateState.IsChecking}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4,12 A8,8 0 0,1 17.6,6.4 M20,4 L20,8.5 L15.5,8.5 M20,12 A8,8 0 0,1 6.4,17.6 M4,20 L4,15.5 L8.5,15.5"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Check for updates"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateState.IsChecking}" Value="True">
                                                <Setter Property="Text" Value="Checking updates..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize">
                            <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="MaximizeRestoreButton_Click" ToolTip="Maximize / Restore">
                            <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent"/>
                        </Button>
                        <Button Style="{StaticResource CloseCaptionButtonStyle}" Click="CloseButton_Click" ToolTip="Close">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Page content with a short fade/slide on every page change -->
                <Grid Grid.Row="1" Margin="36,6,36,0">
                    <ContentControl x:Name="PageHost" Focusable="False"
                                    Content="{Binding CurrentPage, Converter={StaticResource PageTemplateSelector}, NotifyOnTargetUpdated=True}">
                        <ContentControl.RenderTransform>
                            <TranslateTransform/>
                        </ContentControl.RenderTransform>
                        <ContentControl.Triggers>
                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="12" To="0" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ContentControl.Triggers>
                    </ContentControl>

                    <!-- Update notification -->
                    <Border VerticalAlignment="Top" Margin="0,4,0,0"
                            Visibility="{Binding ShowUpdateNotification, Converter={StaticResource BooleanToVisibilityConverter}}"
                            CornerRadius="16" Padding="18,14" Background="#F20B0F18"
                            BorderBrush="#FF2F7BFF" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.7"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="#261F6FFF"
                                    BorderBrush="#552F7BFF" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Path Data="M12,4 L12,15 M7.5,10.5 L12,15 L16.5,10.5 M5,19 L19,19"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                                      Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="New AstroHybrid update available" FontFamily="{StaticResource FontFamilyDisplay}" FontSize="14" Foreground="White"/>
                                <TextBlock Text="{Binding UpdateState.LatestUpdate.Version, StringFormat='Version {0}'}" FontSize="12.5" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding UpdateState.LatestUpdate.ReleaseNotes}" FontSize="11.5" Foreground="#FFB3BAC7" TextWrapping="Wrap" MaxWidth="560" MaxHeight="64" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                <ProgressBar Value="{Binding UpdateState.DownloadPercent, Mode=OneWay}" Maximum="100"
                                             Style="{StaticResource UpdateProgressBarStyle}"
                                             Visibility="{Binding UpdateState.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding UpdateState.DownloadStatus}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" MaxWidth="560" Margin="0,8,0,0"
                                           Visibility="{Binding UpdateState.ShowUpdateStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Update now" Command="{Binding DownloadUpdateCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="118" Margin="14,0,8,0"
                                    Visibility="{Binding UpdateState.ShowUpdateButton, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Grid.Column="2" Content="Updating..." Style="{StaticResource PrimaryButtonStyle}" MinWidth="118"
                                    Margin="14,0,8,0" IsEnabled="False"
                                    Visibility="{Binding UpdateState.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Grid.Column="2" Content="Restart launcher" Command="{Binding RestartToUpdateCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" Margin="14,0,8,0"
                                    Visibility="{Binding UpdateState.IsReadyToRestart, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Grid.Column="3" Content="Ignore for now" Command="{Binding IgnoreUpdateCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="110"
                                    Visibility="{Binding UpdateState.ShowUpdateButton, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Grid.Column="3" Content="Later" Command="{Binding DismissUpdateNotificationCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="82"
                                    Visibility="{Binding UpdateState.IsReadyToRestart, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Ignored update strip -->
                    <Border VerticalAlignment="Top" Margin="0,4,0,0"
                            Visibility="{Binding HasIgnoredUpdate, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="#F20B0F18" CornerRadius="14" Padding="14,10"
                            BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="↻" FontSize="18" Foreground="{StaticResource WarningBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="UPDATE AVAILABLE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                <TextBlock Text="{Binding UpdateState.IgnoredUpdate.ReleaseName}" FontSize="12.5" Foreground="White"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Update now" Command="{Binding DownloadUpdateCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="110" MinHeight="34" Margin="14,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Launch dock -->
                <Grid Grid.Row="2" Margin="36,14,36,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status + credit -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding IsLoading, Converter={StaticResource BoolToProgressConverter}}"
                                     Maximum="1" IsIndeterminate="{Binding IsLoading}" Height="3" MaxWidth="260"
                                     HorizontalAlignment="Left" Width="260" Margin="15,6,0,0"
                                     Style="{StaticResource ModernProgressBarStyle}"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock FontSize="11.5" Margin="15,4,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="Made by a random Moroccan guy · " Foreground="{StaticResource TextMutedBrush}"/><Run Text="A9wad Fassi" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Best settings for this PC" Command="{Binding ApplyBestSettingsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Height="44" Margin="0,0,10,0"
                                Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=GraphicsSettings}"/>
                        <Button Content="Update" Command="{Binding DownloadUpdateCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" MinWidth="108" Height="44" Margin="0,0,10,0"
                                Visibility="{Binding HasUpdateAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                IsEnabled="{Binding HasUpdateAction}"/>
                        <Button Content="Restart launcher" Command="{Binding RestartToUpdateCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" Height="44" Margin="0,0,10,0"
                                ToolTip="Finish the update: the launcher closes and opens again on the new version"
                                Visibility="{Binding IsUpdateReady, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Height="44" Margin="0,0,14,0"
                                Command="{Binding NavigateCommand}" CommandParameter="Installation"
                                ToolTip="Manage installation, repair, or game dump location">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,3 L12,14 M8,10 L12,14 L16,10 M4,16 L4,20 L20,20 L20,16"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                                      Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="Install / Manage" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding LaunchGameCommand}" Style="{StaticResource PlayButtonStyle}"
                                IsEnabled="{Binding InstallationState.IsInstalled}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 0,0 L 11,7 L 0,14 Z" Fill="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="PLAY" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
