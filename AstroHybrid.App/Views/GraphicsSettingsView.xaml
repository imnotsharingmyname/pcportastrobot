<UserControl x:Class="AstroHybrid.App.Views.GraphicsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AstroHybrid.App.Views"
             xmlns:vm="clr-namespace:AstroHybrid.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,20">
            <!-- Resolution & Display -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Display" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="Resolution" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding ResolutionLabels}"
                                  SelectedIndex="{Binding ResolutionIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="300"/>

                        <CheckBox Grid.Row="1" Grid.Column="1" Content="Start in fullscreen"
                                  IsChecked="{Binding Fullscreen}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  VerticalAlignment="Center" Margin="0,10,0,0"/>
                    </Grid>
                    <CheckBox Content="VSync (no tearing; may add a little input delay)"
                              IsChecked="{Binding VSync}"
                              Style="{StaticResource ModernCheckBoxStyle}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Frame Rate -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Frame Rate" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="Limit" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FpsLabels}"
                                  SelectedIndex="{Binding FpsIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="400"/>
                    </Grid>

                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0">
                        The game may run below the selected limit in demanding scenes.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- NVIDIA RTX Features -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="NVIDIA RTX Features" Style="{StaticResource SectionHeaderStyle}"/>

                    <TextBlock Text="{Binding HardwareNote}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,15" TextWrapping="Wrap"/>

                    <!-- Upscaling -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="Upscaling" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding UpscaleLabels}"
                                  SelectedIndex="{Binding UpscaleIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="400"
                                  IsEnabled="{Binding SupportsDlss}"/>
                    </Grid>

                    <!-- Frame Generation -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="Frame Generation" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FrameGenLabels}"
                                  SelectedIndex="{Binding FrameGenIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="400"
                                  IsEnabled="{Binding IsFrameGenAvailable}"/>
                    </Grid>

                    <!-- Frame Gen Target -->
                    <Grid Margin="0,0,0,10" Visibility="{Binding IsFrameGenTargetEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="Target FPS" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FrameGenTargetLabels}"
                                  SelectedIndex="{Binding FrameGenTargetIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="400"/>
                    </Grid>

                    <!-- Frame Gen Note -->
                    <TextBlock Text="{Binding FrameGenNote}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <!-- Reflex -->
                    <CheckBox Content="NVIDIA Low Latency (Reflex)" IsChecked="{Binding LowLatency}"
                              Style="{StaticResource ModernCheckBoxStyle}" Margin="0,15,0,0"
                              IsEnabled="{Binding SupportsReflex}"/>
                </StackPanel>
            </Border>

            <!-- Performance Overlay -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Performance Overlay" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="Show Stats" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding OverlayLabels}"
                                  SelectedIndex="{Binding OverlayIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="400"/>
                    </Grid>

                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0">
                        In game: F2 shows/hides overlay, Ctrl+F2 changes frame-rate limit, F11 or Alt+Enter toggles fullscreen.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Hardware Summary -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Hardware Summary" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="{Binding HardwareNote}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>