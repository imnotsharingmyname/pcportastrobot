<UserControl x:Class="AstroHybrid.App.Views.GraphicsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AstroHybrid.App.Views"
             xmlns:vm="clr-namespace:AstroHybrid.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,20">
            <!-- Main graphics choices: the few settings most players need. Everything else is under Advanced. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Graphics" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Restore Defaults" Command="{Binding RestoreDefaultsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Graphics settings only: picks the best choices for this PC again. Controller and other settings stay."/>
                    </Grid>

                    <TextBlock Text="{Binding HardwareNote}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,12" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource BodyTextStyle}" Text="Preset" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                                  ItemsSource="{Binding PresetLabels}" SelectedIndex="{Binding PresetIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Left" Width="400"/>

                        <TextBlock Grid.Row="1" Style="{StaticResource BodyTextStyle}" Text="Upscaling" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                                  ItemsSource="{Binding UpscaleLabels}" SelectedIndex="{Binding UpscaleIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Left" Width="400"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource BodyTextStyle}" Text="Frame Generation" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                                  ItemsSource="{Binding FrameGenLabels}" SelectedIndex="{Binding FrameGenIndex}"
                                  IsEnabled="{Binding IsFrameGenAvailable}"
                                  Visibility="{Binding ShowFrameGen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Left" Width="400"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" VerticalAlignment="Center"
                                   Text="{Binding FrameGenUnavailableNote}" TextWrapping="Wrap"
                                   Visibility="{Binding ShowFrameGenUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <TextBlock Grid.Row="3" Style="{StaticResource BodyTextStyle}" Text="{Binding FpsLimitLabel}" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                                  ItemsSource="{Binding FpsLabels}" SelectedIndex="{Binding FpsIndex}"
                                  IsEnabled="{Binding IsFpsLimitEnabled}"
                                  Visibility="{Binding IsFpsLimitEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Left" Width="400"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                                  ItemsSource="{Binding FrameGenTargetLabels}" SelectedIndex="{Binding FrameGenTargetIndex}"
                                  Visibility="{Binding IsFrameGenTargetEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  ToolTip="With frame generation on, this is the frame rate shown on screen; the game itself runs at a fraction of it."
                                  Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Left" Width="400"/>
                    </Grid>

                    <TextBlock Text="{Binding FrameGenNote}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Visibility="{Binding ShowFrameGen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding FpsLimitNote}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding IsFpsLimitEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- AMD FSR upscaling quality, sharpness and version (shown when AMD FSR is active). -->
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowFsrSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource BodyTextStyle}" Text="FSR Quality" VerticalAlignment="Center" Width="150"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                                      ItemsSource="{Binding FsrQualityLabels}" SelectedIndex="{Binding FsrQualityIndex}"
                                      ToolTip="Sets Astro Bot's internal render resolution before AMD FSR upscaling (keeps 16:9 / 21:9 / 32:9 aspect ratio intact)."
                                      Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Left" Width="400"/>

                            <TextBlock Grid.Row="1" Style="{StaticResource BodyTextStyle}" Text="FSR Sharpness" VerticalAlignment="Center" Width="150"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                                <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding FsrSharpness}" Width="310" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FsrSharpnessLabel}" Style="{StaticResource BodyTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Style="{StaticResource BodyTextStyle}" Text="FSR Version" VerticalAlignment="Center" Width="150"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                                      ItemsSource="{Binding FsrVersionLabels}" SelectedIndex="{Binding FsrVersionIndex}"
                                      ToolTip="Chooses which AMD FSR upscaler runtime version to request (Auto uses FSR 4.1.2 on Radeon RX 9000, else FSR 3.1.6)."
                                      Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Left" Width="400"/>
                        </Grid>
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="FSR Quality adjusts the game's internal dynamic-resolution tier before FSR upscales to output; Ultrawide 21:9 / 32:9 and FSR Frame Generation remain fully compatible."/>
                    </StackPanel>

                    <TextBlock Text="{Binding ActiveSummary}" Style="{StaticResource BodyTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- AMD FSR frame generation (ASTROHYBRID_FSRFG): any graphics card, with any upscaling choice. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="AMD FSR Frame Generation" Style="{StaticResource SectionHeaderStyle}"/>

                    <CheckBox Content="Generate one extra frame per game frame (2x, any graphics card)" IsChecked="{Binding FsrFrameGen}"
                              Style="{StaticResource ModernCheckBoxStyle}" Margin="0,10,0,0"
                              IsEnabled="{Binding IsFsrFrameGenAvailable}"/>
                    <TextBlock Text="{Binding FsrNote}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="AMD FSR upscaling is a choice under Upscaling above."/>
                </StackPanel>
            </Border>

            <!-- Advanced: less-used options, collapsed by default. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <Expander Header="Advanced" IsExpanded="{Binding IsAdvancedExpanded}" Foreground="{StaticResource TextPrimaryBrush}">
                    <StackPanel Margin="0,12,0,0" TextElement.FontWeight="Normal">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource BodyTextStyle}" Text="Resolution" VerticalAlignment="Center" Width="150"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding ResolutionLabels}" SelectedIndex="{Binding ResolutionIndex}"
                                      Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Left" Width="400"/>

                            <CheckBox Grid.Row="1" Grid.Column="1" Content="Start in fullscreen"
                                      IsChecked="{Binding Fullscreen}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,10,0,0"/>

                            <CheckBox Grid.Row="2" Grid.Column="1" Content="Ultrawide 21:9 / 32:9 rendering"
                                      IsChecked="{Binding Ultrawide}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,10,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding UltrawideNote}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                        <!-- Graphics card (issue #24): integrated and discrete adapters can be chosen. -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Text="Graphics card" VerticalAlignment="Center" Width="150"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding GpuLabels}" SelectedIndex="{Binding GpuIndex}"
                                      IsEnabled="{Binding HasGpuChoice}"
                                      Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Left" Width="400"/>
                        </Grid>
                        <TextBlock Text="{Binding GpuNote}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                        <CheckBox Content="VSync (no tearing; may add a little input delay)"
                                  IsChecked="{Binding VSync}" IsEnabled="{Binding IsVSyncAvailable}"
                                  Style="{StaticResource ModernCheckBoxStyle}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding VSyncNote}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                        <Grid Margin="0,12,0,0" Visibility="{Binding ShowDlssQuality, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Text="DLSS quality" VerticalAlignment="Center" Width="150"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding DlssQualityLabels}" SelectedIndex="{Binding DlssQualityIndex}"
                                      ToolTip="The game still lowers its own render resolution in heavy scenes (dynamic resolution, as on PS5); this sets how DLSS reconstructs the image."
                                      Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Left" Width="400"/>
                        </Grid>

                        <CheckBox Content="NVIDIA Low Latency (Reflex)" IsChecked="{Binding LowLatency}"
                                  Visibility="{Binding SupportsReflex, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Style="{StaticResource ModernCheckBoxStyle}" Margin="0,12,0,0"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Text="Performance overlay" VerticalAlignment="Center" Width="150"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding OverlayLabels}" SelectedIndex="{Binding OverlayIndex}"
                                      Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Left" Width="400"/>
                        </Grid>
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="In game: F2 shows/hides the overlay, Ctrl+F2 changes the frame-rate limit, F11 or Alt+Enter toggles fullscreen."/>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
