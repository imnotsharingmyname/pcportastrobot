<UserControl x:Class="AstroHybrid.App.Views.AdvancedSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AstroHybrid.App.Views"
             xmlns:vm="clr-namespace:AstroHybrid.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">


    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,20">
            <!-- Renderer/Lighting -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Renderer" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="Lighting" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding LightingLabels}"
                                  SelectedIndex="{Binding LightingIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="400"/>
                    </Grid>

                    <TextBlock Text="{Binding LightingNote}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Game Speed -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Game Speed" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="Speed" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SpeedLabels}"
                                  SelectedIndex="{Binding SpeedIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="400"/>
                    </Grid>

                    <TextBlock Text="{Binding SpeedNote}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Runtime Options -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Runtime Options" Style="{StaticResource SectionHeaderStyle}"/>

                    <StackPanel Margin="0,10,0,0">
                        <CheckBox Content="Hang Watchdog (record diagnostics on freeze)"
                                  IsChecked="{Binding HangWatchdog}"
                                  Style="{StaticResource ModernCheckBoxStyle}"/>
                        <TextBlock Text="{Binding HangWatchdogNote}" Style="{StaticResource MutedTextStyle}" Margin="28,4,0,10" TextWrapping="Wrap"/>

                        <CheckBox Content="Persistent Shader Cache (eliminates compile hitches)"
                                  IsChecked="{Binding ShaderCache}"
                                  Style="{StaticResource ModernCheckBoxStyle}"/>
                        <TextBlock Text="{Binding ShaderCacheNote}" Style="{StaticResource MutedTextStyle}" Margin="28,4,0,10" TextWrapping="Wrap"/>

                        <CheckBox Content="Draw Prep Tuning (reduces CP spin with background apps)"
                                  IsChecked="{Binding DrawPrepTuning}"
                                  Style="{StaticResource ModernCheckBoxStyle}"/>
                        <TextBlock Text="{Binding DrawPrepNote}" Style="{StaticResource MutedTextStyle}" Margin="28,4,0,10" TextWrapping="Wrap"/>

                        <CheckBox Content="Motion Controls (accelerometer/gyroscope)"
                                  IsChecked="{Binding MotionControls}"
                                  Style="{StaticResource ModernCheckBoxStyle}"/>
                        <TextBlock Text="{Binding MotionNote}" Style="{StaticResource MutedTextStyle}" Margin="28,4,0,10" TextWrapping="Wrap"/>

                        <CheckBox Content="Trigger State (DualSense adaptive triggers)"
                                  IsChecked="{Binding TriggerState}"
                                  Style="{StaticResource ModernCheckBoxStyle}"/>
                        <TextBlock Text="{Binding TriggerNote2}" Style="{StaticResource MutedTextStyle}" Margin="28,4,0,10" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Priority Settings -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Process Priority" Style="{StaticResource SectionHeaderStyle}"/>

                    <StackPanel Margin="0,10,0,0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="Process Priority" VerticalAlignment="Center" Width="150"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding PriorityOptions}"
                                      SelectedItem="{Binding Priority}"
                                      Style="{StaticResource ModernComboBoxStyle}" Width="200"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="Command Processor Priority" VerticalAlignment="Center" Width="200"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding CpPriorityOptions}"
                                      SelectedItem="{Binding CpPriority}"
                                      Style="{StaticResource ModernComboBoxStyle}" Width="150"/>
                        </Grid>

                        <TextBlock Text="{Binding PriorityNote}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- CUDA/Frame Gen Options -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="NVIDIA Frame Generation" Style="{StaticResource SectionHeaderStyle}"/>

                    <StackPanel Margin="0,10,0,0">
                        <CheckBox Content="CUDA Address Hole (required for DLSS/Frame Gen)"
                                  IsChecked="{Binding CudaHole}"
                                  Style="{StaticResource ModernCheckBoxStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Experimental Features -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Expander Header="Experimental Features" IsExpanded="{Binding IsExperimentalExpanded}"
                              Foreground="{StaticResource TextPrimaryBrush}">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="{Binding ExperimentalWarning}" Style="{StaticResource ErrorTextStyle}" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <TextBlock Text="Additional experimental options will be added here as they are validated." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>