<Window x:Class="AstroHybrid.App.Views.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AstroHybrid.App.Views"
        xmlns:vm="clr-namespace:AstroHybrid.App.ViewModels"
        mc:Ignorable="d"
        Title="AstroHybrid Setup" Height="600" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Style="{StaticResource MainWindowStyle}"
        Icon="/Resources/astrohybrid.ico">

    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:BytesToStringConverter x:Key="BytesToStringConverter"/>
    </Window.Resources>


    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="AstroHybrid" Style="{StaticResource TitleTextStyle}"/>
            <TextBlock Text="Astro Bot Native PC Port Setup" Style="{StaticResource SubtitleTextStyle}"/>
        </StackPanel>

        <!-- Content -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <!-- Welcome Screen -->
                <StackPanel x:Name="WelcomePanel" Visibility="Visible">
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,20">
                        Welcome to AstroHybrid! This setup wizard will help you prepare Astro Bot for Windows using your own legally obtained PS5 game dump.
                    </TextBlock>

                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,10" FontWeight="SemiBold">
                        You will need:
                    </TextBlock>
                    <StackPanel Margin="20,0,0,20">
                        <TextBlock Style="{StaticResource BodyTextStyle}">• A PS5 Astro Bot game dump (folder containing eboot.bin)</TextBlock>
                        <TextBlock Style="{StaticResource BodyTextStyle}">• Approximately 2-3 GB of free disk space</TextBlock>
                        <TextBlock Style="{StaticResource BodyTextStyle}">• NVIDIA RTX GPU recommended for DLSS/Frame Generation</TextBlock>
                    </StackPanel>

                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap">
                        The original game dump will never be modified. All files are created in a separate installation directory.
                    </TextBlock>
                </StackPanel>

                <!-- Game Selection -->
                <StackPanel x:Name="GameSelectionPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Select Game Dump"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,10">
                        Browse to your Astro Bot PS5 game dump folder (the folder containing eboot.bin):
                    </TextBlock>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding GameDumpPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 IsReadOnly="True"
                                 ToolTip="Selected game dump path"/>
                        <Button Grid.Column="1" Content="Browse..."
                                Command="{Binding BrowseCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="10,0,0,0" MinWidth="100"/>
                    </Grid>

                    <TextBlock x:Name="ValidationErrorText"
                               Text="{Binding ValidationError}"
                               Style="{StaticResource ErrorTextStyle}"
                               Visibility="{Binding ShowError, Converter={StaticResource BooleanToVisibilityConverter}}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- Game Info Preview -->
                    <Border x:Name="GameInfoBorder" Visibility="Collapsed" Style="{StaticResource PanelStyle}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Detected Game Information"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MutedTextStyle}" Text="Title ID: "/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BodyTextStyle}" Text="{Binding GameInfo.TitleId}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource MutedTextStyle}" Text="Version: "/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyTextStyle}" Text="{Binding GameInfo.Version}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource MutedTextStyle}" Text="Eboot Size: "/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BodyTextStyle}" Text="{Binding GameInfo.EbootSize, Converter={StaticResource BytesToStringConverter}}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource MutedTextStyle}" Text="Status: "/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource SuccessBrush}" Text="Valid ✓"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Installation Progress -->
                <StackPanel x:Name="InstallPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Installing AstroHybrid"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="{Binding StatusMessage}" Margin="0,0,0,10"/>

                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100"
                                 Style="{StaticResource ModernProgressBarStyle}" Height="10"/>

                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0">
                        <Run Text="{Binding ProgressPercent}"/>% complete
                    </TextBlock>

                    <TextBlock x:Name="InstallErrorText"
                               Text="{Binding ValidationError}"
                               Style="{StaticResource ErrorTextStyle}"
                               Visibility="{Binding ShowError, Converter={StaticResource BooleanToVisibilityConverter}}"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Complete -->
                <StackPanel x:Name="CompletePanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource TitleTextStyle}" Foreground="{StaticResource SuccessBrush}" Text="✓ Setup Complete"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,10,0,0">
                        AstroHybrid has been successfully installed. You can now configure your graphics and controller settings and launch the game.
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="100"/>
            <Button x:Name="NextButton" Content="Next" Command="{Binding ValidateCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="120" Margin="10,0,0,0"
                    IsEnabled="{Binding CanProceed}"/>
            <Button x:Name="InstallButton" Content="Install" Command="{Binding InstallCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="120" Margin="10,0,0,0"
                    Visibility="Collapsed" IsEnabled="{Binding CanProceed}"/>
            <Button x:Name="FinishButton" Content="Finish" Command="{Binding CancelCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="120" Margin="10,0,0,0"
                    Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>