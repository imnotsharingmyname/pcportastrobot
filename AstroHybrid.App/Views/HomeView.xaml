<UserControl x:Class="AstroHybrid.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="920">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="ChipLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
        <Style x:Key="ChipValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
    </UserControl.Resources>

    <!-- Home is deliberately minimal: the key art, the title and a few facts. Everything else lives on its own page. -->
    <Grid>
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="560" Margin="0,0,0,8">
            <TextBlock Text="ASTRO BOT" Style="{StaticResource HeroTitleStyle}" FontSize="64">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="Native PC build" Style="{StaticResource HeroSubtitleStyle}" Margin="2,2,0,0"/>

            <WrapPanel Margin="0,20,0,0">
                <Border Style="{StaticResource ProfileChipStyle}" Padding="12,7">
                    <StackPanel>
                        <TextBlock Text="VERSION" Style="{StaticResource ChipLabel}"/>
                        <TextBlock Text="{Binding GameVersion}" Style="{StaticResource ChipValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ProfileChipStyle}" Padding="12,7">
                    <StackPanel>
                        <TextBlock Text="STATUS" Style="{StaticResource ChipLabel}"/>
                        <TextBlock Text="{Binding GameStatus}" Style="{StaticResource ChipValue}"
                                   Foreground="{Binding GameStatus, Converter={StaticResource StatusToBrushConverter}}"/>
                    </StackPanel>
                </Border>
                <Button Command="{Binding ToggleRayTracingCommand}" Margin="0,0,8,8" Cursor="Hand"
                        ToolTip="Switch between the ray-traced and non-ray-traced build">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,7">
                                <StackPanel>
                                    <TextBlock Text="RAY TRACING" Style="{StaticResource ChipLabel}"/>
                                    <TextBlock Text="{Binding RayTracingToggleText}" Style="{StaticResource ChipValue}" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="BorderBrush" Value="#FF3A86FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Border Style="{StaticResource ProfileChipStyle}" Padding="12,7" BorderBrush="#FF2F7BFF"
                        Visibility="{Binding UpdateState.UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="UPDATE" Style="{StaticResource ChipLabel}" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding UpdateState.LatestUpdate.Version}" Style="{StaticResource ChipValue}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Button Content="Contribute on GitHub" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Left" Margin="2,6,0,0"
                    FontSize="12" Command="{Binding DataContext.OpenContributeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="Help reach 60 FPS: send a measured performance pull request"/>
        </StackPanel>
    </Grid>
</UserControl>
