<UserControl x:Class="AstroHybrid.App.Views.ControllerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AstroHybrid.App.Views"
             xmlns:vm="clr-namespace:AstroHybrid.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,20">
            <!-- Controller Selection -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Controller" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="Preferred Controller" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ControllerLabels}"
                                  SelectedIndex="{Binding ControllerIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="400"/>
                    </Grid>

                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap">
                        Auto detects the controller you press. PlayStation and Switch Pro controllers support motion and haptics. Xbox controllers use View/Back button for tilt.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Vibration -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Vibration" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="Strength" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding RumbleLabels}"
                                  SelectedIndex="{Binding RumbleIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="400"/>
                    </Grid>

                    <CheckBox Content="Stronger vibration on Switch-style pads (third-party ones)"
                              IsChecked="{Binding SwitchBoost}"
                              Style="{StaticResource ModernCheckBoxStyle}" Margin="0,10,0,0"/>

                    <TextBlock Text="{Binding VibrationNote}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Motion Controls -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Motion Controls" Style="{StaticResource SectionHeaderStyle}"/>

                    <TextBlock Text="{Binding MotionNote}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/>

                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap">
                        DualSense and Switch Pro controllers have built-in motion sensors.
                        Xbox and generic pads: press View/Back to enable tilt with right stick, press again to disable.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Trigger Effects -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Adaptive Triggers (DualSense)" Style="{StaticResource SectionHeaderStyle}"/>

                    <TextBlock Text="{Binding TriggerNote}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Connected Controllers -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Connected Controllers" Style="{StaticResource SectionHeaderStyle}"/>
                        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshControllersCommand}"
                                Style="{StaticResource TextButtonStyle}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ConnectedControllers}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PanelStyle}" Margin="0,5,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" FontSize="18" Margin="0,0,12,0">
                                            <TextBlock.Text>
                                                <Binding Path="Type" Converter="{StaticResource ControllerTypeToIconConverter}"/>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Type}" Style="{StaticResource MutedTextStyle}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="✓ Connected" Style="{StaticResource MutedTextStyle}" FontSize="11" Foreground="{StaticResource SuccessBrush}"
                                                           Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text="✗ Disconnected" Style="{StaticResource MutedTextStyle}" FontSize="11" Foreground="{StaticResource ErrorBrush}"
                                                           Visibility="{Binding IsConnected, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                <TextBlock Text=" | " Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                                                <TextBlock Text="🎮 Haptics" Style="{StaticResource MutedTextStyle}" FontSize="11"
                                                           Visibility="{Binding HasHaptics, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text=" | " Style="{StaticResource MutedTextStyle}" FontSize="11"
                                                           Visibility="{Binding HasHaptics, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text="🎯 Motion" Style="{StaticResource MutedTextStyle}" FontSize="11"
                                                           Visibility="{Binding HasMotionSensors, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text=" | " Style="{StaticResource MutedTextStyle}" FontSize="11"
                                                           Visibility="{Binding HasMotionSensors, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text="⚡ Triggers" Style="{StaticResource MutedTextStyle}" FontSize="11"
                                                           Visibility="{Binding HasTriggerEffects, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding InstanceId}" Style="{StaticResource MutedTextStyle}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>